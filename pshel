#!/bin/bash

# DB2 Reorganization Script with Estimation Mode (Offline Tables, Index Reorg, Runstats, and db2rbind)
# CORRECTED VERSION: Handles connections within background jobs.
# This script quiesces the database, performs basic offline reorgs and runstats on tables concurrently
# in a single job format with continuous concurrency, rebinds all packages with db2rbind, and logs to a single file

# Check command line arguments
if [ "$#" -ne 1 ] || ([ "$1" != "estimate" ] && [ "$1" != "run" ]); then
    echo "Usage: $0 estimate|run"
    echo "  estimate - Only show time estimates without running reorg, runstats, or db2rbind"
    echo "  run      - Execute the full offline reorganization, runstats, and db2rbind"
    exit 1
fi

MODE=$1
echo "Running in $MODE mode"

# --- BEGIN USER CONFIGURATION ---
# Set environment variables (ADJUST THESE VALUES)
DB_NAME="your_database_name" # <--- CHANGE THIS
DB_USER="your_db_user"       # <--- CHANGE THIS
# WARNING: Storing passwords in scripts is insecure. Use safer methods for production.
DB_PASS="your_db_password"   # <--- CHANGE THIS
CONCURRENT_JOBS=3  # Number of concurrent reorg jobs (fixed at 3 in this version)

# Directory for logs
LOG_DIR="/path/to/logs" # <--- CHANGE THIS
# --- END USER CONFIGURATION ---

mkdir -p $LOG_DIR

# Single log file
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SUMMARY_LOG="$LOG_DIR/reorg_summary_${MODE}_${TIMESTAMP}.log"
echo "DB2 Offline Reorganization, Runstats, and db2rbind $MODE started at $(date)" > $SUMMARY_LOG
TOTAL_START_TIME=$(date +%s)
echo "Time window: 4 hours" >> $SUMMARY_LOG
echo "WARNING: This script uses hardcoded credentials for DB_USER/DB_PASS. This is NOT recommended for production environments." >> $SUMMARY_LOG

# Function to estimate reorg, runstats, and db2rbind time based on table and index sizes (offline)
estimate_time() {
    TABLE_SIZE_GB=$1  # Data size only
    INDEX_SIZE_GB=$2  # Total index size
    # Robust validation: ensure numeric and non-empty, handle all sizes
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid TABLE_SIZE_GB '$TABLE_SIZE_GB', defaulting to 0.01" >> $SUMMARY_LOG
        TABLE_SIZE_GB="0.01"
    else
        TABLE_SIZE_GB=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid INDEX_SIZE_GB '$INDEX_SIZE_GB', defaulting to 0.01" >> $SUMMARY_LOG
        INDEX_SIZE_GB="0.01"
    else
        INDEX_SIZE_GB=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
    fi

    # Base table reorg time: 1 min/GB, 1.2x for tables > 50GB
    COMPARE_RESULT=$(awk -v size="$TABLE_SIZE_GB" -v thresh=50 'BEGIN {print (size > thresh) ? 1 : 0}')
    if [ "$COMPARE_RESULT" -eq 1 ]; then
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.0f", size * 1.2}')
    else
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size}')
    fi
    # Offline index reorg time: 0.5 min/GB
    INDEX_EST_MINS=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size * 0.5}')
    # Runstats time: 0.1 min/GB for table + indexes
    RUNSTATS_EST_MINS=$(awk -v table="$TABLE_SIZE_GB" -v idx="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", ((table + idx) < 0.01) ? 1 : (table + idx) * 0.1}')
    # Total estimate with 5% reduction for offline efficiency
    TOTAL_EST_MINS=$(awk -v table="$TABLE_EST_MINS" -v idx="$INDEX_EST_MINS" -v runstats="$RUNSTATS_EST_MINS" 'BEGIN {printf "%.0f", (table + idx + runstats) * 0.95}')
    [ "$TOTAL_EST_MINS" -lt 1 ] && TOTAL_EST_MINS=1
    echo "$TOTAL_EST_MINS"
}

# Function to run offline reorg and runstats on a single table
# *** This function now handles its own connection ***
run_reorg() {
    TABLE_NAME=$1
    SCHEMA_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    # --- Establish connection for this specific job ---
    echo "Connecting to $DB_NAME for $SCHEMA_NAME.$TABLE_NAME..." >> $SUMMARY_LOG
    db2 connect to "$DB_NAME" user "$DB_USER" using "$DB_PASS" >> $SUMMARY_LOG 2>&1
    CONN_STATUS=$?
    if [ $CONN_STATUS -ne 0 ]; then
        echo "ERROR: Failed to connect to database $DB_NAME within run_reorg for $SCHEMA_NAME.$TABLE_NAME (Status: $CONN_STATUS)" >> $SUMMARY_LOG
        # Exit this specific background job if connection fails
        exit 1
    fi
    echo "Connection successful for $SCHEMA_NAME.$TABLE_NAME." >> $SUMMARY_LOG

    # Calculate estimates (also used for logging)
    TOTAL_EST_MINS=$(estimate_time "$TABLE_SIZE_GB" "$INDEX_SIZE_GB")
    TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" -v thresh=50 'BEGIN {print (size > thresh) ? int(size * 1.2) : (size < 0.01) ? 1 : int(size)}')
    INDEX_EST_MINS=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size * 0.5}')
    RUNSTATS_EST_MINS=$(awk -v table="$TABLE_SIZE_GB" -v idx="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", ((table + idx) < 0.01) ? 1 : (table + idx) * 0.1}')

    if [ "$MODE" = "run" ]; then
        START_TIME=$(date +%s)
        echo "Starting offline table reorg for $SCHEMA_NAME.$TABLE_NAME (Table: ${TABLE_SIZE_GB}GB, Indexes: ${INDEX_SIZE_GB}GB, est. ${TOTAL_EST_MINS} mins) at $(date)" >> $SUMMARY_LOG

        echo "Running: db2 REORG TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG
        db2 "REORG TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG 2>&1
        TABLE_REORG_STATUS=$?

        if [ $TABLE_REORG_STATUS -eq 0 ]; then
            echo "Offline table reorg for $SCHEMA_NAME.$TABLE_NAME completed successfully at $(date)" >> $SUMMARY_LOG
        else
            echo "ERROR: Offline table reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $TABLE_REORG_STATUS at $(date)" >> $SUMMARY_LOG
            db2 terminate >> $SUMMARY_LOG 2>&1 # Terminate connection on error
            return 1 # Indicate failure from the function
        fi

        echo "Starting offline index reorg for $SCHEMA_NAME.$TABLE_NAME at $(date)" >> $SUMMARY_LOG
        echo "Running: db2 REORG INDEXES ALL FOR TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG
        db2 "REORG INDEXES ALL FOR TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG 2>&1
        INDEX_REORG_STATUS=$?

        if [ $INDEX_REORG_STATUS -eq 0 ]; then
            echo "Offline index reorg for $SCHEMA_NAME.$TABLE_NAME completed successfully at $(date)" >> $SUMMARY_LOG
        else
            echo "ERROR: Offline index reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $INDEX_REORG_STATUS at $(date)" >> $SUMMARY_LOG
            db2 terminate >> $SUMMARY_LOG 2>&1 # Terminate connection on error
            return 1 # Indicate failure from the function
        fi

        echo "Starting runstats for $SCHEMA_NAME.$TABLE_NAME at $(date)" >> $SUMMARY_LOG
        echo "Running: db2 RUNSTATS ON TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\" WITH DISTRIBUTION AND DETAILED INDEXES ALL" >> $SUMMARY_LOG
        db2 "RUNSTATS ON TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\" WITH DISTRIBUTION AND DETAILED INDEXES ALL" >> $SUMMARY_LOG 2>&1
        RUNSTATS_STATUS=$?

        END_TIME=$(date +%s)
        DURATION=$((END_TIME - START_TIME))
        MINUTES=$((DURATION / 60))
        SECONDS=$((DURATION % 60))

        if [ $RUNSTATS_STATUS -eq 0 ]; then
            echo "Completed offline table reorg, index reorg, and runstats for $SCHEMA_NAME.$TABLE_NAME successfully in ${MINUTES}m ${SECONDS}s at $(date)" >> $SUMMARY_LOG
        else
            echo "ERROR: Runstats for $SCHEMA_NAME.$TABLE_NAME failed with status $RUNSTATS_STATUS after ${MINUTES}m ${SECONDS}s at $(date)" >> $SUMMARY_LOG
            db2 terminate >> $SUMMARY_LOG 2>&1 # Terminate connection on error
            return 1 # Indicate failure from the function
        fi
    else
        # Estimate mode logging
        echo "ESTIMATE: $SCHEMA_NAME.$TABLE_NAME (Table: ${TABLE_SIZE_GB}GB, est. ${TABLE_EST_MINS} mins; Indexes (offline): ${INDEX_SIZE_GB}GB, est. ${INDEX_EST_MINS} mins; Runstats: est. ${RUNSTATS_EST_MINS} mins; Total: ${TOTAL_EST_MINS} mins)" >> $SUMMARY_LOG
    fi

    # --- Terminate connection for this specific job ---
    echo "Terminating connection for $SCHEMA_NAME.$TABLE_NAME." >> $SUMMARY_LOG
    db2 terminate >> $SUMMARY_LOG 2>&1
    return 0 # Indicate success
}

# --- Main Script Logic ---

# Connect to the database (for main script operations like QUIESCE, UNQUIESCE, getting table list)
echo "Establishing main connection to $DB_NAME..." >> $SUMMARY_LOG
db2 connect to "$DB_NAME" user "$DB_USER" using "$DB_PASS" >> $SUMMARY_LOG 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to establish main connection to database $DB_NAME" >> $SUMMARY_LOG
    exit 1
fi
echo "Main connection established." >> $SUMMARY_LOG

# Quiesce the database in run mode
if [ "$MODE" = "run" ]; then
    echo "Quiescing database $DB_NAME at $(date)" >> $SUMMARY_LOG
    db2 "QUIESCE DATABASE IMMEDIATE FORCE CONNECTIONS" >> $SUMMARY_LOG 2>&1
    if [ $? -ne 0 ]; then
        echo "ERROR: Failed to quiesce database $DB_NAME" >> $SUMMARY_LOG
        db2 terminate >> $SUMMARY_LOG 2>&1
        exit 1
    fi
    echo "Database $DB_NAME quiesced successfully" >> $SUMMARY_LOG
fi

# Get the list of all tables and indexes by size (Improved Parsing)
TABLE_LIST_FILE="${LOG_DIR}/all_tables_${TIMESTAMP}.txt"
echo "Identifying tables and indexes that need reorganization by size..." >> $SUMMARY_LOG
SQL_QUERY="SELECT RTRIM(TABSCHEMA), RTRIM(TABNAME), \
           COALESCE(CAST(DECIMAL(GREATEST(DATA_OBJECT_P_SIZE, 0)) / 1024.0 / 1024.0 AS DECIMAL(10,2)), 0.01), \
           COALESCE(CAST(DECIMAL(GREATEST(INDEX_OBJECT_P_SIZE, 0)) / 1024.0 / 1024.0 AS DECIMAL(10,2)), 0.01) \
           FROM SYSIBMADM.ADMINTABINFO \
           WHERE TABSCHEMA NOT LIKE 'SYS%' AND DATA_OBJECT_P_SIZE IS NOT NULL AND INDEX_OBJECT_P_SIZE IS NOT NULL \
           ORDER BY (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) DESC"

echo "Executing query to fetch table list..." >> $SUMMARY_LOG
db2 -x "$SQL_QUERY" > "$TABLE_LIST_FILE"
QUERY_STATUS=$?
if [ $QUERY_STATUS -ne 0 ]; then
   echo "ERROR: Failed to execute query to get table list (Status: $QUERY_STATUS)" >> $SUMMARY_LOG
   if [ "$MODE" = "run" ]; then
      db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1 # Attempt unquiesce on error
   fi
   db2 terminate >> $SUMMARY_LOG 2>&1
   exit 1
fi
echo "Table list saved to $TABLE_LIST_FILE" >> $SUMMARY_LOG


# Calculate total time estimate & run estimate mode if selected
echo "Calculating time estimates..." >> $SUMMARY_LOG
TOTAL_EST_MINS=0
TABLE_COUNT=0
# Use process substitution to avoid subshell issues with counter variables
while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines potentially returned by db2 -x
    [[ -z "$line" ]] && continue

    # Use parameter expansion for safer splitting on whitespace
    set -- $line
    SCHEMA_NAME=$1
    TABLE_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    echo "DEBUG: Processing line: SCHEMA_NAME='$SCHEMA_NAME', TABLE_NAME='$TABLE_NAME', TABLE_SIZE_GB='$TABLE_SIZE_GB', INDEX_SIZE_GB='$INDEX_SIZE_GB'" >> $SUMMARY_LOG

    # Handle potentially malformed sizes (basic check)
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid TABLE_SIZE_GB '$TABLE_SIZE_GB' for $SCHEMA_NAME.$TABLE_NAME, defaulting to 0.01" >> $SUMMARY_LOG
        TABLE_SIZE_GB="0.01"
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid INDEX_SIZE_GB '$INDEX_SIZE_GB' for $SCHEMA_NAME.$TABLE_NAME, defaulting to 0.01" >> $SUMMARY_LOG
        INDEX_SIZE_GB="0.01"
    fi

    # Calculate estimate and increment counters
    TABLE_EST=$(estimate_time "$TABLE_SIZE_GB" "$INDEX_SIZE_GB")
    if [ -z "$TABLE_EST" ]; then
        echo "ERROR: Failed to estimate time for $SCHEMA_NAME.$TABLE_NAME, skipping" >> $SUMMARY_LOG
        continue
    fi
    TOTAL_EST_MINS=$((TOTAL_EST_MINS + TABLE_EST))
    TABLE_COUNT=$((TABLE_COUNT + 1))

    echo "DEBUG: Added TABLE_EST=$TABLE_EST mins for $SCHEMA_NAME.$TABLE_NAME, TOTAL_EST_MINS=$TOTAL_EST_MINS" >> $SUMMARY_LOG

    # In estimate mode, call the function (which now connects/terminates itself)
    if [ "$MODE" = "estimate" ]; then
        # Pass sanitized values
        SANITIZED_TABLE_SIZE_GB=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
        SANITIZED_INDEX_SIZE_GB=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
        run_reorg "$TABLE_NAME" "$SCHEMA_NAME" "$SANITIZED_TABLE_SIZE_GB" "$SANITIZED_INDEX_SIZE_GB"
        # Don't need to check return code here in estimate mode
    fi
done < "$TABLE_LIST_FILE"


echo "Total tables to process: $TABLE_COUNT" >> $SUMMARY_LOG

# Adjust total estimate for concurrency (divide by CONCURRENT_JOBS for parallel jobs)
if [ "$TABLE_COUNT" -gt 0 ] && [ "$CONCURRENT_JOBS" -gt 0 ]; then
    # Use awk for floating point division before rounding
    PARALLEL_EST_MINS=$(awk -v total="$TOTAL_EST_MINS" -v jobs="$CONCURRENT_JOBS" 'BEGIN {printf "%.0f", (total / jobs) + 0.5}') # Round up
else
    echo "WARNING: No valid tables or CONCURRENT_JOBS=0, setting PARALLEL_EST_MINS to 0" >> $SUMMARY_LOG
    PARALLEL_EST_MINS=0
fi

# Add fixed estimate for db2rbind
DB2RBIND_EST_MINS=5
FINAL_EST_MINS=$((PARALLEL_EST_MINS + DB2RBIND_EST_MINS))

# Fixed: Use a more reliable calculation for hours from minutes
TOTAL_EST_HRS=$(awk -v mins="$FINAL_EST_MINS" 'BEGIN {printf "%.1f", mins / 60}')
echo "Total estimated time for all tables (without concurrency): $TOTAL_EST_MINS minutes" >> $SUMMARY_LOG
echo "Total estimated time with concurrency of $CONCURRENT_JOBS jobs: $PARALLEL_EST_MINS minutes" >> $SUMMARY_LOG
echo "Total estimated time (including db2rbind, considering concurrency): $FINAL_EST_MINS minutes ($TOTAL_EST_HRS hours)" >> $SUMMARY_LOG

# Fixed: Ensure we have a numeric comparison with a valid number
if [ -n "$TOTAL_EST_HRS" ] && [ $(awk -v hrs="$TOTAL_EST_HRS" 'BEGIN {print (hrs > 4.0) ? 1 : 0}') -eq 1 ]; then
    echo "WARNING: Estimated time exceeds 4-hour window!" >> $SUMMARY_LOG
fi

# If just estimating, exit here
if [ "$MODE" = "estimate" ]; then
    echo "Estimation completed. See log: $SUMMARY_LOG"
    db2 terminate >> $SUMMARY_LOG 2>&1 # Terminate the main connection
    rm -f "$TABLE_LIST_FILE" # Clean up temp file
    exit 0
fi

# --- Execution Mode ---
echo "Proceeding with actual offline reorganization, runstats, and db2rbind..." >> $SUMMARY_LOG

# Validate CONCURRENT_JOBS again just before use
if ! echo "$CONCURRENT_JOBS" | grep -qE '^[1-9][0-9]*$'; then
    echo "ERROR: CONCURRENT_JOBS is invalid ('$CONCURRENT_JOBS'). Must be a positive integer. Defaulting to 1." >> $SUMMARY_LOG
    CONCURRENT_JOBS=1
fi

# Progress tracking variables
TABLES_STARTED=0
TABLES_SUCCESS=0
TABLES_FAILED=0
TOTAL_TABLES=$TABLE_COUNT # Use the count determined earlier

# Process all tables in a single job with continuous concurrency
echo "Processing $TABLE_COUNT tables, $CONCURRENT_JOBS concurrently..." >> $SUMMARY_LOG

# Use process substitution again to read the file
while IFS= read -r line || [[ -n "$line" ]]; do
     [[ -z "$line" ]] && continue
    # Limit concurrent jobs
    while true; do
        # jobs -p lists PIDs of background jobs for the current shell
        ACTIVE_JOBS=$(jobs -p | wc -l)
         if [ -z "$ACTIVE_JOBS" ]; then # Handle case where wc -l might return empty if no jobs
             ACTIVE_JOBS=0
         fi
        if [ "$ACTIVE_JOBS" -lt "$CONCURRENT_JOBS" ]; then
            break # Slot available
        else
            echo "Waiting: Active jobs ($ACTIVE_JOBS/$CONCURRENT_JOBS) running. Sleeping 10s..." >> $SUMMARY_LOG
            sleep 10
            # Check for completed jobs without blocking indefinitely
            wait -n # Waits for the next background job to finish
        fi
    done

    set -- $line
    SCHEMA_NAME=$1
    TABLE_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    # Re-validate/sanitize sizes just before launching the job
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then TABLE_SIZE_GB="0.01"; fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then INDEX_SIZE_GB="0.01"; fi
    SANITIZED_TABLE_SIZE_GB=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
    SANITIZED_INDEX_SIZE_GB=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')


    # Launch the reorg function in the background
    run_reorg "$TABLE_NAME" "$SCHEMA_NAME" "$SANITIZED_TABLE_SIZE_GB" "$SANITIZED_INDEX_SIZE_GB" &
    # Store the PID of the background job
    BG_PID=$!
    echo "Launched job for $SCHEMA_NAME.$TABLE_NAME (PID: $BG_PID)" >> $SUMMARY_LOG

    TABLES_STARTED=$((TABLES_STARTED + 1))
    if [ "$TOTAL_TABLES" -gt 0 ]; then
      PCT_STARTED=$(awk -v started="$TABLES_STARTED" -v total="$TOTAL_TABLES" 'BEGIN {printf "%.2f", started * 100 / total}')
      echo "Progress: $TABLES_STARTED/$TOTAL_TABLES tables launched ($PCT_STARTED%)" >> $SUMMARY_LOG
    fi

    sleep 2 # Small delay between launching jobs

done < "$TABLE_LIST_FILE"


# Wait for all remaining background jobs to complete
echo "All jobs launched. Waiting for remaining background processes to complete..." >> $SUMMARY_LOG
wait
echo "All background reorg/runstats jobs have finished." >> $SUMMARY_LOG

# Check results (Optional but recommended: Iterate through PIDs or use a more complex mechanism if needed)
# Simple approach: Just report completion. Add more checks if needed.

# Perform db2rbind
if [ "$MODE" = "run" ]; then
    echo "Starting db2rbind for all packages at $(date)" >> $SUMMARY_LOG
    # WARNING: Passing credentials like this is insecure.
    db2rbind "$DB_NAME" -l "$SUMMARY_LOG" -u "$DB_USER" -p "$DB_PASS" all
    RBIND_STATUS=$?
    if [ $RBIND_STATUS -eq 0 ]; then
        echo "db2rbind completed successfully at $(date)" >> $SUMMARY_LOG
    elif [ $RBIND_STATUS -eq 4 ]; then
         echo "WARNING: db2rbind completed with warnings (Status: $RBIND_STATUS) at $(date)" >> $SUMMARY_LOG
    else
        echo "ERROR: db2rbind failed with status $RBIND_STATUS at $(date)" >> $SUMMARY_LOG
        # Decide if this is a critical failure
    fi
fi

# Unquiesce the database in run mode
if [ "$MODE" = "run" ]; then
    echo "Unquiescing database $DB_NAME at $(date)" >> $SUMMARY_LOG
    db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1
    if [ $? -eq 0 ]; then
        echo "Database $DB_NAME unquiesced successfully" >> $SUMMARY_LOG
    else
        # This is a critical error - manual intervention likely needed
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> $SUMMARY_LOG
        echo "ERROR: Failed to unquiesce database $DB_NAME. MANUAL INTERVENTION REQUIRED!" >> $SUMMARY_LOG
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> $SUMMARY_LOG
    fi
fi

# Final summary
TOTAL_END_TIME=$(date +%s)
TOTAL_DURATION=$((TOTAL_END_TIME - TOTAL_START_TIME))
TOTAL_HOURS=$((TOTAL_DURATION / 3600))
TOTAL_MINUTES=$(( (TOTAL_DURATION % 3600) / 60 ))
TOTAL_SECONDS=$((TOTAL_DURATION % 60))

echo "--------------------------------------------------" >> $SUMMARY_LOG
echo "DB2 Offline Reorg/Runstats/Rbind Process Summary" >> $SUMMARY_LOG
echo "Mode: $MODE" >> $SUMMARY_LOG
echo "End Time: $(date)" >> $SUMMARY_LOG
echo "Total actual execution time: ${TOTAL_HOURS}h ${TOTAL_MINUTES}m ${TOTAL_SECONDS}s" >> $SUMMARY_LOG
echo "Total tables identified for processing: $TOTAL_TABLES" >> $SUMMARY_LOG
echo "Total tables launched: $TABLES_STARTED" >> $SUMMARY_LOG
# Note: Accurate success/failure counts would require more complex tracking of background job exit codes.
echo "--------------------------------------------------" >> $SUMMARY_LOG


# Disconnect the main connection from the database
db2 terminate >> $SUMMARY_LOG 2>&1

# Clean up temp file
rm -f "$TABLE_LIST_FILE"

echo "DB2 offline reorganization, runstats, and db2rbind process completed. See log: $SUMMARY_LOG"
echo "Final summary appended to log: $SUMMARY_LOG" >> $SUMMARY_LOG

exit 0
