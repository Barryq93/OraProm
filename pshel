find /path/to/dir -type f -newermt yesterday -not -newermt today -printf "%s\n" \
  | awk '{sum+=$1} END{printf "Yesterday: %.2f GB\n", sum/1024/1024/1024}'

find /path/to/dir -type f -newermt yesterday -not -newermt today -printf "%h %s\n" \
  | awk '{a[$1]+=$2} END{for(d in a) printf "%s %.2f GB\n", d, a[d]/1024/1024/1024}' \
  | sort