(
  index=your_index http_call=your_call_name earliest=@d latest=now()
  | bin _time span=1h
  | stats count as current_count by _time
)
| append [
  search index=your_index http_call=your_call_name earliest=-7d@d latest=-7d@d+now()
  | eval _time = _time + 7*24*60*60
  | bin _time span=1h
  | stats count as previous_week_count by _time
]
| stats values(current_count) as current_count values(previous_week_count) as previous_week_count by _time
| timechart span=1h max(current_count) as "Today", max(previous_week_count) as "Same time last week"