#!/bin/bash

# DB2 Reorganization Script with Estimation Mode
# This script identifies tables by total size (data + index) and reorganizes them
# Can be run in estimate-only mode or execution mode

# Check command line arguments
if [ "$#" -ne 1 ] || ([ "$1" != "estimate" ] && [ "$1" != "run" ]); then
    echo "Usage: $0 estimate|run"
    echo "  estimate - Only show time estimates without running reorg"
    echo "  run      - Execute the full reorganization"
    exit 1
fi

MODE=$1
echo "Running in $MODE mode"

# Set environment variables (adjust as needed)
DB_NAME="your_database_name"
DB_USER="your_db_user"
DB_PASS="your_db_password"
MAX_CONCURRENT_JOBS=3  # Number of concurrent reorg jobs for small tables

# Size thresholds in GB
LARGE_TABLE_THRESHOLD=20  # Tables larger than this will be processed individually
VERY_LARGE_THRESHOLD=50   # Tables larger than this will be processed first

# Directory for logs
LOG_DIR="/path/to/logs"
mkdir -p $LOG_DIR

# Summary log file
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SUMMARY_LOG="$LOG_DIR/reorg_summary_${MODE}_${TIMESTAMP}.log"
echo "DB2 Reorganization $MODE started at $(date)" > $SUMMARY_LOG
TOTAL_START_TIME=$(date +%s)
echo "Time window: 4 hours" >> $SUMMARY_LOG

# Function to estimate reorg time based on table size
estimate_time() {
    SIZE_GB=$1
    # Validate SIZE_GB; default to 0.01 GB (10 MB) if empty or invalid
    if [ -z "$SIZE_GB" ] || ! echo "$SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        SIZE_GB="0.01"
    fi
    # Pass SIZE_GB and VERY_LARGE_THRESHOLD to awk
    if [ $(awk -v size="$SIZE_GB" -v thresh="$VERY_LARGE_THRESHOLD" 'BEGIN {print (size > thresh) ? 1 : 0}') -eq 1 ]; then
        EST_MINS=$(awk -v size="$SIZE_GB" 'BEGIN {printf "%.0f", size * 1.2}')
    else
        EST_MINS=$(awk -v size="$SIZE_GB" 'BEGIN {printf "%.0f", size}')
    fi
    # Ensure EST_MINS is at least 1
    [ "$EST_MINS" -lt 1 ] && EST_MINS=1
    echo $EST_MINS
}

# Connect to the database
db2 connect to $DB_NAME user $DB_USER using $DB_PASS
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to connect to database $DB_NAME" | tee -a $SUMMARY_LOG
    exit 1
fi

# Function to run reorg on a single table
run_reorg() {
    TABLE_NAME=$1
    SCHEMA_NAME=$2
    TOTAL_SIZE_GB=$3
    
    LOG_FILE="$LOG_DIR/reorg_${SCHEMA_NAME}_${TABLE_NAME}_${TIMESTAMP}.log"
    
    EST_MINS=$(estimate_time "$TOTAL_SIZE_GB")
    
    if [ "$MODE" = "run" ]; then
        START_TIME=$(date +%s)
        echo "Starting reorg for $SCHEMA_NAME.$TABLE_NAME (${TOTAL_SIZE_GB}GB total, est. ${EST_MINS} mins) at $(date)" | tee -a "$LOG_FILE" $SUMMARY_LOG
        
        db2 "REORG TABLE $SCHEMA_NAME.$TABLE_NAME SORTKEYS LONGLOBDATA" >> "$LOG_FILE" 2>&1
        REORG_STATUS=$?
        
        END_TIME=$(date +%s)
        DURATION=$((END_TIME - START_TIME))
        MINUTES=$((DURATION / 60))
        SECONDS=$((DURATION % 60))
        
        if [ $REORG_STATUS -eq 0 ]; then
            echo "Completed reorg for $SCHEMA_NAME.$TABLE_NAME successfully in ${MINUTES}m ${SECONDS}s at $(date)" | tee -a "$LOG_FILE" $SUMMARY_LOG
        else
            echo "ERROR: Reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $REORG_STATUS after ${MINUTES}m ${SECONDS}s at $(date)" | tee -a "$LOG_FILE" $SUMMARY_LOG
        fi
    else
        echo "ESTIMATE: $SCHEMA_NAME.$TABLE_NAME (${TOTAL_SIZE_GB}GB) would take approximately ${EST_MINS} minutes" | tee -a $SUMMARY_LOG
    fi
}

# Get the list of all tables by total size (data + index)
echo "Identifying tables that need reorganization by total size (data + index)..." | tee -a $SUMMARY_LOG

# Get very large tables
echo "Finding very large tables (>${VERY_LARGE_THRESHOLD}GB)..." | tee -a $SUMMARY_LOG
db2 -x "SELECT RTRIM(TABSCHEMA) || '.' || RTRIM(TABNAME) || '.' || 
          CAST(DECIMAL(DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) / 1024 / 1024 AS DECIMAL(10,2)) AS TOTAL_SIZE_GB 
        FROM SYSIBMADM.ADMINTABINFO 
        WHERE (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) > $VERY_LARGE_THRESHOLD * 1024 * 1024
        AND TABSCHEMA NOT LIKE 'SYS%'
        ORDER BY (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) DESC" > very_large_tables.txt

# Get large tables
echo "Finding large tables (${LARGE_TABLE_THRESHOLD}-${VERY_LARGE_THRESHOLD}GB)..." | tee -a $SUMMARY_LOG
db2 -x "SELECT RTRIM(TABSCHEMA) || '.' || RTRIM(TABNAME) || '.' || 
          CAST(DECIMAL(DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) / 1024 / 1024 AS DECIMAL(10,2)) AS TOTAL_SIZE_GB 
        FROM SYSIBMADM.ADMINTABINFO 
        WHERE (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) > $LARGE_TABLE_THRESHOLD * 1024 * 1024
        AND (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) <= $VERY_LARGE_THRESHOLD * 1024 * 1024
        AND TABSCHEMA NOT LIKE 'SYS%'
        ORDER BY (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) DESC" > large_tables.txt

# Get small tables
echo "Finding small tables (<${LARGE_TABLE_THRESHOLD}GB)..." | tee -a $SUMMARY_LOG
db2 -x "SELECT RTRIM(TABSCHEMA) || '.' || RTRIM(TABNAME) || '.' || 
          CAST(DECIMAL(DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) / 1024 / 1024 AS DECIMAL(10,2)) AS TOTAL_SIZE_GB 
        FROM SYSIBMADM.ADMINTABINFO 
        WHERE (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) <= $LARGE_TABLE_THRESHOLD * 1024 * 1024
        AND TABSCHEMA NOT LIKE 'SYS%'
        ORDER BY (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) DESC" > small_tables.txt

# Calculate total time estimate
echo "Calculating time estimates..." | tee -a $SUMMARY_LOG
TOTAL_EST_MINS=0

# Very large tables estimate
VERY_LARGE_COUNT=$(wc -l < very_large_tables.txt)
echo "Very large tables count: $VERY_LARGE_COUNT" | tee -a $SUMMARY_LOG
while read -r TABLE_INFO; do
    SIZE_GB=$(echo "$TABLE_INFO" | cut -d'.' -f3)
    TABLE_EST=$(estimate_time "$SIZE_GB")
    TOTAL_EST_MINS=$((TOTAL_EST_MINS + TABLE_EST))
    
    if [ "$MODE" = "estimate" ]; then
        SCHEMA_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f1)
        TABLE_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f2)
        echo "  - $SCHEMA_NAME.$TABLE_NAME: ${SIZE_GB}GB, est. ${TABLE_EST} mins" | tee -a $SUMMARY_LOG
    fi
done < very_large_tables.txt

# Large tables estimate
LARGE_COUNT=$(wc -l < large_tables.txt)
echo "Large tables count: $LARGE_COUNT" | tee -a $SUMMARY_LOG
while read -r TABLE_INFO; do
    SIZE_GB=$(echo "$TABLE_INFO" | cut -d'.' -f3)
    TABLE_EST=$(estimate_time "$SIZE_GB")
    TOTAL_EST_MINS=$((TOTAL_EST_MINS + TABLE_EST))
    
    if [ "$MODE" = "estimate" ]; then
        SCHEMA_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f1)
        TABLE_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f2)
        echo "  - $SCHEMA_NAME.$TABLE_NAME: ${SIZE_GB}GB, est. ${TABLE_EST} mins" | tee -a $SUMMARY_LOG
    fi
done < large_tables.txt

# Small tables estimate (these will run in parallel)
SMALL_COUNT=$(wc -l < small_tables.txt)
echo "Small tables count: $SMALL_COUNT" | tee -a $SUMMARY_LOG
SMALL_TOTAL_SIZE=0
while read -r TABLE_INFO; do
    SIZE_GB=$(echo "$TABLE_INFO" | cut -d'.' -f3)
    SMALL_TOTAL_SIZE=$(awk -v total="$SMALL_TOTAL_SIZE" -v size="$SIZE_GB" 'BEGIN {printf "%.2f", total + size}')
    
    if [ "$MODE" = "estimate" ]; then
        SCHEMA_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f1)
        TABLE_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f2)
        TABLE_EST=$(estimate_time "$SIZE_GB")
        echo "  - $SCHEMA_NAME.$TABLE_NAME: ${SIZE_GB}GB, est. ${TABLE_EST} mins (will run in parallel)" | tee -a $SUMMARY_LOG
    fi
done < small_tables.txt

# Estimate small tables time (divided by concurrency)
SMALL_EST_MINS=$(awk -v total="$SMALL_TOTAL_SIZE" -v jobs="$MAX_CONCURRENT_JOBS" 'BEGIN {printf "%.0f", total / jobs}')
TOTAL_EST_MINS=$((TOTAL_EST_MINS + SMALL_EST_MINS))

TOTAL_EST_HRS=$(awk -v mins="$TOTAL_EST_MINS" 'BEGIN {printf "%.1f", mins / 60}')
echo "Total estimated time: $TOTAL_EST_MINS minutes ($TOTAL_EST_HRS hours)" | tee -a $SUMMARY_LOG

if [ $(awk -v hrs="$TOTAL_EST_HRS" 'BEGIN {print (hrs > 4) ? 1 : 0}') -eq 1 ]; then
    echo "WARNING: Estimated time exceeds 4-hour window!" | tee -a $SUMMARY_LOG
fi

# If just estimating, exit here
if [ "$MODE" = "estimate" ]; then
    echo "Estimation completed. See summary log: $SUMMARY_LOG"
    db2 terminate
    exit 0
fi

# If continuing with execution mode
echo "Proceeding with actual reorganization..." | tee -a $SUMMARY_LOG

# Progress tracking variables
TABLES_DONE=0
TOTAL_TABLES=$(( $(wc -l < very_large_tables.txt) + $(wc -l < large_tables.txt) + $(wc -l < small_tables.txt) ))

# Process the very large tables first (sequentially)
echo "Processing $VERY_LARGE_COUNT very large tables sequentially..." | tee -a $SUMMARY_LOG

while read -r TABLE_INFO; do
    SCHEMA_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f1)
    TABLE_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f2)
    SIZE_GB=$(echo "$TABLE_INFO" | cut -d'.' -f3)
    run_reorg "$TABLE_NAME" "$SCHEMA_NAME" "$SIZE_GB"
    TABLES_DONE=$((TABLES_DONE + 1))
    PCT_DONE=$(awk -v done="$TABLES_DONE" -v total="$TOTAL_TABLES" 'BEGIN {printf "%.2f", done * 100 / total}')
    echo "Progress: $TABLES_DONE/$TOTAL_TABLES tables done ($PCT_DONE%)" | tee -a $SUMMARY_LOG
done < very_large_tables.txt

# Process the large tables next (sequentially)
echo "Processing $LARGE_COUNT large tables sequentially..." | tee -a $SUMMARY_LOG

while read -r TABLE_INFO; do
    SCHEMA_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f1)
    TABLE_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f2)
    SIZE_GB=$(echo "$TABLE_INFO" | cut -d'.' -f3)
    run_reorg "$TABLE_NAME" "$SCHEMA_NAME" "$SIZE_GB"
    TABLES_DONE=$((TABLES_DONE + 1))
    PCT_DONE=$(awk -v done="$TABLES_DONE" -v total="$TOTAL_TABLES" 'BEGIN {printf "%.2f", done * 100 / total}')
    echo "Progress: $TABLES_DONE/$TOTAL_TABLES tables done ($PCT_DONE%)" | tee -a $SUMMARY_LOG
done < large_tables.txt

# Process smaller tables in parallel
echo "Processing $SMALL_COUNT small tables in parallel batches..." | tee -a $SUMMARY_LOG

# Process tables in batches, limited by MAX_CONCURRENT_JOBS
cat small_tables.txt | while read -r TABLE_INFO; do
    while [ $(jobs -p | wc -l) -ge $MAX_CONCURRENT_JOBS ]; do
        sleep 5
    done
    
    SCHEMA_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f1)
    TABLE_NAME=$(echo "$TABLE_INFO" | cut -d'.' -f2)
    SIZE_GB=$(echo "$TABLE_INFO" | cut -d'.' -f3)
    
    run_reorg "$TABLE_NAME" "$SCHEMA_NAME" "$SIZE_GB" &
    
    sleep 2
done

# Wait for all background jobs to complete
wait

# Final summary
TOTAL_END_TIME=$(date +%s)
TOTAL_DURATION=$((TOTAL_END_TIME - TOTAL_START_TIME))
TOTAL_HOURS=$((TOTAL_DURATION / 3600))
TOTAL_MINUTES=$(( (TOTAL_DURATION % 3600) / 60 ))
TOTAL_SECONDS=$((TOTAL_DURATION % 60))

echo "All reorganization jobs completed at $(date)" | tee -a $SUMMARY_LOG
echo "Total actual time: ${TOTAL_HOURS}h ${TOTAL_MINUTES}m ${TOTAL_SECONDS}s" | tee -a $SUMMARY_LOG
echo "Total tables processed: $TOTAL_TABLES" | tee -a $SUMMARY_LOG

# Disconnect from the database
db2 terminate

echo "DB2 reorganization process completed. See summary log: $SUMMARY_LOG" | tee -a $SUMMARY_LOG
