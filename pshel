# Function to generate SQL INSERT statement
function Generate-SqlInsert($SourcePath, $ID, $StaffID, $DocumentType, $BatchNumber) {
    # Remove "Documents/ID/" from SourcePath
    $CleanedSourcePath = $SourcePath -replace "Documents/ID/", ""

    # Format ID to 7 characters with leading zeros
    $FormattedID = "{0:D7}" -f $ID

    # Construct SQL INSERT statement
    $SqlStatement = "INSERT INTO YourTable (BatchNumber, SourcePath, ID, StaffID, DocumentType) VALUES ('{0}', '{1}', '{2}', '{3}', '{4}');" -f $BatchNumber, $CleanedSourcePath, $FormattedID, $StaffID, $DocumentType

    return $SqlStatement
}

# Get the path to the Excel files from the user
$ExcelFolderPath = Read-Host -Prompt "Enter the path to the Excel files:"

# Initialize an empty array to store SQL statements
$SqlStatements = @()

# Loop through Excel files from batch1.xlsx to batch47.xlsx
for ($i = 1; $i -le 47; $i++) {
    # Construct Excel file path
    $ExcelFilePath = Join-Path -Path $ExcelFolderPath -ChildPath ("batch{0}.xlsx" -f $i)

    # Check if the Excel file exists
    if (Test-Path -Path $ExcelFilePath) {
        # Create an Excel object
        $excel = New-Object -ComObject Excel.Application
        $excel.Visible = $false 

        # Open the workbook
        $workbook = $excel.Workbooks.Open($ExcelFilePath)

        # Get the first worksheet (adjust index as needed)
        $worksheet = $workbook.Sheets.Item(1) 

        # Get the used range
        $usedRange = $worksheet.UsedRange

        # Iterate through rows (excluding header row)
        for ($row = 2; $row -le $usedRange.Rows.Count; $row++) {
            # Extract values from row
            $SourcePath = $worksheet.Cells.Item($row, 1).Value2 
            $ID = $worksheet.Cells.Item($row, 2).Value2 
            $StaffID = $worksheet.Cells.Item($row, 3).Value2 
            $DocumentType = $worksheet.Cells.Item($row, 4).Value2 

             # Skip rows where StaffID (column 3) is blank
            if ([string]::IsNullOrWhiteSpace($StaffID)) {
                continue
            }

            $CleanedSourcePath = $SourcePath -replace "Documents/ID/", "Documents/$ID/" 

            # Generate SQL INSERT statement
            $SqlStatement = Generate-SqlInsert $SourcePath $ID $StaffID $DocumentType $i

            # Add SQL statement to the array
            $SqlStatements += $SqlStatement
        }

        # Close the workbook and Excel application
        $workbook.Close()
        $excel.Quit()
        [System.Runtime.InteropServices.Marshal]::ReleaseComObject($worksheet)
        [System.Runtime.InteropServices.Marshal]::ReleaseComObject($workbook)
        [System.Runtime.InteropServices.Marshal]::ReleaseComObject($excel)
    }
}

# Create a file to store the SQL statements
$OutputFilePath = "output.sql"

# Write SQL statements to the file
$SqlStatements | Set-Content -Path $OutputFilePath

# Confirm successful script execution
Write-Host "SQL statements written to: $OutputFilePath"
