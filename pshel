#!/bin/bash
# ════════════════════════════════════════════════════════════════════════════════
# db2_ecm_health_check.sh
# IBM Content Manager / ECM — Db2 Health Check
# Version: 1.0
#
# USAGE:
#   ./db2_ecm_health_check.sh              # weekly mode (default)
#   ./db2_ecm_health_check.sh --overall    # full stats picture
#   ./db2_ecm_health_check.sh --cron       # weekly, suppress progress to stderr
#
# MODES:
#   weekly (default)
#     Incident and trend check. Run regularly or from cron.
#     Collects: active lock waits, long transactions, log utilisation,
#               tablespace totals, backup timestamps, SA MP state, swap.
#     Runtime:  ~2-5 min for an 8-DB ICM stack.
#     Best LLM: Gemini Flash (Opus if incidents found)
#
#   overall (--overall)
#     Full statistical picture. Run periodically or when something looks wrong.
#     Adds: catalog statistics, top tables, stale stats, index health,
#           top SQL, HADR detail, memory pools.
#     Runtime:  ~15-20 min for an 8-DB ICM stack.
#     Best LLM: GPT-4o / Gemini Pro
#
# OUTPUT FILES (written to current directory):
#   <mode>_report_<ts>.txt     Raw collected Db2 data
#   <mode>_prompt_<ts>.md      Paste into GitHub Copilot — no edits needed
#   <mode>_verify_<ts>.txt     Expert checklist + LLM recommendation
#
# ASSUMPTIONS:
#   Nothing about DB names, schemas, or table structure.
#   All classification done by the LLM from collected evidence.
#
# PERMISSIONS:
#   Db2 instance owner, or SYSMON + SYSCTRL authority.
#   SA MP tools (lssam) require rsct group membership or root.
#
# COMPATIBILITY:
#   Db2 LUW 11.1+, RHEL 8.x
# ════════════════════════════════════════════════════════════════════════════════

export LC_ALL=C
export LANG=C
set -euo pipefail

# ── Arguments ─────────────────────────────────────────────────────────────────
MODE="weekly"
CRON_MODE=false

for arg in "$@"; do
  case "$arg" in
    --overall) MODE="overall" ;;
    --cron)    CRON_MODE=true ;;
    --weekly)  MODE="weekly"  ;;
    *)
      echo "Usage: $0 [--overall] [--cron]" >&2
      exit 1
      ;;
  esac
done

# ── Output filenames ──────────────────────────────────────────────────────────
RUN_TS=$(date '+%Y-%m-%d_%H%M%S')
HOST=$(hostname -s 2>/dev/null || hostname)
SCRIPT_START=$(date +%s)

REPORT="${MODE}_report_${RUN_TS}.txt"
PROMPT_MD="${MODE}_prompt_${RUN_TS}.md"
VERIFY="${MODE}_verify_${RUN_TS}.txt"

> "$REPORT"; > "$PROMPT_MD"; > "$VERIFY"

# ── Progress ──────────────────────────────────────────────────────────────────
progress() {
  $CRON_MODE || echo "[$(date '+%H:%M:%S')] $*" >&2
}
progress "db2_ecm_health_check.sh  mode=${MODE}  host=${HOST}"

# ── Report helpers ────────────────────────────────────────────────────────────
log()     { echo "$*"                                                   >> "$REPORT"; }
section() { echo ""                                                     >> "$REPORT"
            echo "════════════════════════════════════════════════════" >> "$REPORT"
            echo "  $*"                                                 >> "$REPORT"
            echo "════════════════════════════════════════════════════" >> "$REPORT"; }
subsect() { echo ""                                                     >> "$REPORT"
            echo "--- $* ---"                                           >> "$REPORT"; }
blankln() { echo ""                                                     >> "$REPORT"; }
pstatus() { printf "%-52s | %-8s | %-8s | %s\n" "$1" "$2" "$3" "$4"   >> "$REPORT"; }

# ── Verify helpers ────────────────────────────────────────────────────────────
vlog()  { echo "$*"                                                     >> "$VERIFY"; }
vsect() { echo ""                                                       >> "$VERIFY"
          echo "════════════════════════════════════════════════════"   >> "$VERIFY"
          echo "  $*"                                                   >> "$VERIFY"
          echo "════════════════════════════════════════════════════"   >> "$VERIFY"; }

# ── Guards ────────────────────────────────────────────────────────────────────
is_int() { [[ "${1:-}" =~ ^[0-9]+$            ]]; }
is_num() { [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; }
is_overall() { [ "$MODE" = "overall" ]; }

# ── Config value extractor (defined once) ─────────────────────────────────────
_gv() { echo "$1" | grep "$2" | awk '{print $NF}'; }

# ── Tracking arrays ───────────────────────────────────────────────────────────
declare -A DB_CONNECT_STATUS
declare -A DB_USED_GB       DB_TOTAL_GB
declare -A DB_TABLE_COUNT   DB_SCHEMA_COUNT
declare -A DB_MAX_CARD      DB_TOTAL_CARD
declare -A DB_LOGFILSIZ     DB_LOGPRIMARY    DB_LOGSECOND
declare -A DB_LOGARCHMETH1  DB_LOGARCHMETH2  DB_LOGARCHCOMPR
declare -A DB_TRACKMOD      DB_HADR_SYNC     DB_HADR_ROLE
declare -A DB_STMM          DB_LOCKTIMEOUT   DB_LOCKLIST    DB_MAXLOCKS
declare -A DB_AUTOCOLLECT_STATS
declare -A DB_LOG_USED_KB   DB_LOG_AVAIL_KB
declare -A DB_LOCK_WAITS    DB_LONG_TXN_COUNT
declare -A DB_CONNECT_COUNT DB_REORG_PENDING_COUNT
declare -A DB_BACKUP_TS

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 0 — HEADER
# ════════════════════════════════════════════════════════════════════════════════
section "IBM ECM Db2 Health Check  [${MODE}]"
log "Timestamp  : $RUN_TS"
log "Mode       : $MODE"
log "Host       : $HOST"
log "OS         : $(grep PRETTY_NAME /etc/os-release 2>/dev/null \
                    | cut -d= -f2 | tr -d '"' || uname -r)"
log "Kernel     : $(uname -r)"
log "Run user   : $(whoami)"
blankln

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 1 — ENVIRONMENT
# ════════════════════════════════════════════════════════════════════════════════
section "1. Environment"
progress "Section 1: environment"

PROFILE_SOURCED=false
for prof in \
    "$HOME/sqllib/db2profile" \
    "/home/db2inst1/sqllib/db2profile" \
    "/home/db2inst2/sqllib/db2profile" \
    "/opt/ibm/db2/V11.5/db2profile" \
    "/opt/ibm/db2/V11.1/db2profile"; do
  if [ -f "$prof" ]; then
    log "Sourcing Db2 profile: $prof"
    # shellcheck source=/dev/null
    . "$prof" 2>/dev/null && PROFILE_SOURCED=true
    break
  fi
done
$PROFILE_SOURCED || log "WARNING: No db2profile sourced — Db2 commands may fail"

if ! command -v db2 >/dev/null 2>&1; then
  log "CRITICAL: db2 not in PATH — cannot continue"
  progress "FATAL: db2 not in PATH"
  exit 1
fi

subsect "Db2 Version"
db2level 2>&1 | head -6 >> "$REPORT"
blankln

subsect "OS Memory and Swap"
free -h 2>&1 >> "$REPORT" || true
free -b 2>/dev/null | awk \
  'NR==2{printf "RAM:  total=%s used=%s free=%s available=%s\n",$2,$3,$4,$7}
   NR==3{printf "Swap: total=%s used=%s free=%s\n",$2,$3,$4}' \
  >> "$REPORT" || true
grep -iE 'MemTotal|MemFree|MemAvailable|SwapTotal|SwapFree|AnonHugePages' \
  /proc/meminfo 2>/dev/null >> "$REPORT" || true
blankln

subsect "Transparent Huge Pages (THP)"
grep -o '.*' /sys/kernel/mm/transparent_hugepage/enabled \
  2>/dev/null >> "$REPORT" || log "(THP status unavailable)"
blankln

subsect "SA MP Cluster State"
log "Two SA MP resource groups expected — one per RMDB cluster tier."
if command -v lssam >/dev/null 2>&1; then
  lssam 2>/dev/null >> "$REPORT" || log "(lssam returned non-zero)"
elif command -v samctrl >/dev/null 2>&1; then
  samctrl -s 2>/dev/null >> "$REPORT" || log "(samctrl returned non-zero)"
else
  log "(lssam/samctrl not in PATH)"
fi
ps -ef 2>/dev/null \
  | grep -iE 'IBM\.ResourceManager|IBM\.Automation|rsct' \
  | grep -v grep >> "$REPORT" || log "(No SA MP processes detected)"
for sadir in /var/ct/cfg /var/ct/run /opt/rsct/bin; do
  [ -d "$sadir" ] && log "SA MP dir present: $sadir" \
                  || log "SA MP dir absent : $sadir"
done
blankln

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 2 — DATABASE DISCOVERY
# ════════════════════════════════════════════════════════════════════════════════
section "2. Database Discovery"
progress "Section 2: discovering databases"

db2 list database directory 2>&1 >> "$REPORT"
DBS=$(db2 list database directory 2>/dev/null \
  | grep -i "Database name" | awk '{print $4}' | LC_ALL=C sort || true)

if [ -z "${DBS:-}" ]; then
  log "FATAL: No databases found — cannot continue"
  progress "FATAL: No databases discovered"
  exit 1
fi

DB_COUNT=$(echo "$DBS" | wc -w | tr -d ' ')
log "Discovered: $DBS"
log "Count     : $DB_COUNT"
blankln

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 3 — INSTANCE CONFIG
# ════════════════════════════════════════════════════════════════════════════════
section "3. Instance Config"
progress "Section 3: instance config"

db2 get dbm cfg 2>&1 | grep -iE \
  'MAX_CONNECTIONS|MAX_COORDAGENTS|SHEAPTHRES_SHR|SHEAPTHRES|INTRA_PARALLEL' \
  >> "$REPORT" 2>&1
blankln

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 4 — PER-DATABASE COLLECTION
# weekly:  incidents + health signals
# overall: everything weekly collects, plus catalog stats, top tables,
#          stale stats, index health, top SQL, memory pools
# ════════════════════════════════════════════════════════════════════════════════
section "4. Per-Database Collection"

for DB in $DBS; do

  DB_START=$(date +%s)
  progress "[$DB] Starting"
  section "DATABASE: $DB"

  # ── Connect ────────────────────────────────────────────────────────────────
  db2 connect to "$DB" >> "$REPORT" 2>&1
  rc=$?
  if [ $rc -ne 0 ]; then
    log "CONNECT FAILED (rc=$rc) — skipping $DB"
    DB_CONNECT_STATUS[$DB]="FAILED"
    db2 terminate >/dev/null 2>&1 || true
    progress "[$DB] CONNECT FAILED"
    continue
  fi
  DB_CONNECT_STATUS[$DB]="CONNECTED"

  # ── 4a. DB Config ─────────────────────────────────────────────────────────
  progress "[$DB] Config"
  subsect "Database Config"
  _cfg_out=$(db2 get db cfg for "$DB" 2>/dev/null)
  echo "$_cfg_out" | grep -iE \
    'LOGFILSIZ|LOGPRIMARY|LOGSECOND|LOGARCHMETH|LOGARCHCOMPR|'\
    'HADR_SYNC_MODE|HADR_DB_ROLE|AUTO_RUNSTATS|TRACKMOD|LOCKTIMEOUT|'\
    'SELF_TUNING_MEM|LOGPATH' >> "$REPORT" 2>&1
  blankln

  # Extract tracked values
  _lf=$(_gv "$_cfg_out" 'Log file size');           DB_LOGFILSIZ[$DB]="${_lf:-UNKNOWN}"
  _lp=$(_gv "$_cfg_out" 'Number of primary log');   DB_LOGPRIMARY[$DB]="${_lp:-UNKNOWN}"
  _ls=$(_gv "$_cfg_out" 'Number of secondary log'); DB_LOGSECOND[$DB]="${_ls:-UNKNOWN}"
  _a1=$(_gv "$_cfg_out" 'LOGARCHMETH1');            DB_LOGARCHMETH1[$DB]="${_a1:-UNKNOWN}"
  _a2=$(_gv "$_cfg_out" 'LOGARCHMETH2');            DB_LOGARCHMETH2[$DB]="${_a2:-UNKNOWN}"
  _ac=$(_gv "$_cfg_out" 'LOGARCHCOMPR1');           DB_LOGARCHCOMPR[$DB]="${_ac:-UNKNOWN}"
  _tm=$(_gv "$_cfg_out" 'Track modified pages');    DB_TRACKMOD[$DB]="${_tm:-UNKNOWN}"
  _hs=$(_gv "$_cfg_out" 'HADR_SYNC_MODE');          DB_HADR_SYNC[$DB]="${_hs:-NOT_CONFIGURED}"
  _hr=$(_gv "$_cfg_out" 'HADR_DB_ROLE');            DB_HADR_ROLE[$DB]="${_hr:-UNKNOWN}"
  _st=$(_gv "$_cfg_out" 'Self tuning memory');      DB_STMM[$DB]="${_st:-UNKNOWN}"
  _lo=$(_gv "$_cfg_out" 'Lock timeout');            DB_LOCKTIMEOUT[$DB]="${_lo:-UNKNOWN}"
  _ll=$(_gv "$_cfg_out" 'Max storage for lock');    DB_LOCKLIST[$DB]="${_ll:-UNKNOWN}"
  _ml=$(_gv "$_cfg_out" 'Percent. of lock lists');  DB_MAXLOCKS[$DB]="${_ml:-UNKNOWN}"
  _ar=$(_gv "$_cfg_out" 'AUTO_RUNSTATS');           DB_AUTOCOLLECT_STATS[$DB]="${_ar:-UNKNOWN}"

  # ── 4b. Tablespace sizing ─────────────────────────────────────────────────
  progress "[$DB] Tablespace sizes"
  subsect "Tablespace Sizing"

  if is_overall; then
    db2 -x "SELECT
      TBSP_NAME, TBSP_TYPE, TBSP_STATE,
      ROUND(TBSP_TOTAL_SIZE_KB/1024.0/1024.0,2)                        AS total_gb,
      ROUND(TBSP_USED_SIZE_KB/1024.0/1024.0,2)                         AS used_gb,
      ROUND((TBSP_TOTAL_SIZE_KB-TBSP_USED_SIZE_KB)/1024.0/1024.0,2)    AS free_gb,
      ROUND((TBSP_TOTAL_SIZE_KB-TBSP_USED_SIZE_KB)*100.0
        /NULLIF(TBSP_TOTAL_SIZE_KB,0),1)                               AS free_pct,
      TBSP_AUTO_RESIZE_ENABLED
    FROM TABLE(MON_GET_TABLESPACE(NULL,-2))
    ORDER BY total_gb DESC" >> "$REPORT" 2>&1
  else
    # weekly: totals + any abnormal state
    db2 -x "SELECT
      ROUND(SUM(TBSP_TOTAL_SIZE_KB)/1024.0/1024.0,2) AS total_alloc_gb,
      ROUND(SUM(TBSP_USED_SIZE_KB)/1024.0/1024.0,2)  AS total_used_gb,
      ROUND((SUM(TBSP_TOTAL_SIZE_KB)-SUM(TBSP_USED_SIZE_KB))*100.0
        /NULLIF(SUM(TBSP_TOTAL_SIZE_KB),0),1)         AS free_pct
    FROM TABLE(MON_GET_TABLESPACE(NULL,-2))" >> "$REPORT" 2>&1
    db2 -x "SELECT TBSP_NAME, TBSP_STATE
      FROM TABLE(MON_GET_TABLESPACE(NULL,-2))
      WHERE TBSP_STATE <> 0" >> "$REPORT" 2>&1 \
        || log "(All tablespaces normal state)"
  fi

  _ug=$(db2 -x "SELECT CHAR(ROUND(SUM(TBSP_USED_SIZE_KB)/1024.0/1024.0,2)) \
    FROM TABLE(MON_GET_TABLESPACE(NULL,-2))" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9.]/,"",$1); if($1~/^[0-9]/) print $1}')
  _tg=$(db2 -x "SELECT CHAR(ROUND(SUM(TBSP_TOTAL_SIZE_KB)/1024.0/1024.0,2)) \
    FROM TABLE(MON_GET_TABLESPACE(NULL,-2))" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9.]/,"",$1); if($1~/^[0-9]/) print $1}')
  DB_USED_GB[$DB]="${_ug:-UNKNOWN}"
  DB_TOTAL_GB[$DB]="${_tg:-UNKNOWN}"
  log "Size: used=${DB_USED_GB[$DB]} GB  allocated=${DB_TOTAL_GB[$DB]} GB"
  blankln

  # ── 4c. Catalog stats — overall only ─────────────────────────────────────
  if is_overall; then
    progress "[$DB] Catalog stats"
    subsect "Schema and Table Statistics"

    db2 -x "SELECT SCHEMANAME, COUNT(*) AS table_count
      FROM SYSCAT.TABLES WHERE TYPE='T'
      GROUP BY SCHEMANAME ORDER BY table_count DESC
      FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1

    db2 -x "SELECT
      COUNT(*)                                           AS total_user_tables,
      SUM(CARD)                                         AS total_rows_all_tables,
      MAX(CARD)                                         AS largest_table_rows,
      SUM(CASE WHEN CARD = 0       THEN 1 ELSE 0 END)  AS empty_tables,
      SUM(CASE WHEN CARD > 1000000 THEN 1 ELSE 0 END)  AS tables_over_1m_rows
    FROM SYSCAT.TABLES
    WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'" >> "$REPORT" 2>&1

    _tc=$(db2 -x "SELECT CHAR(COUNT(*)) FROM SYSCAT.TABLES \
      WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'" 2>/dev/null \
      | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
    _sc=$(db2 -x "SELECT CHAR(COUNT(DISTINCT SCHEMANAME)) FROM SYSCAT.TABLES \
      WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'" 2>/dev/null \
      | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
    _mc=$(db2 -x "SELECT CHAR(MAX(CARD)) FROM SYSCAT.TABLES \
      WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'" 2>/dev/null \
      | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
    _totc=$(db2 -x "SELECT CHAR(COALESCE(SUM(CARD),0)) FROM SYSCAT.TABLES \
      WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'" 2>/dev/null \
      | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
    DB_TABLE_COUNT[$DB]="${_tc:-0}";  DB_SCHEMA_COUNT[$DB]="${_sc:-0}"
    DB_MAX_CARD[$DB]="${_mc:-0}";     DB_TOTAL_CARD[$DB]="${_totc:-0}"
    log "Tables=${DB_TABLE_COUNT[$DB]} Schemas=${DB_SCHEMA_COUNT[$DB]}"
    log "Largest=${DB_MAX_CARD[$DB]} rows  Total=${DB_TOTAL_CARD[$DB]} rows"
    blankln

    subsect "Top 20 Tables by Physical Size"
    db2 -x "SELECT
      TABSCHEMA, TABNAME, CARD AS row_count,
      ROUND((DATA_OBJECT_P_SIZE+INDEX_OBJECT_P_SIZE+LONG_OBJECT_P_SIZE+
             LOB_OBJECT_P_SIZE+XML_OBJECT_P_SIZE)/1024.0/1024.0,3) AS total_gb,
      REORG_PENDING, DATE(STATS_TIME) AS last_stats
    FROM SYSIBMADM.ADMINTABINFO
    WHERE TABSCHEMA NOT LIKE 'SYS%'
    ORDER BY total_gb DESC
    FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1
    blankln

    subsect "Stale Statistics (>7 days, >100k rows)"
    db2 -x "SELECT
      TABSCHEMA, TABNAME, CARD,
      DATE(STATS_TIME)                       AS last_stats,
      DAYS(CURRENT_DATE) - DAYS(STATS_TIME)  AS days_old
    FROM SYSCAT.TABLES
    WHERE TABSCHEMA NOT LIKE 'SYS%' AND TYPE='T'
      AND (STATS_TIME IS NULL OR STATS_TIME < CURRENT_TIMESTAMP - 7 DAYS)
      AND CARD > 100000
    ORDER BY CARD DESC FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1
    blankln

    subsect "Indexes with Low Cluster Ratio (<80%, tables >500k rows)"
    db2 -x "SELECT
      I.TABSCHEMA, I.TABNAME, I.INDNAME, I.CLUSTERRATIO, T.CARD AS table_rows
    FROM SYSCAT.INDEXES I
    JOIN SYSCAT.TABLES T ON I.TABSCHEMA=T.TABSCHEMA AND I.TABNAME=T.TABNAME
    WHERE I.TABSCHEMA NOT LIKE 'SYS%'
      AND T.CARD > 500000 AND I.CLUSTERRATIO < 80 AND I.CLUSTERRATIO >= 0
    ORDER BY T.CARD DESC FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1
    blankln

  else
    # weekly: total row count only (for parity check)
    _totc=$(db2 -x "SELECT CHAR(COALESCE(SUM(CARD),0)) FROM SYSCAT.TABLES \
      WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'" 2>/dev/null \
      | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
    DB_TOTAL_CARD[$DB]="${_totc:-0}"
    DB_TABLE_COUNT[$DB]="N/A"; DB_SCHEMA_COUNT[$DB]="N/A"; DB_MAX_CARD[$DB]="N/A"
    log "Total rows (all tables): ${DB_TOTAL_CARD[$DB]}"
    blankln
  fi

  # ── 4d. Reorg pending — all modes ─────────────────────────────────────────
  progress "[$DB] Reorg pending"
  subsect "Reorg Pending"
  _rp=$(db2 -x "SELECT COUNT(*) FROM SYSIBMADM.ADMINTABINFO \
    WHERE REORG_PENDING='Y' AND TABSCHEMA NOT LIKE 'SYS%'" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_REORG_PENDING_COUNT[$DB]="${_rp:-0}"
  log "Reorg pending: ${DB_REORG_PENDING_COUNT[$DB]} table(s)"
  if [ "${DB_REORG_PENDING_COUNT[$DB]}" -gt 0 ]; then
    db2 -x "SELECT TABSCHEMA, TABNAME, CARD
      FROM SYSIBMADM.ADMINTABINFO
      WHERE REORG_PENDING='Y' AND TABSCHEMA NOT LIKE 'SYS%'
      ORDER BY CARD DESC" >> "$REPORT" 2>&1
  fi
  blankln

  # ── 4e. Transaction log — all modes ───────────────────────────────────────
  progress "[$DB] Transaction log"
  subsect "Transaction Log Status"
  db2 -x "SELECT
    TOTAL_LOG_USED_KB, TOTAL_LOG_AVAILABLE_KB,
    ROUND(TOTAL_LOG_USED_KB*100.0
      /NULLIF(TOTAL_LOG_USED_KB+TOTAL_LOG_AVAILABLE_KB,0),1) AS log_used_pct,
    NUM_LOG_SPAN, LOG_HADR_WAITS_TOTAL,
    CURRENT_ACTIVE_LOG, APPLID_HOLDING_OLDEST_XACT
  FROM TABLE(MON_GET_TRANSACTION_LOG(-2))" >> "$REPORT" 2>&1

  _lu=$(db2 -x "SELECT CHAR(TOTAL_LOG_USED_KB) \
    FROM TABLE(MON_GET_TRANSACTION_LOG(-2))" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  _la=$(db2 -x "SELECT CHAR(TOTAL_LOG_AVAILABLE_KB) \
    FROM TABLE(MON_GET_TRANSACTION_LOG(-2))" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_LOG_USED_KB[$DB]="${_lu:-0}"; DB_LOG_AVAIL_KB[$DB]="${_la:-0}"
  blankln

  # ── 4f. Lock waits — all modes ────────────────────────────────────────────
  progress "[$DB] Lock waits"
  subsect "Active Lock Waits"
  db2 -x "SELECT
    AGENT_ID, LOCK_OBJECT_TYPE, LOCK_MODE, LOCK_MODE_REQUESTED,
    LOCK_WAIT_ELAPSED_TIME, SUBSTR(LOCK_NAME,1,20) AS lock_name
  FROM TABLE(MON_GET_APPL_LOCKWAIT(NULL,-2))
  ORDER BY LOCK_WAIT_ELAPSED_TIME DESC
  FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1

  _lw=$(db2 -x "SELECT CHAR(COUNT(*)) \
    FROM TABLE(MON_GET_APPL_LOCKWAIT(NULL,-2))" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_LOCK_WAITS[$DB]="${_lw:-0}"
  blankln

  # ── 4g. Long transactions — all modes ────────────────────────────────────
  progress "[$DB] Long transactions"
  subsect "Long-Running Transactions >60s"
  db2 -x "SELECT
    APPLICATION_HANDLE,
    SUBSTR(APPLICATION_NAME,1,30) AS app_name,
    SUBSTR(CLIENT_HOSTNAME,1,20)  AS client_host,
    UOW_ELAPSED_TIME_US/1000000  AS elapsed_sec,
    ROWS_MODIFIED, ISOLATION_LEVEL
  FROM TABLE(MON_GET_UNIT_OF_WORK(NULL,-2))
  WHERE UOW_ELAPSED_TIME_US > 60000000
  ORDER BY UOW_ELAPSED_TIME_US DESC" >> "$REPORT" 2>&1

  _lt=$(db2 -x "SELECT CHAR(COUNT(*)) \
    FROM TABLE(MON_GET_UNIT_OF_WORK(NULL,-2)) \
    WHERE UOW_ELAPSED_TIME_US > 60000000" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_LONG_TXN_COUNT[$DB]="${_lt:-0}"
  blankln

  # ── 4h. Active connections — all modes ────────────────────────────────────
  progress "[$DB] Connections"
  subsect "Active Connections"
  db2 -x "SELECT
    SUBSTR(APPLICATION_NAME,1,35) AS app_name,
    COUNT(*) AS conn_count
  FROM TABLE(MON_GET_CONNECTION(NULL,-2))
  GROUP BY APPLICATION_NAME ORDER BY conn_count DESC
  FETCH FIRST 15 ROWS ONLY" >> "$REPORT" 2>&1

  _cc=$(db2 -x "SELECT CHAR(COUNT(*)) \
    FROM TABLE(MON_GET_CONNECTION(NULL,-2))" 2>/dev/null \
    | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_CONNECT_COUNT[$DB]="${_cc:-0}"
  blankln

  # ── 4i. Top SQL — overall only ────────────────────────────────────────────
  if is_overall; then
    progress "[$DB] Top SQL"
    subsect "Top 10 SQL by Total Execution Time"
    db2 -x "SELECT
      ROUND(TOTAL_EXEC_TIME/1000.0,2) AS total_exec_ms,
      NUM_EXECUTIONS,
      ROUND(AVG_EXEC_TIME/1000.0,2)  AS avg_exec_ms,
      ROWS_RETURNED,
      SUBSTR(STMT_TEXT,1,120)         AS sql_snippet
    FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL,NULL,NULL,-2))
    WHERE STMT_TYPE_ID=5
    ORDER BY TOTAL_EXEC_TIME DESC
    FETCH FIRST 10 ROWS ONLY" >> "$REPORT" 2>&1
    blankln
  fi

  # ── 4j. HADR — all modes ─────────────────────────────────────────────────
  progress "[$DB] HADR"
  subsect "HADR Status (db2pd)"
  db2pd -hadr -db "$DB" 2>/dev/null | head -60 >> "$REPORT" \
    || log "(db2pd -hadr unavailable)"
  blankln

  # ── 4k. Memory pools — overall only ──────────────────────────────────────
  if is_overall; then
    progress "[$DB] Memory pools"
    subsect "Memory Pool Allocation (db2pd -memsets)"
    db2pd -memsets -db "$DB" 2>/dev/null | head -60 >> "$REPORT" \
      || log "(db2pd -memsets unavailable)"
    blankln
  fi

  # ── 4l. Backup history — all modes ───────────────────────────────────────
  progress "[$DB] Backup history"
  subsect "Backup History"
  _hist_out=$(db2 "LIST HISTORY BACKUP ALL FOR $DB" 2>/dev/null || true)
  echo "$_hist_out" \
    | grep -iE "Backup|Start Time|End Time|Type|Status|Successful" \
    | tail -40 >> "$REPORT" || true
  _lbts=$(echo "$_hist_out" | grep "Start Time" | tail -1 \
    | awk '{print $NF}' || true)
  DB_BACKUP_TS[$DB]="${_lbts:-UNKNOWN}"
  log "Last backup: ${DB_BACKUP_TS[$DB]}"
  blankln

  db2 terminate >/dev/null 2>&1 || true
  DB_END=$(date +%s)
  progress "[$DB] Done — $((DB_END - DB_START))s"

done

