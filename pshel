  esac
}

# Did db2level capture succeed?
if grep -q "DB2 v" "$REPORT" 2>/dev/null || grep -q "Informational tokens" "$REPORT" 2>/dev/null; then
  check_v "db2level captured" "PASS" "Version info present in report"
else
  check_v "db2level captured" "FAIL" "Version not found in report — db2 environment may not have sourced correctly"
fi

# DBM config captured?
if grep -qiE 'MAX_CONNECTIONS|MAX_COORDAGENTS' "$REPORT" 2>/dev/null; then
