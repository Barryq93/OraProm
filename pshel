#!/bin/bash

# This script recursively changes ownership of files and directories
# in a specified directory to the provided group and user.
# It also measures the total time and the time taken for each directory.

# Ensure the script is run with sudo or root privileges
if [[ $EUID -ne 0 ]]; then
    echo "This script must be run as root. Please use sudo."
    exit 1
fi

# Check if the user has provided correct arguments
if [[ $# -ne 2 ]]; then
    echo "Usage: $0 <group:user> <directory>"
    echo "Example: $0 developers:john /path/to/dir"
    exit 1
fi

# Parse arguments
OWNER=$1    # Ownership format: group:user
DIR=$2      # Target directory to process

# Check if the target directory exists
if [[ ! -d $DIR ]]; then
    echo "Error: Directory '$DIR' does not exist."
    exit 1
fi

# Start timer to measure script execution time
START_TIME=$(date +%s)

# Function to process items in a given directory and time each one
process_items() {
    local path=$1
    echo "Starting processing for: $path"
    
    # Record start time for this directory
    DIR_START_TIME=$(date +%s)
    
    # Process all items in this directory
    find "$path" -mindepth 1 -maxdepth 1 -print0 | xargs -0 -n 1000 -P 8 chown "$OWNER"
    
    # Record end time for this directory
    DIR_END_TIME=$(date +%s)
    
    # Calculate elapsed time for this directory
    DIR_ELAPSED_TIME=$((DIR_END_TIME - DIR_START_TIME))
    echo "Finished processing for: $path (Time: $DIR_ELAPSED_TIME seconds)"
}

# Change ownership of the root directory itself
echo "Changing ownership of the root directory: $DIR"
chown "$OWNER" "$DIR"

# Export variables and function for use in subshells
export OWNER
export -f process_items

# Recursively process all subdirectories in parallel
echo "Processing all subdirectories under: $DIR"
find "$DIR" -type d -print0 | xargs -0 -n 1 -P 8 bash -c 'process_items "$@"' _

# End timer and calculate total elapsed time
END_TIME=$(date +%s)
TOTAL_ELAPSED_TIME=$((END_TIME - START_TIME))

# Output elapsed time
echo "Ownership change completed!"
echo "Total elapsed time: $((TOTAL_ELAPSED_TIME / 60)) minutes and $((TOTAL_ELAPSED_TIME % 60)) seconds."
