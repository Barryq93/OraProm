#!/usr/bin/env bash
set -euo pipefail

DB=YOURDB
ROLE=ROLE_READ_ALL
GROUP=auto

SQLFILE=/tmp/db2_readall.sql
LOGFILE=/tmp/db2_readall.log

echo "Connecting to $DB..."
db2 connect to "$DB" >/dev/null

echo "Building grant script..."

cat > "$SQLFILE" <<EOF
-- create role if missing
BEGIN
  DECLARE v INT DEFAULT 0;
  SELECT COUNT(*) INTO v FROM SYSCAT.ROLES WHERE ROLNAME='${ROLE}';
  IF v = 0 THEN
    EXECUTE IMMEDIATE 'CREATE ROLE ${ROLE}';
  END IF;
END
@

GRANT ROLE ${ROLE} TO GROUP ${GROUP};
GRANT CONNECT ON DATABASE TO ROLE ${ROLE};
GRANT SYSMON TO ROLE ${ROLE};
GRANT EXPLAIN TO ROLE ${ROLE};

EOF

echo "Adding table schemas..."

db2 -x "select distinct tabschema from syscat.tables order by 1" |
while read S; do
  echo "GRANT SELECT ON ALL TABLES IN SCHEMA ${S} TO ROLE ${ROLE};" >> "$SQLFILE"
done

echo "Adding view schemas..."

db2 -x "select distinct viewschema from syscat.views order by 1" |
while read S; do
  echo "GRANT SELECT ON ALL VIEWS IN SCHEMA ${S} TO ROLE ${ROLE};" >> "$SQLFILE"
done

echo "CONNECT RESET;" >> "$SQLFILE"

echo "Executing grants..."
db2 -td@ -vf "$SQLFILE" | tee "$LOGFILE"

echo
echo "✔ Completed"
echo "Log: $LOGFILE"
echo "SQL: $SQLFILE"