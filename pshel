groups:
  - name: websphere-alerts
    rules:
      # JVM Alerts
      - alert: WebSphere_JVM_High_Heap_Usage
        expr: (was_jvm_runtime_heap_used_bytes / was_jvm_runtime_heap_max_bytes) * 100 > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High JVM Heap Usage on {{ $labels.instance }}"
          description: "JVM Heap is above 80% usage."

      - alert: WebSphere_JVM_Near_OutOfMemory
        expr: (was_jvm_runtime_heap_used_bytes / was_jvm_runtime_heap_max_bytes) * 100 > 95
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "JVM Out of Memory Risk on {{ $labels.instance }}"
          description: "JVM Heap is above 95%! Possible OutOfMemory risk."

      - alert: WebSphere_High_CPU
        expr: rate(was_jvm_runtime_process_cpu_usage[5m]) * 100 > 90
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High CPU Usage on WebSphere {{ $labels.instance }}"
          description: "CPU usage is above 90% for the last 5 minutes."

      - alert: WebSphere_High_GC_Time
        expr: rate(was_jvm_runtime_gc_time_seconds_total[5m]) > 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High JVM GC Time on {{ $labels.instance }}"
          description: "Garbage Collection is taking more than 1 second per second."

      - alert: WebSphere_Process_Down
        expr: was_jvm_runtime_uptime_seconds == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "WebSphere Instance Down on {{ $labels.instance }}"
          description: "WebSphere JVM process has been down for more than 2 minutes."

      # HTTP Request & Web Endpoint Alerts
      - alert: WebSphere_High_Response_Time
        expr: histogram_quantile(0.95, rate(was_servlet_response_time_seconds_bucket[5m])) > 2
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High Response Time on WebSphere {{ $labels.instance }}"
          description: "95th percentile response time > 2s."

      - alert: WebSphere_High_5xx_Errors
        expr: rate(was_servlet_request_count_total{status=~"5.."}[5m]) > 10
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "High 5xx Errors on WebSphere {{ $labels.instance }}"
          description: "More than 10 HTTP 5xx errors per second."

      - alert: WebSphere_Low_Traffic
        expr: rate(was_servlet_request_count_total[5m]) < 1
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Low Traffic on WebSphere {{ $labels.instance }}"
          description: "Less than 1 request per second, potential downtime."

      - alert: WebSphere_High_Active_Sessions
        expr: was_session_active_count > 1000
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High Active Sessions on WebSphere {{ $labels.instance }}"
          description: "More than 1000 active sessions detected."

      # JDBC Connection Pool Alerts
      - alert: WebSphere_High_JDBC_Connection_Usage
        expr: (was_jdbc_pool_used_connections / was_jdbc_pool_max_connections) * 100 > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High JDBC Connection Usage on {{ $labels.instance }}"
          description: "More than 80% of JDBC connection pool in use."

      - alert: WebSphere_JDBC_Connection_Exhausted
        expr: (was_jdbc_pool_used_connections / was_jdbc_pool_max_connections) * 100 > 95
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "JDBC Connection Pool Exhausted on {{ $labels.instance }}"
          description: "More than 95% of JDBC connection pool in use!"

      # Thread Pool Alerts
      - alert: WebSphere_High_Thread_Pool_Usage
        expr: (was_threadpool_active_threads / was_threadpool_max_threads) * 100 > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High Thread Pool Usage on WebSphere {{ $labels.instance }}"
          description: "More than 80% of the thread pool is in use."

      - alert: WebSphere_Thread_Pool_Exhausted
        expr: (was_threadpool_active_threads / was_threadpool_max_threads) * 100 > 95
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Thread Pool Exhausted on WebSphere {{ $labels.instance }}"
          description: "More than 95% of the thread pool is in use! Requests may be blocked."