WITH all_used AS (
    -- all batch IDs that exist in the table in the range
    SELECT DISTINCT batch_id
    FROM ECMEVT_BATCH_INFO
    WHERE batch_id BETWEEN 2000000 AND 2100000
),
unused AS (
    -- all missing IDs in the range + row number
    SELECT n AS new_batch,
           ROW_NUMBER() OVER (ORDER BY n) AS rn
    FROM (
        SELECT 2000000 + LEVEL - 1 AS n
        FROM dual
        CONNECT BY LEVEL <= (2100000 - 2000000 + 1)
    )
    WHERE n NOT IN (SELECT batch_id FROM all_used)
),
used AS (
    -- existing IDs + row number
    SELECT batch_id AS old_batch,
           ROW_NUMBER() OVER (ORDER BY batch_id) AS rn
    FROM all_used
)
SELECT
    u.old_batch,
    n.new_batch
FROM used  u
JOIN unused n
  ON u.rn = n.rn         -- pair by row number
WHERE n.rn <= 2000       -- first 2k unused
ORDER BY n.new_batch;
