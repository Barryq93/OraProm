$prometheusPath = "D:\Monitoring\Prometheus\prometheus.exe"  # Path to your prometheus.exe
$prometheusConfig = "--config.file='D:\Monitoring\Prometheus\prometheus.yml'" # Prometheus arguments
$prometheusDataDir = "D:\Monitoring\Prometheus\data" # Prometheus data directory
$prometheusLogDir = "D:\Monitoring\Prometheus\logs" # Prometheus log directory

# Create the service (without arguments initially)
New-Service -Name "Prometheus" -BinaryPath $prometheusPath -StartupType Automatic -Description "Prometheus Monitoring Service"

# Set the arguments and working directory (this is the crucial part)
$service = Get-Service -Name "Prometheus"

# Create directories if they do not exist
if (!(Test-Path $prometheusDataDir)) {
    New-Item -ItemType Directory -Path $prometheusDataDir | Out-Null
}

if (!(Test-Path $prometheusLogDir)) {
    New-Item -ItemType Directory -Path $prometheusLogDir | Out-Null
}

$process = Start-Process -FilePath $prometheusPath -ArgumentList $prometheusConfig -WorkingDirectory "D:\Monitoring\Prometheus" -PassThru # -PassThru is important!

# You can use the $process object if needed for further management.

# Optional: Set service description
Set-Service -Name "Prometheus" -Description "Prometheus Monitoring Service"
