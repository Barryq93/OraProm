v_pass=0; v_fail=0; v_warn=0

check_v() {
  local label="$1"
  local result="$2"   # PASS / FAIL / WARN
  local detail="$3"
  printf "  [%-4s] %s — %s\n" "$result" "$label" "$detail" >> "$VERIFY"
  case "$result" in
    PASS) ((v_pass++)) ;;
    FAIL) ((v_fail++)) ;;
