#!/bin/bash

# DB2 Reorganization Script with Estimation Mode (Offline Tables, Index Reorg, Runstats, and db2rbind)
# IMPROVED VERSION: Single connection per job, reduced logging verbosity, better reliability
# This script quiesces the database, performs basic offline reorgs and runstats on tables concurrently
# in a single job format with continuous concurrency, rebinds all packages with db2rbind, and logs to a single file

# Check command line arguments
if [ "$#" -ne 1 ] || ([ "$1" != "estimate" ] && [ "$1" != "run" ]); then
    echo "Usage: $0 estimate|run"
    echo "  estimate - Only show time estimates without running reorg, runstats, or db2rbind"
    echo "  run      - Execute the full offline reorganization, runstats, and db2rbind"
    exit 1
fi

MODE=$1
echo "Running in $MODE mode"

# --- BEGIN USER CONFIGURATION ---
# Set environment variables (ADJUST THESE VALUES)
DB_NAME="your_database_name" # <--- CHANGE THIS
DB_USER="your_db_user"       # <--- CHANGE THIS
# WARNING: Storing passwords in scripts is insecure. Use safer methods for production.
DB_PASS="your_db_password"   # <--- CHANGE THIS
CONCURRENT_JOBS=3  # Number of concurrent reorg jobs

# Directory for logs
LOG_DIR="/path/to/logs" # <--- CHANGE THIS
# --- END USER CONFIGURATION ---

mkdir -p $LOG_DIR

# Single log file
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SUMMARY_LOG="$LOG_DIR/reorg_summary_${MODE}_${TIMESTAMP}.log"
echo "DB2 Offline Reorganization, Runstats, and db2rbind $MODE started at $(date)" > $SUMMARY_LOG
TOTAL_START_TIME=$(date +%s)
echo "Time window: 4 hours" >> $SUMMARY_LOG
echo "WARNING: This script uses hardcoded credentials for DB_USER/DB_PASS. This is NOT recommended for production environments." >> $SUMMARY_LOG

# Function to estimate reorg, runstats, and db2rbind time based on table and index sizes (offline)
estimate_time() {
    TABLE_SIZE_GB=$1  # Data size only
    INDEX_SIZE_GB=$2  # Total index size
    # Robust validation: ensure numeric and non-empty, handle all sizes
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid TABLE_SIZE_GB '$TABLE_SIZE_GB', defaulting to 0.01" >> $SUMMARY_LOG
        TABLE_SIZE_GB="0.01"
    else
        TABLE_SIZE_GB=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid INDEX_SIZE_GB '$INDEX_SIZE_GB', defaulting to 0.01" >> $SUMMARY_LOG
        INDEX_SIZE_GB="0.01"
    fi

    # Base table reorg time: 1 min/GB, 1.2x for tables > 50GB
    COMPARE_RESULT=$(awk -v size="$TABLE_SIZE_GB" -v thresh=50 'BEGIN {print (size > thresh) ? 1 : 0}')
    if [ "$COMPARE_RESULT" -eq 1 ]; then
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.0f", size * 1.2}')
    else
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size}')
    fi
    # Offline index reorg time: 0.5 min/GB
    INDEX_EST_MINS=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size * 0.5}')
    # Runstats time: 0.1 min/GB for table + indexes
    RUNSTATS_EST_MINS=$(awk -v table="$TABLE_SIZE_GB" -v idx="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", ((table + idx) < 0.01) ? 1 : (table + idx) * 0.1}')
    # Total estimate with 5% reduction for offline efficiency
    TOTAL_EST_MINS=$(awk -v table="$TABLE_EST_MINS" -v idx="$INDEX_EST_MINS" -v runstats="$RUNSTATS_EST_MINS" 'BEGIN {printf "%.0f", (table + idx + runstats) * 0.95}')
    # Ensure minimum of 1 minute as estimate
    [ "$TOTAL_EST_MINS" -lt 1 ] && TOTAL_EST_MINS=1
    echo "$TOTAL_EST_MINS"
}

# Function to process a batch of tables in a single connection job
process_table_batch() {
    # The tables to process are received as parameters
    # Syntax: process_table_batch "TABLE1 SCHEMA1 SIZE1_GB INDEX1_GB" "TABLE2 SCHEMA2 SIZE2_GB INDEX2_GB" ...
    
    if [ $# -eq 0 ]; then
        echo "No tables provided to process_table_batch" >> $SUMMARY_LOG
        return 0
    fi
    
    # Connect once at the beginning of this batch
    db2 connect to "$DB_NAME" user "$DB_USER" using "$DB_PASS" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "ERROR: Failed to connect to database $DB_NAME for batch processing" >> $SUMMARY_LOG
        return 1
    fi
    
    # Process each table in this batch with the same connection
    for TABLE_INFO in "$@"; do
        set -- $TABLE_INFO
        TABLE_NAME=$1
        SCHEMA_NAME=$2
        TABLE_SIZE_GB=$3
        INDEX_SIZE_GB=$4
        
        # Clean sizes (in case they're passed with issues)
        if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then 
            TABLE_SIZE_GB="0.01"
        fi
        if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
            INDEX_SIZE_GB="0.01"
        fi
        
        # Calculate estimates for logging
        TOTAL_EST_MINS=$(estimate_time "$TABLE_SIZE_GB" "$INDEX_SIZE_GB")
        
        if [ "$MODE" = "run" ]; then
            START_TIME=$(date +%s)
            echo "Starting offline table reorg for $SCHEMA_NAME.$TABLE_NAME (Table: ${TABLE_SIZE_GB}GB, Indexes: ${INDEX_SIZE_GB}GB, est. ${TOTAL_EST_MINS} mins) at $(date)" >> $SUMMARY_LOG

            echo "Running REORG TABLE for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
            db2 "REORG TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG 2>&1
            TABLE_REORG_STATUS=$?

            if [ $TABLE_REORG_STATUS -eq 0 ]; then
                echo "Table reorg for $SCHEMA_NAME.$TABLE_NAME completed successfully" >> $SUMMARY_LOG
            else
                echo "ERROR: Table reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $TABLE_REORG_STATUS" >> $SUMMARY_LOG
                db2 terminate > /dev/null 2>&1 # Terminate connection on error
                return 1
            fi

            echo "Running index reorg for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
            db2 "REORG INDEXES ALL FOR TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG 2>&1
            INDEX_REORG_STATUS=$?

            if [ $INDEX_REORG_STATUS -eq 0 ]; then
                echo "Index reorg for $SCHEMA_NAME.$TABLE_NAME completed successfully" >> $SUMMARY_LOG
            else
                echo "ERROR: Index reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $INDEX_REORG_STATUS" >> $SUMMARY_LOG
                db2 terminate > /dev/null 2>&1 # Terminate connection on error
                return 1
            fi

            echo "Running runstats for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
            db2 "RUNSTATS ON TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\" WITH DISTRIBUTION AND DETAILED INDEXES ALL" >> $SUMMARY_LOG 2>&1
            RUNSTATS_STATUS=$?

            END_TIME=$(date +%s)
            DURATION=$((END_TIME - START_TIME))
            MINUTES=$((DURATION / 60))
            SECONDS=$((DURATION % 60))

            if [ $RUNSTATS_STATUS -eq 0 ]; then
                echo "Completed table reorg, index reorg, and runstats for $SCHEMA_NAME.$TABLE_NAME successfully in ${MINUTES}m ${SECONDS}s" >> $SUMMARY_LOG
            else
                echo "ERROR: Runstats for $SCHEMA_NAME.$TABLE_NAME failed with status $RUNSTATS_STATUS after ${MINUTES}m ${SECONDS}s" >> $SUMMARY_LOG
                db2 terminate > /dev/null 2>&1 # Terminate connection on error
                return 1
            fi
        else
            # Just log estimates in estimate mode
            TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" -v thresh=50 'BEGIN {print (size > thresh) ? int(size * 1.2) : (size < 0.01) ? 1 : int(size)}')
            INDEX_EST_MINS=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size * 0.5}')
            RUNSTATS_EST_MINS=$(awk -v table="$TABLE_SIZE_GB" -v idx="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", ((table + idx) < 0.01) ? 1 : (table + idx) * 0.1}')
            echo "ESTIMATE: $SCHEMA_NAME.$TABLE_NAME (Table: ${TABLE_SIZE_GB}GB, est. ${TABLE_EST_MINS} mins; Indexes: ${INDEX_SIZE_GB}GB, est. ${INDEX_EST_MINS} mins; Runstats: est. ${RUNSTATS_EST_MINS} mins; Total: ${TOTAL_EST_MINS} mins)" >> $SUMMARY_LOG
        fi
    done
    
    # Terminate the connection once after all tables in this batch
    db2 terminate > /dev/null 2>&1
    return 0
}

# --- Main Script Logic ---

# Connect to the database (for main script operations)
echo "Establishing main connection to $DB_NAME..." >> $SUMMARY_LOG
db2 connect to "$DB_NAME" user "$DB_USER" using "$DB_PASS" > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to establish main connection to database $DB_NAME" >> $SUMMARY_LOG
    exit 1
fi

# Quiesce the database in run mode
if [ "$MODE" = "run" ]; then
    echo "Quiescing database $DB_NAME at $(date)" >> $SUMMARY_LOG
    db2 "QUIESCE DATABASE IMMEDIATE FORCE CONNECTIONS" >> $SUMMARY_LOG 2>&1
    if [ $? -ne 0 ]; then
        echo "ERROR: Failed to quiesce database $DB_NAME" >> $SUMMARY_LOG
        db2 terminate > /dev/null 2>&1
        exit 1
    fi
    echo "Database $DB_NAME quiesced successfully" >> $SUMMARY_LOG
fi

# Get the list of all tables and indexes by size
TABLE_LIST_FILE="${LOG_DIR}/all_tables_${TIMESTAMP}.txt"
echo "Identifying tables that need reorganization..." >> $SUMMARY_LOG
SQL_QUERY="SELECT RTRIM(TABNAME), RTRIM(TABSCHEMA), \
           COALESCE(CAST(DECIMAL(GREATEST(DATA_OBJECT_P_SIZE, 0)) / 1024.0 / 1024.0 AS DECIMAL(10,2)), 0.01), \
           COALESCE(CAST(DECIMAL(GREATEST(INDEX_OBJECT_P_SIZE, 0)) / 1024.0 / 1024.0 AS DECIMAL(10,2)), 0.01) \
           FROM SYSIBMADM.ADMINTABINFO \
           WHERE TABSCHEMA NOT LIKE 'SYS%' AND DATA_OBJECT_P_SIZE IS NOT NULL AND INDEX_OBJECT_P_SIZE IS NOT NULL \
           ORDER BY (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) DESC"

db2 -x "$SQL_QUERY" > "$TABLE_LIST_FILE"
QUERY_STATUS=$?
if [ $QUERY_STATUS -ne 0 ]; then
   echo "ERROR: Failed to execute query to get table list (Status: $QUERY_STATUS)" >> $SUMMARY_LOG
   if [ "$MODE" = "run" ]; then
      db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1 # Attempt unquiesce on error
   fi
   db2 terminate > /dev/null 2>&1
   exit 1
fi

# Calculate total time estimate
echo "Calculating time estimates..." >> $SUMMARY_LOG
TOTAL_EST_MINS=0
TABLE_COUNT=0

# First pass to calculate estimates and count tables
while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines
    [[ -z "$line" ]] && continue

    set -- $line
    TABLE_NAME=$1
    SCHEMA_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    # Handle potentially malformed sizes (basic check)
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        TABLE_SIZE_GB="0.01"
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        INDEX_SIZE_GB="0.01"
    fi

    # Calculate estimate and increment counters
    TABLE_EST=$(estimate_time "$TABLE_SIZE_GB" "$INDEX_SIZE_GB")
    TOTAL_EST_MINS=$((TOTAL_EST_MINS + TABLE_EST))
    TABLE_COUNT=$((TABLE_COUNT + 1))
done < "$TABLE_LIST_FILE"

echo "Total tables to process: $TABLE_COUNT" >> $SUMMARY_LOG

# Adjust total estimate for concurrency (divide by CONCURRENT_JOBS for parallel jobs)
# Fixed: Add 1 to ensure we don't divide by zero + provide buffer for very small tables
if [ "$TABLE_COUNT" -gt 0 ] && [ "$CONCURRENT_JOBS" -gt 0 ]; then
    # Use awk for floating point division before rounding
    PARALLEL_EST_MINS=$(awk -v total="$TOTAL_EST_MINS" -v jobs="$CONCURRENT_JOBS" 'BEGIN {printf "%.0f", (total / jobs) + 1}') 
else
    echo "WARNING: No valid tables or CONCURRENT_JOBS=0, setting PARALLEL_EST_MINS to 0" >> $SUMMARY_LOG
    PARALLEL_EST_MINS=0
fi

# Add fixed estimate for db2rbind
DB2RBIND_EST_MINS=5
FINAL_EST_MINS=$((PARALLEL_EST_MINS + DB2RBIND_EST_MINS))

# Calculate hours from minutes
TOTAL_EST_HRS=$(awk -v mins="$FINAL_EST_MINS" 'BEGIN {printf "%.1f", mins / 60}')
echo "Total estimated time for all tables (without concurrency): $TOTAL_EST_MINS minutes" >> $SUMMARY_LOG
echo "Total estimated time with concurrency of $CONCURRENT_JOBS jobs: $PARALLEL_EST_MINS minutes" >> $SUMMARY_LOG
echo "Total estimated time (including db2rbind, considering concurrency): $FINAL_EST_MINS minutes ($TOTAL_EST_HRS hours)" >> $SUMMARY_LOG

# Check if estimate exceeds time window
if [ -n "$TOTAL_EST_HRS" ] && [ $(awk -v hrs="$TOTAL_EST_HRS" 'BEGIN {print (hrs > 4.0) ? 1 : 0}') -eq 1 ]; then
    echo "WARNING: Estimated time exceeds 4-hour window!" >> $SUMMARY_LOG
fi

# If just estimating, exit here
if [ "$MODE" = "estimate" ]; then
    echo "Estimation completed. See log: $SUMMARY_LOG"
    db2 terminate > /dev/null 2>&1 # Terminate the main connection
    rm -f "$TABLE_LIST_FILE" # Clean up temp file
    exit 0
fi

# --- Execution Mode ---
echo "Proceeding with actual offline reorganization, runstats, and db2rbind..." >> $SUMMARY_LOG

# Validate CONCURRENT_JOBS again just before use
if ! echo "$CONCURRENT_JOBS" | grep -qE '^[1-9][0-9]*$'; then
    echo "ERROR: CONCURRENT_JOBS is invalid ('$CONCURRENT_JOBS'). Must be a positive integer. Defaulting to 1." >> $SUMMARY_LOG
    CONCURRENT_JOBS=1
fi

# Process tables in batches
echo "Processing $TABLE_COUNT tables with $CONCURRENT_JOBS concurrent jobs..." >> $SUMMARY_LOG

# Create a temporary directory to store batch files
BATCH_DIR="${LOG_DIR}/batches_${TIMESTAMP}"
mkdir -p "$BATCH_DIR"

# Distribute tables into CONCURRENT_JOBS batches for balanced processing
BATCH_NUM=0
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    
    # Append this table to its batch file
    echo "$line" >> "${BATCH_DIR}/batch_${BATCH_NUM}.txt"
    
    # Move to next batch file (round-robin)
    BATCH_NUM=$(( (BATCH_NUM + 1) % CONCURRENT_JOBS ))
done < "$TABLE_LIST_FILE"

# Process each batch in parallel
for BATCH_FILE in "${BATCH_DIR}"/batch_*.txt; do
    if [ ! -f "$BATCH_FILE" ]; then
        continue # Skip if no batch files found
    fi
    
    # Build table arguments for the batch function
    BATCH_ARGS=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        BATCH_ARGS+=("$line")
    done < "$BATCH_FILE"
    
    # Only process if we have tables in this batch
    if [ ${#BATCH_ARGS[@]} -gt 0 ]; then
        BATCH_NUM=$(basename "$BATCH_FILE" | sed 's/batch_\(.*\)\.txt/\1/')
        echo "Starting batch $BATCH_NUM with ${#BATCH_ARGS[@]} tables" >> $SUMMARY_LOG
        
        # Launch the batch processing function in background
        process_table_batch "${BATCH_ARGS[@]}" &
        echo "Launched batch $BATCH_NUM (PID: $!)" >> $SUMMARY_LOG
    fi
done

# Wait for all batch processing to complete
echo "All batches launched. Waiting for completion..." >> $SUMMARY_LOG
wait
echo "All table processing completed." >> $SUMMARY_LOG

# Perform db2rbind
echo "Starting db2rbind for all packages at $(date)" >> $SUMMARY_LOG
db2rbind "$DB_NAME" -l "$SUMMARY_LOG" -u "$DB_USER" -p "$DB_PASS" all
RBIND_STATUS=$?
if [ $RBIND_STATUS -eq 0 ]; then
    echo "db2rbind completed successfully at $(date)" >> $SUMMARY_LOG
elif [ $RBIND_STATUS -eq 4 ]; then
     echo "WARNING: db2rbind completed with warnings (Status: $RBIND_STATUS) at $(date)" >> $SUMMARY_LOG
else
    echo "ERROR: db2rbind failed with status $RBIND_STATUS at $(date)" >> $SUMMARY_LOG
fi

# Unquiesce the database
echo "Unquiescing database $DB_NAME at $(date)" >> $SUMMARY_LOG
db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1
if [ $? -eq 0 ]; then
    echo "Database $DB_NAME unquiesced successfully" >> $SUMMARY_LOG
else
    # This is a critical error - manual intervention likely needed
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> $SUMMARY_LOG
    echo "ERROR: Failed to unquiesce database $DB_NAME. MANUAL INTERVENTION REQUIRED!" >> $SUMMARY_LOG
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> $SUMMARY_LOG
fi

# Final summary
TOTAL_END_TIME=$(date +%s)
TOTAL_DURATION=$((TOTAL_END_TIME - TOTAL_START_TIME))
TOTAL_HOURS=$((TOTAL_DURATION / 3600))
TOTAL_MINUTES=$(( (TOTAL_DURATION % 3600) / 60 ))
TOTAL_SECONDS=$((TOTAL_DURATION % 60))

echo "--------------------------------------------------" >> $SUMMARY_LOG
echo "DB2 Offline Reorg/Runstats/Rbind Process Summary" >> $SUMMARY_LOG
echo "Mode: $MODE" >> $SUMMARY_LOG
echo "End Time: $(date)" >> $SUMMARY_LOG
echo "Total actual execution time: ${TOTAL_HOURS}h ${TOTAL_MINUTES}m ${TOTAL_SECONDS}s" >> $SUMMARY_LOG
echo "Total tables identified for processing: $TABLE_COUNT" >> $SUMMARY_LOG
echo "--------------------------------------------------" >> $SUMMARY_LOG

# Disconnect the main connection from the database
db2 terminate > /dev/null 2>&1

# Clean up temp files
rm -f "$TABLE_LIST_FILE"
rm -rf "$BATCH_DIR"

echo "DB2 offline reorganization, runstats, and db2rbind process completed. See log: $SUMMARY_LOG"

exit 0
