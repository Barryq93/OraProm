SELECT 
    INDSCHEMA AS INDEX_SCHEMA,
    INDNAME AS INDEX_NAME,
    TABSCHEMA AS TABLE_SCHEMA,
    TABNAME AS TABLE_NAME,
    CASE 
        WHEN IU.INDEX_SCHEMA IS NULL THEN 'NOT USED'
        ELSE 'USED'
    END AS INDEX_USAGE_STATUS,
    IU.LASTUSED AS LAST_USED_TIMESTAMP
FROM 
    SYSCAT.INDEXES I
LEFT JOIN 
    (SELECT DISTINCT INDEX_SCHEMA, INDEX_NAME, LASTUSED 
     FROM SYSCAT.INDEXUSE) IU
ON 
    I.INDSCHEMA = IU.INDEX_SCHEMA AND I.INDNAME = IU.INDEX_NAME
ORDER BY 
    INDEX_USAGE_STATUS, INDEX_SCHEMA, INDEX_NAME;