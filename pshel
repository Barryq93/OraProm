#!/bin/bash

# === CONFIGURATION ===
DB_NAME="MYDB"                          # Change this to your DB name
REORGCHK_OUTPUT="/tmp/reorgchk_output.txt"
REORG_NEEDED="/tmp/reorg_needed.txt"
LOG_DIR="/var/log/db2_reorg_logs"
TIMESTAMP=$(date "+%Y-%m-%d_%H-%M-%S")
LOG_FILE="$LOG_DIR/reorgchk_$TIMESTAMP.log"

# === CREATE LOG DIRECTORY IF NEEDED ===
mkdir -p "$LOG_DIR"

# Start logging
exec > >(tee -a "$LOG_FILE") 2>&1

# === CONNECT TO DATABASE ===
echo "[$TIMESTAMP] Connecting to database $DB_NAME..."
db2 connect to $DB_NAME > /dev/null
if [[ $? -ne 0 ]]; then
  echo "Failed to connect to $DB_NAME"
  exit 1
fi

# === RUN REORGCHK ===
echo "[$TIMESTAMP] Running REORGCHK..."
db2 -x "REORGCHK CURRENT STATISTICS ON TABLE ALL" > "$REORGCHK_OUTPUT"

# === PARSE OUTPUT FOR TABLE/INDEX WITH * ===
echo "[$TIMESTAMP] Parsing REORGCHK output..."
awk '
BEGIN {
  print "Objects that may need REORG:\n"
  capture = 0
}
/^Table:/ {
  current = $0
  capture = 1
  next
}
/^Index:/ {
  current = $0
  capture = 1
  next
}
/[*]+/ && capture == 1 {
  print current
  print $0
  print ""
  capture = 0
}
' "$REORGCHK_OUTPUT" > "$REORG_NEEDED"

# === DISPLAY REORG NEEDED ===
if [[ -s "$REORG_NEEDED" ]]; then
  echo -e "\n[$TIMESTAMP] Tables or indexes needing REORG found:\n"
  cat "$REORG_NEEDED"
else
  echo "[$TIMESTAMP] No REORG needed for any table or index."
fi

# === SUPPLEMENTAL SQL LOOKUP FROM SYSTEM CATALOGS ===
echo -e "\n[$TIMESTAMP] Running supplemental SQL for detailed object info...\n"

while IFS= read -r line; do
  if [[ "$line" =~ ^Table:\ ([^.]+)\.([^\ ]+) ]]; then
    SCHEMA="${BASH_REMATCH[1]}"
    TBLNAME="${BASH_REMATCH[2]}"
    echo "---- Details for Table: $SCHEMA.$TBLNAME ----"
    db2 -x "
      SELECT 
        TABNAME, CARD, NPAGES, FPAGES, OVERFLOW, STATSTIME
      FROM SYSCAT.TABLES 
      WHERE TABSCHEMA = UPPER('$SCHEMA') AND TABNAME = UPPER('$TBLNAME')
    "
    echo ""
  elif [[ "$line" =~ ^Index:\ ([^.]+)\.([^\ ]+) ]]; then
    SCHEMA="${BASH_REMATCH[1]}"
    IDXNAME="${BASH_REMATCH[2]}"
    echo "---- Details for Index: $SCHEMA.$IDXNAME ----"
    db2 -x "
      SELECT 
        INDNAME, UNIQUERULE, COLNAMES, FULLKEYCARD, FIRSTKEYCARD, NLEAF, NLEVELS, STATSTIME
      FROM SYSCAT.INDEXES
      WHERE INDSCHEMA = UPPER('$SCHEMA') AND INDNAME = UPPER('$IDXNAME')
    "
    echo ""
  fi
done < "$REORG_NEEDED"

# === DISCONNECT ===
db2 connect reset > /dev/null
echo "[$TIMESTAMP] Done. Log saved to: $LOG_FILE"