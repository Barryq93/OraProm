SELECT 
    d.*, 
    ds.*, 
    dt.*,
    da.documenttypeid_row1, da.documenttypeid_row2,
    da.indextypeid_row1, da.indextypeid_row2,
    da.value_row1, da.value_row2,
    da.linkid_row1, da.linkid_row2
FROM 
    document d
JOIN 
    documents ds ON d.docid = ds.documentID
JOIN 
    DocumentType dt ON dt.DocumentTypeID = d.DocumentTypeID
LEFT JOIN (
    SELECT *
    FROM (
        SELECT 
            docid,
            documenttypeid,
            indextypeid,
            value,
            linkid,
            ROW_NUMBER() OVER (PARTITION BY docid ORDER BY documenttypeid) AS rn
        FROM 
            documentattributes
    )
    PIVOT (
        MAX(documenttypeid) AS documenttypeid, 
        MAX(indextypeid) AS indextypeid, 
        MAX(value) AS value, 
        MAX(linkid) AS linkid
        FOR rn IN (1 AS row1, 2 AS row2)
    )
) da ON d.docid = da.docid;
