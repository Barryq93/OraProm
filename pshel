# Multi-Server Network Traffic Monitor
# This script runs from a central server and collects network traffic from all target servers
# It creates separate CSV files for inbound and outbound connections on each server

# List of servers to monitor
$servers = @(
    "Server1",
    "Server2",
    "Server3",
    "Server4",
    "Server5",
    "Server6",
    "Server7"
)

# Create log directory on the control server
$logDir = ".\NetworkLogs"
if (-not (Test-Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

# Script to be executed on each remote server
$remoteScript = {
    param(
        [string]$ServerName
    )
    
    Write-Output "Starting network traffic collection on $ServerName"
    
    # Function to resolve IP address to hostname
    function Resolve-HostName {
        param(
            [string]$IPAddress
        )
        
        if ($IPAddress -eq "0.0.0.0" -or $IPAddress -eq "::" -or $IPAddress -eq "127.0.0.1" -or $IPAddress -eq "::1") {
            return "localhost"
        }
        
        try {
            $result = nslookup $IPAddress 2>$null
            if ($result -match "Name:\s+(.+)") {
                return $Matches[1].Trim()
            }
            else {
                return $IPAddress
            }
        }
        catch {
            return $IPAddress
        }
    }
    
    # Get current network connections
    function Get-CurrentNetworkConnections {
        $connections = Get-NetTCPConnection | 
            Where-Object { $_.State -ne "Listen" -and $_.RemoteAddress -ne "0.0.0.0" -and $_.RemoteAddress -ne "::" } |
            Select-Object LocalAddress, LocalPort, RemoteAddress, RemotePort, OwningProcess, State
        
        $result = @()
        foreach ($conn in $connections) {
            # Skip loopback addresses
            if ($conn.RemoteAddress -eq "127.0.0.1" -or $conn.RemoteAddress -eq "::1") {
                continue
            }
            
            # Get process name
            try {
                $process = Get-Process -Id $conn.OwningProcess -ErrorAction SilentlyContinue
                $processInfo = if ($process) { $process.Name } else { "NA" }
            }
            catch {
                $processInfo = "NA"
            }
            
            # Resolve IP addresses to hostnames
            $remoteHostname = Resolve-HostName -IPAddress $conn.RemoteAddress
            $localHostname = Resolve-HostName -IPAddress $conn.LocalAddress
            
            # Create connection object
            $connObj = [PSCustomObject]@{
                LocalAddress = $localHostname
                LocalPort = $conn.LocalPort
                RemoteAddress = $remoteHostname
                RemotePort = $conn.RemotePort
                Process = $processInfo
                State = $conn.State
            }
            
            $result += $connObj
        }
        
        return $result
    }
    
    # We'll collect data for one hour
    $endTime = (Get-Date).AddHours(1)
    $inboundConnections = @{}
    $outboundConnections = @{}
    $results = @{
        ServerName = $ServerName
        Inbound = @()
        Outbound = @()
    }
    
    while ((Get-Date) -lt $endTime) {
        $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        $currentConnections = Get-CurrentNetworkConnections
        
        foreach ($conn in $currentConnections) {
            if ($conn.State -eq "Established") {
                $localEndpoint = "$($conn.LocalAddress):$($conn.LocalPort)"
                $remoteEndpoint = "$($conn.RemoteAddress):$($conn.RemotePort)"
                $processName = $conn.Process
                
                # Outbound connections
                $outboundKey = "$localEndpoint-$remoteEndpoint-$processName"
                if (-not $outboundConnections.ContainsKey($outboundKey)) {
                    $outboundConnections[$outboundKey] = $true
                    $outboundEntry = [PSCustomObject]@{
                        Timestamp = $timestamp
                        Source = $localEndpoint
                        Destination = $remoteEndpoint
                        Process = $processName
                    }
                    $results.Outbound += $outboundEntry
                }
                
                # Inbound connections
                $inboundKey = "$remoteEndpoint-$localEndpoint-$processName"
                if (-not $inboundConnections.ContainsKey($inboundKey)) {
                    $inboundConnections[$inboundKey] = $true
                    $inboundEntry = [PSCustomObject]@{
                        Timestamp = $timestamp
                        Source = $remoteEndpoint
                        Destination = $localEndpoint
                        Process = $processName
                    }
                    $results.Inbound += $inboundEntry
                }
            }
        }
        
        # Report progress
        Write-Output "$(Get-Date -Format 'HH:mm:ss') - Collected network connections on $ServerName"
        
        # Sleep for a minute
        Start-Sleep -Seconds 60
    }
    
    Write-Output "Completed network collection on $ServerName"
    return $results
}

# Main execution - Start parallel jobs for all servers
Write-Host "Starting network traffic monitoring on all servers..."
$jobs = @()

foreach ($server in $servers) {
    Write-Host "Initiating monitoring job for $server..."
    $jobs += Start-Job -ScriptBlock {
        param ($serverName, $scriptBlock)
        
        if ($serverName -eq $env:COMPUTERNAME) {
            # Local execution
            & $scriptBlock -ServerName $serverName
        }
        else {
            # Remote execution
            Invoke-Command -ComputerName $serverName -ScriptBlock $scriptBlock -ArgumentList $serverName
        }
    } -ArgumentList $server, $remoteScript
}

# Monitor job progress
$startTime = Get-Date
$endTime = $startTime.AddHours(1)
$totalJobs = $jobs.Count

Write-Host "Monitoring network traffic on all $totalJobs servers for 1 hour..."
Write-Host "Started at: $startTime"
Write-Host "Will complete at: $endTime"

while ((Get-Date) -lt $endTime -and (Get-Job -State "Running").Count -gt 0) {
    $runningJobs = (Get-Job -State "Running").Count
    $completedJobs = $totalJobs - $runningJobs
    
    Write-Host "Progress: $completedJobs of $totalJobs servers completed. $runningJobs still running."
    Start-Sleep -Seconds 60
}

# Process results and create CSV files
foreach ($job in $jobs) {
    $jobResult = Receive-Job -Job $job -Wait -AutoRemoveJob
    
    if ($jobResult) {
        $serverName = $jobResult.ServerName
        
        # Create inbound CSV
        $inboundFile = "$logDir\${serverName}_inbound.csv"
        $jobResult.Inbound | 
            Select-Object Timestamp, Source, Destination, Process | 
            Export-Csv -Path $inboundFile -NoTypeInformation
        
        # Create outbound CSV
        $outboundFile = "$logDir\${serverName}_outbound.csv"
        $jobResult.Outbound | 
            Select-Object Timestamp, Source, Destination, Process | 
            Export-Csv -Path $outboundFile -NoTypeInformation
        
        Write-Host "Created log files for $serverName"
    }
    else {
        Write-Host "No results returned from job for server"
    }
}

Write-Host "Network monitoring completed for all servers."
Write-Host "Log files are available in the $logDir directory."