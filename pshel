#!/bin/bash

# Script to check server access to a list of endpoints using curl for pure TCP connectivity.
# This checks if the network path is open and the port is listening.

# --- Configuration ---
ENDPOINT_FILE="endpoints.txt" # File containing the list of endpoints (e.g., host:port)
OUTPUT_LOG="endpoint_check_curl_tcp_$(date +%Y%m%d_%H%M%S).log" # Log file for results
TIMEOUT_SECONDS=5 # Timeout for each curl connection attempt

# --- Functions ---

log_message() {
    echo "$(date +'%Y-%m-%d %H:%M:%S') - $1" | tee -a "$OUTPUT_LOG"
}

check_endpoint() {
    local endpoint="$1"
    log_message "Checking endpoint: $endpoint"

    # Extract host and port
    local host=$(echo "$endpoint" | cut -d':' -f1)
    local port=$(echo "$endpoint" | cut -d':' -f2)

    # Validate extracted host and port
    if [ -z "$host" ] || [ -z "$port" ] || ! [[ "$port" =~ ^[0-9]+$ ]]; then
        log_message "  ERROR: Could not parse host or port from endpoint: $endpoint - Skipping."
        return 1
    fi

    # Use curl to check *only* TCP connectivity (no TLS, no HTTP)
    # -s: Silent mode.
    # -o /dev/null: Discard output.
    # --connect-timeout: Timeout for the TCP connection.
    # --max-time: Total time allowed (fallback).
    # http://: Force plain TCP connection (no TLS).
    if curl -s -o /dev/null --connect-timeout "$TIMEOUT_SECONDS" --max-time "$TIMEOUT_SECONDS" "http://$host:$port" ; then
        log_message "  SUCCESS: Endpoint $endpoint is TCP reachable."
        return 0 # Success
    else
        log_message "  FAILURE: Endpoint $endpoint is NOT TCP reachable. (Check above output for curl error)"
        return 1 # Failure
    fi
}

# --- Main Script Logic ---

# Check if the endpoint file exists
if [ ! -f "$ENDPOINT_FILE" ]; then
    log_message "Error: Endpoint file '$ENDPOINT_FILE' not found."
    log_message "Please create '$ENDPOINT_FILE' with one endpoint (host:port) per line."
    exit 1
fi

log_message "Starting endpoint accessibility check with curl (pure TCP)..."
log_message "Reading endpoints from: $ENDPOINT_FILE"
log_message "Results will be logged to: $OUTPUT_LOG"
log_message "Connection timeout set to: $TIMEOUT_SECONDS seconds"
log_message "----------------------------------------------------"

SUCCESS_COUNT=0
FAILURE_COUNT=0

# Read endpoints from the file, line by line
while IFS= read -r endpoint || [[ -n "$endpoint" ]]; do
    # Skip empty lines and comments
    if [[ -z "$endpoint" || "$endpoint" =~ ^# ]]; then
        continue
    fi

    # Remove leading/trailing whitespace
    endpoint=$(echo "$endpoint" | xargs)

    # Basic host:port format validation (more strict now)
    if ! echo "$endpoint" | grep -qE '^[^:]+:[0-9]+$'; then
        log_message "  WARNING: Invalid endpoint format (expected host:port): $endpoint - Skipping."
        continue
    fi

    check_endpoint "$endpoint"
    if [ $? -eq 0 ]; then
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        FAILURE_COUNT=$((FAILURE_COUNT + 1))
    fi
    echo "" # Add a blank line for readability between checks
done < "$ENDPOINT_FILE"

log_message "----------------------------------------------------"
log_message "Endpoint check complete."
log_message "Total Endpoints Checked: $((SUCCESS_COUNT + FAILURE_COUNT))"
log_message "Successfully Reachable (TCP): $SUCCESS_COUNT"
log_message "Failed Reachability (TCP):    $FAILURE_COUNT"

if [ "$FAILURE_COUNT" -gt 0 ]; then
    log_message "Some endpoints were not TCP reachable. Please check the log file '$OUTPUT_LOG' for details."
    exit 1 # Exit with a non-zero status to indicate failures
else
    log_message "All endpoints are TCP reachable."
    exit 0 # Exit with zero status for success
fi
