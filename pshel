# Get input from the user
$csvFile = Read-Host "Enter the path to the CSV file:"
$groupName = Read-Host "Enter the group name:"

# Read the CSV file (assuming the column header is UserID)
$users = Import-Csv -Path $csvFile

# Create empty arrays to store users
$usersNotInGroup = @()
$usersNotFound = @()

foreach ($user in $users) {
    # Get the UserID value
    $userID = $user.UserID

    # Check if the user exists using net user
    $userCheck = & net user "$userID" /domain 2>&1

    if ($LASTEXITCODE -ne 0) {
        # User not found, add to usersNotFound list
        Write-Warning "The user $userID could not be found."
        $usersNotFound += [PSCustomObject]@{
            UserID = $userID
        }
    } else {
        # Check if the specified group is in the net user output
        if ($userCheck -match "\b$groupName\b") {
            Write-Host "User $userID is a member of group $groupName."
        } else {
            Write-Host "User $userID is not a member of group $groupName."
            $usersNotInGroup += [PSCustomObject]@{
                UserID    = $userID
                GroupName = $groupName
            }
        }
    }
}

# Export users not in the group to a new CSV file
if ($usersNotInGroup) {
    $outputFile = "UsersNotInGroup_$groupName.csv"
    $usersNotInGroup | Export-Csv -Path $outputFile -NoTypeInformation -Force
    Write-Host "Users not in group $groupName exported to $outputFile."
} else {
    Write-Host "All users in the CSV file are already members of group $groupName."
}

# Export users not found to a new CSV file
if ($usersNotFound) {
    $outputFile = "UsersNotFound.csv"
    $usersNotFound | Export-Csv -Path $outputFile -NoTypeInformation -Force
    Write-Host "Users not found exported to $outputFile."
} else {
    Write-Host "All users in the CSV file were found."
}