#!/bin/bash

# Check if an input file is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <input_file>"
  exit 1
fi

input_file="$1"

# Check if the input file exists
if [ ! -f "$input_file" ]; then
  echo "Error: Input file '$input_file' not found."
  exit 1
fi

# Function to check TCP connection using /dev/tcp
check_tcp_connection_bash() {
  local host="$1"
  local port="$2"

  if timeout 2 bash -c "cat < /dev/tcp/$host/$port > /dev/null 2>&1"; then
    return 0 # Connected
  else
    return 1 # Not connected
  fi
}

# Read each line from the input file
while IFS= read -r line; do
  # Use regex to extract host and port
  if [[ "$line" =~ ^([^:]+):([0-9]+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"

    if check_tcp_connection_bash "$host" "$port"; then
      echo "Connected: $host:$port (TCP - Bash)"
    else
      echo "Not Connected: $host:$port (TCP - Bash)"
    fi
  else
    echo "Invalid format: $line (Expected format: host:port)"
  fi
done < "$input_file"

exit 0
