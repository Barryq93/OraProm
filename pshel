#!/bin/bash

# Function to check HADR status
checkHADR() {
    # Query the HADR status of the DB2 instance
    HADR_STATUS=$(db2pd -hadr -db your_database_name | grep "HADR_ROLE" | awk '{print $3}')
    
    # Check if the instance is primary
    if [[ "$HADR_STATUS" == "Primary" ]]; then
        return 0  # true (Primary)
    else
        return 1  # false (Standby)
    fi
}

# Function to start the DB2 instance
startDB2() {
    echo "Starting DB2 instance..."
    ./startDb2.sh
    
    # Check HADR status
    if checkHADR; then
        echo "HADR status: Primary"
        
        # Node-specific actions for node1 (alvp)
        if [[ "$(hostname)" == *"alvp"* ]]; then
            echo "Current node is node1 (alvp). Executing takeoverHADR.sh..."
            ./takeoverHADR.sh
        fi
    else
        echo "HADR status: Standby"
    fi
    
    # Secondary actions
    echo "Stopping db2ts on node2 (omvp)..."
    ssh omvp ./db2ts_stop.sh
    
    echo "Executing DB2Token.sh on node1 (alvp)..."
    ./DB2Token.sh
}

# Function to stop the DB2 instance
stopDB2() {
    # Check HADR status
    if checkHADR; then
        echo "HADR status: Primary"
        
        # Execute takeoverHADR.sh on node2 (omvp)
        echo "Executing takeoverHADR.sh on node2 (omvp)..."
        ssh omvp ./takeoverHADR.sh
        
        # Shutdown DB2 on current node
        echo "Shutting down DB2 on current node..."
        ./shutdownDb2.sh
    else
        echo "HADR status: Standby"
        
        # Shutdown DB2 on current node
        echo "Shutting down DB2 on current node..."
        ./shutdownDb2.sh
    fi
    
    # Secondary actions
    echo "Stopping db2ts on current node..."
    ./db2ts_stop.sh
    
    echo "Executing DB2Token.sh on node2 (omvp)..."
    ssh omvp ./DB2Token.sh
}

# Main script logic
if [[ $# -ne 1 ]]; then
    echo "Usage: $0 {start|stop}"
    exit 1
fi

ACTION=$1

case $ACTION in
    start)
        startDB2
        ;;
    stop)
        stopDB2
        ;;
    *)
        echo "Invalid argument. Usage: $0 {start|stop}"
        exit 1
        ;;
esac

# Error handling
if [[ $? -ne 0 ]]; then
    echo "An error occurred during execution."
    exit 1
fi

echo "Operation completed successfully."
exit 0
