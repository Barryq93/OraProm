#!/bin/bash
# =============================================================================
# db2_dba_checker.sh  (SAFE + SLOW + DEBUGGABLE MODE)
#
# Execution model (safe/slow):
#   - Parse checklist markdown (BASH-ONLY parser: resilient under set -euo pipefail)
#   - For each AUTO check:
#       * generate a tiny SQL file with @ terminators:
#           CONNECT ...@
#           SELECT 'ID|' || ...@
#           CONNECT RESET@
#           TERMINATE@
#       * run: db2 -td@ -v -f file.sql
#       * append the single "ID|VALUE" line to a results tmp file
#       * write full SQL file + stdout/stderr into the report for debugging
#
# Notes:
#   - Uses CHAR()/CAST(), not VARCHAR(...) (VARCHAR is a type, not a function).
#   - Uses monitor function columns:
#       MON_GET_HADR: HADR_STATE, HADR_SYNCMODE, HADR_CONNECT_STATUS, HADR_LOG_GAP, PEER_WINDOW
#       MON_GET_TRANSACTION_LOG: TOTAL_LOG_USED, TOTAL_LOG_AVAILABLE, SEC_LOGS_ALLOCATED
#   - Output evaluation is driven by the checklist "Expected" field, with
#     per-check DBA logic where Expected is tokenized (e.g., <500MB, CONFIGURED).
#
# Usage:
#   ./db2_dba_checker.sh -d <DBNAME> -s <SCHEMA> [-c <checklist>] [-o <report>] [-u <user>] [-p <pass>]
# =============================================================================

set -euo pipefail
umask 077

# =============================================================================
# Defaults for candidate checks
# =============================================================================
DEFAULT_CLUSTERRATIO=80
DEFAULT_NLEVELS=4
DEFAULT_UNUSED_DAYS=90
DEFAULT_FREE_PCT=20

# =============================================================================
# Colours
# =============================================================================
if [ -t 1 ]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
  CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; CYAN=''; BOLD=''; RESET=''
fi

# =============================================================================
# Globals
# =============================================================================
DB_NAME=""
DB_SCHEMA=""
DB_USER=""
DB_PASS=""
CHECKLIST_FILE="db2_dba_checklist.md"
REPORT_FILE="db2_health_$(date +%Y%m%d_%H%M%S).txt"

TMP_RESULTS=""
TMP_PARSED=""

PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0

# Checklist metadata
declare -A CHECK_TYPE CHECK_RISK CHECK_DESC CHECK_EXPECTED CHECK_SECTION
AUTO_ORDER=()
MANUAL_ORDER=()

# Runtime values/results
declare -A CHECK_VALUE CHECK_RESULT

# =============================================================================
# Cleanup
# =============================================================================
cleanup() {
  [ -n "${TMP_RESULTS:-}" ] && rm -f "$TMP_RESULTS"
  [ -n "${TMP_PARSED:-}" ] && rm -f "$TMP_PARSED"
}
trap cleanup EXIT

# =============================================================================
# Helpers
# =============================================================================
usage() {
  cat <<EOF
Usage: $0 -d <DBNAME> -s <SCHEMA> [-c <checklist>] [-o <report>] [-u <user>] [-p <pass>]

  -d  Database name           (required)
  -s  Schema name             (required)
  -c  Checklist .md file      (default: db2_dba_checklist.md)
  -o  Output report file      (default: db2_health_<timestamp>.txt)
  -u  DB2 username            (optional)
  -p  DB2 password            (optional — prompts securely if -u set without -p)
  -h  Show this help
EOF
  exit 1
}

log()      { echo -e "$*"; echo -e "$*" >> "$REPORT_FILE"; }
header()   { log "${BOLD}${CYAN}$*${RESET}"; }
pass()     { log "  ${GREEN}[PASS]${RESET} $*"; }
fail()     { log "  ${RED}[FAIL]${RESET} $*"; }
warn()     { log "  ${YELLOW}[WARN]${RESET} $*"; }
manual()   { log "  ${CYAN}[MANUAL]${RESET} $*"; }
skip()     { log "  [SKIP] $*"; }

record() {
  local id="$1" status="$2" value="$3" msg="$4"
  CHECK_RESULT["$id"]="$status"
  CHECK_VALUE["$id"]="$value"
  case "$status" in
    PASS) pass "${id}: ${msg} [${value}]"; ((PASS_COUNT++)) ;;
    WARN) warn "${id}: ${msg} [${value}]"; ((WARN_COUNT++)) ;;
    FAIL) fail "${id}: ${msg} [${value}]"; ((FAIL_COUNT++)) ;;
    SKIP) skip "${id}: ${msg}"; ((SKIP_COUNT++)) ;;
  esac
}

trim() {
  # bash-only trim (no external commands)
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

expected_number() {
  # Extract first numeric token (bash-only-ish: uses pattern scanning)
  # Falls back to empty if none.
  local s="$1"
  if [[ "$s" =~ ([0-9]+([.][0-9]+)?) ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo ""
  fi
}

# =============================================================================
# Arg parsing
# =============================================================================
while getopts ":d:s:c:o:u:p:h" opt; do
  case $opt in
    d) DB_NAME="$OPTARG" ;;
    s) DB_SCHEMA="$OPTARG" ;;
    c) CHECKLIST_FILE="$OPTARG" ;;
    o) REPORT_FILE="$OPTARG" ;;
    u) DB_USER="$OPTARG" ;;
    p) DB_PASS="$OPTARG" ;;
    h) usage ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage ;;
    \?) echo "Unknown option: -$OPTARG" >&2; usage ;;
  esac
done

[ -z "$DB_NAME" ]   && { echo "ERROR: -d <DBNAME> is required." >&2; usage; }
[ -z "$DB_SCHEMA" ] && { echo "ERROR: -s <SCHEMA> is required." >&2; usage; }
[ ! -f "$CHECKLIST_FILE" ] && { echo "ERROR: Checklist file not found: $CHECKLIST_FILE" >&2; exit 1; }

if [ -n "$DB_USER" ] && [ -z "$DB_PASS" ]; then
  read -rsp "DB2 password for ${DB_USER}@${DB_NAME}: " DB_PASS
  echo
fi

# =============================================================================
# Checklist parser (BASH-ONLY: safe under set -euo pipefail)
# =============================================================================
parse_checklist() {
  local current_section=""
  AUTO_ORDER=()
  MANUAL_ORDER=()

  local lineno=0
  while IFS= read -r line; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"

    # Section headings
    if [[ "$line" =~ ^##[[:space:]]SECTION:[[:space:]](.+)$ ]]; then
      current_section="${BASH_REMATCH[1]}"
      continue
    fi

    # Only consider checklist rows
    [[ "$line" == "[AUTO]"* || "$line" == "[MANUAL]"* ]] || continue

    # Count pipes safely in bash
    local pipe_count=$(( ${#line} - ${#line//|/} ))
    if (( pipe_count < 3 )); then
      {
        echo ""
        echo "CHECKLIST PARSE WARNING: line ${lineno} has <3 pipes"
        echo ">> ${line}"
      } >>"$REPORT_FILE"
      continue
    fi

    # Split first 3 pipes; keep remainder as expected
    local left risk desc expected tmp
    IFS='|' read -r left risk desc expected <<<"$line"
    if (( pipe_count > 3 )); then
      tmp="${line#*|}"   # remove left|
      tmp="${tmp#*|}"    # remove risk|
      tmp="${tmp#*|}"    # remove desc|
      expected="$tmp"
    fi

    left="$(trim "$left")"
    risk="$(trim "$risk")"
    desc="$(trim "$desc")"
    expected="$(trim "$expected")"

    # Extract TYPE and ID from left
    local type id
    type="${left#\[}"
    type="${type%%\]*}"
    type="${type^^}"

    if [[ "$left" =~ ([A-Z]+[0-9]+) ]]; then
      id="${BASH_REMATCH[1]}"
      id="${id^^}"
    else
      {
        echo ""
        echo "CHECKLIST PARSE WARNING: line ${lineno} missing CHECK_ID"
        echo ">> ${line}"
      } >>"$REPORT_FILE"
      continue
    fi

    risk="${risk^^}"

    # Validate
    if [[ "$type" != "AUTO" && "$type" != "MANUAL" ]]; then
      {
        echo ""
        echo "CHECKLIST PARSE WARNING: line ${lineno} invalid type '${type}'"
        echo ">> ${line}"
      } >>"$REPORT_FILE"
      continue
    fi
    if [[ "$risk" != "HIGH" && "$risk" != "MEDIUM" && "$risk" != "LOW" ]]; then
      {
        echo ""
        echo "CHECKLIST PARSE WARNING: line ${lineno} invalid risk '${risk}'"
        echo ">> ${line}"
      } >>"$REPORT_FILE"
      continue
    fi
    if [[ -z "$desc" || -z "$expected" ]]; then
      {
        echo ""
        echo "CHECKLIST PARSE WARNING: line ${lineno} missing desc/expected"
        echo ">> ${line}"
      } >>"$REPORT_FILE"
      continue
    fi

    CHECK_TYPE["$id"]="$type"
    CHECK_RISK["$id"]="$risk"
    CHECK_DESC["$id"]="$desc"
    CHECK_EXPECTED["$id"]="$expected"
    CHECK_SECTION["$id"]="$current_section"

    if [[ "$type" == "AUTO" ]]; then
      AUTO_ORDER+=("$id")
    else
      MANUAL_ORDER+=("$id")
    fi
  done < "$CHECKLIST_FILE"

  if [ "${#AUTO_ORDER[@]}" -eq 0 ]; then
    echo "ERROR: No [AUTO] checks parsed. See report for warnings: $REPORT_FILE" >&2
    exit 1
  fi
}

# =============================================================================
# DB2 preflight (file mode, @ terminator)
# =============================================================================
preflight_db2() {
  header "Preflight: DB2 environment and connectivity"

  if ! command -v db2 >/dev/null 2>&1; then
    fail "db2 not found in PATH. Source db2profile before running."
    exit 1
  fi

  {
    echo "---- db2level ----"
    db2level || true
    echo "---- DB2INSTANCE ----"
    echo "DB2INSTANCE=${DB2INSTANCE:-<unset>}"
  } >>"$REPORT_FILE" 2>&1

  local probe out
  probe="$(mktemp /tmp/db2_probe_XXXXXX.sql)"

  if [ -n "$DB_USER" ]; then
    cat >"$probe" <<SQL
CONNECT TO ${DB_NAME} USER ${DB_USER} USING ${DB_PASS}@
VALUES 1@
CONNECT RESET@
TERMINATE@
SQL
  else
    cat >"$probe" <<SQL
CONNECT TO ${DB_NAME}@
VALUES 1@
CONNECT RESET@
TERMINATE@
SQL
  fi

  out="$(db2 -td@ -v -f "$probe" 2>>"$REPORT_FILE" || true)"
  rm -f "$probe"

  # Check "1" appears on its own trimmed line
  local ok="NO"
  while IFS= read -r ln; do
    ln="$(trim "$ln")"
    if [ "$ln" = "1" ]; then ok="YES"; break; fi
  done <<<"$out"

  if [ "$ok" != "YES" ]; then
    fail "Preflight failed (CONNECT/VALUES 1). Check report for DB2 errors."
    {
      echo "---- Preflight stdout ----"
      echo "$out"
    } >>"$REPORT_FILE"
    exit 1
  fi

  pass "DB2 CLI can connect to ${DB_NAME}"
}

# =============================================================================
# SQL per check (each returns one row: ID|VALUE). Statements MUST end with @
# =============================================================================
sql_for_check() {
  local id="$1"
  case "$id" in
    LOG001) echo "SELECT 'LOG001|' || RTRIM(CHAR(MAX(VALUE))) FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGFILSIZ'@" ;;
    LOG002) echo "SELECT 'LOG002|' || RTRIM(CHAR(MAX(VALUE))) FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGPRIMARY'@" ;;
    LOG003) echo "SELECT 'LOG003|' || RTRIM(CHAR(MAX(VALUE))) FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGSECOND'@" ;;
    LOG004) echo "SELECT 'LOG004|' || RTRIM(CHAR(MAX(VALUE))) FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGBUFSZ'@" ;;
    LOG005) echo "SELECT 'LOG005|' || COALESCE(UPPER(RTRIM(CHAR(MAX(VALUE)))), 'NULL') FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGARCHCOMPR1'@" ;;
    LOG006) echo "SELECT 'LOG006|' || CASE WHEN MAX(VALUE) IS NULL OR RTRIM(CHAR(MAX(VALUE)))='' OR UPPER(RTRIM(CHAR(MAX(VALUE))))='LOGRETAIN' THEN 'NOT_CONFIGURED' ELSE 'CONFIGURED' END FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGARCHMETH1'@" ;;
    LOG007) echo "SELECT 'LOG007|' || CASE WHEN MAX(VALUE) IS NULL OR RTRIM(CHAR(MAX(VALUE)))='' OR UPPER(RTRIM(CHAR(MAX(VALUE))))='OFF' THEN 'NOT_CONFIGURED' ELSE 'CONFIGURED' END FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGARCHMETH2'@" ;;

    REC001) echo "SELECT 'REC001|' || COALESCE(UPPER(RTRIM(CHAR(MAX(VALUE)))), 'NULL') FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='AUTO_DEL_REC_OBJ'@" ;;
    REC002) echo "SELECT 'REC002|' || RTRIM(CHAR(MAX(VALUE))) FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='REC_HIS_RETENTN'@" ;;
    REC003) echo "SELECT 'REC003|' || RTRIM(CHAR(MAX(VALUE))) FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='NUM_DB_BACKUPS'@" ;;
    REC004) echo "SELECT 'REC004|' || CASE WHEN COUNT(*)>0 THEN 'PRESENT' ELSE 'ABSENT' END FROM SYSIBMADM.DB_HISTORY WHERE OPERATION='B' AND OPERATIONTYPE='F' AND TIMESTAMP_FORMAT(START_TIME,'YYYYMMDDHH24MISS') >= (CURRENT TIMESTAMP - 7 DAYS)@" ;;
    REC005) echo "SELECT 'REC005|' || CASE WHEN COUNT(*)=0 THEN 'NONE' ELSE RTRIM(CHAR(COUNT(*))) || '_FAILURES' END FROM SYSIBMADM.DB_HISTORY WHERE OPERATION='B' AND SQLCODE < 0 AND TIMESTAMP_FORMAT(START_TIME,'YYYYMMDDHH24MISS') >= (CURRENT TIMESTAMP - 7 DAYS)@" ;;

    HADR001) echo "SELECT 'HADR001|' || UPPER(RTRIM(CHAR(HADR_STATE))) FROM TABLE(SYSPROC.MON_GET_HADR(NULL)) FETCH FIRST 1 ROW ONLY@" ;;
    HADR002) echo "SELECT 'HADR002|' || UPPER(RTRIM(CHAR(HADR_SYNCMODE))) FROM TABLE(SYSPROC.MON_GET_HADR(NULL)) FETCH FIRST 1 ROW ONLY@" ;;
    HADR003) echo "SELECT 'HADR003|' || UPPER(RTRIM(CHAR(HADR_CONNECT_STATUS))) FROM TABLE(SYSPROC.MON_GET_HADR(NULL)) FETCH FIRST 1 ROW ONLY@" ;;
    HADR004) echo "SELECT 'HADR004|' || RTRIM(CHAR(DECIMAL(HADR_LOG_GAP/1048576.0,10,2))) FROM TABLE(SYSPROC.MON_GET_HADR(NULL)) FETCH FIRST 1 ROW ONLY@" ;;
    HADR005) echo "SELECT 'HADR005|' || CASE WHEN PEER_WINDOW IS NOT NULL AND PEER_WINDOW > 0 THEN 'SET' ELSE 'NOT_SET' END FROM TABLE(SYSPROC.MON_GET_HADR(NULL)) FETCH FIRST 1 ROW ONLY@" ;;

    ARC001) echo "SELECT 'ARC001|' || CASE WHEN UPPER(RTRIM(CHAR(MAX(VALUE)))) LIKE 'S3%' THEN 'S3' ELSE COALESCE(RTRIM(CHAR(MAX(VALUE))), 'NULL') END FROM SYSIBMADM.DBCFG WHERE UPPER(NAME)='LOGARCHMETH1'@" ;;

    REO001) echo "SELECT 'REO001|' || RTRIM(CHAR(DECIMAL((DOUBLE(TOTAL_LOG_USED)*100.0)/NULLIF(DOUBLE(TOTAL_LOG_USED+TOTAL_LOG_AVAILABLE),0),5,1))) FROM TABLE(SYSPROC.MON_GET_TRANSACTION_LOG(-1)) FETCH FIRST 1 ROW ONLY@" ;;
    REO002) echo "SELECT 'REO002|' || UPPER(RTRIM(CHAR(HADR_STATE))) FROM TABLE(SYSPROC.MON_GET_HADR(NULL)) FETCH FIRST 1 ROW ONLY@" ;;
    REO003) echo "SELECT 'REO003|' || RTRIM(CHAR(SEC_LOGS_ALLOCATED)) FROM TABLE(SYSPROC.MON_GET_TRANSACTION_LOG(-1)) FETCH FIRST 1 ROW ONLY@" ;;
    REO004) echo "SELECT 'REO004|' || RTRIM(CHAR(COUNT(*))) FROM SYSCAT.INDEXES WHERE UPPER(TABSCHEMA)=UPPER('${DB_SCHEMA}') AND CLUSTERRATIO IS NOT NULL AND CLUSTERRATIO>=0 AND CLUSTERRATIO<${DEFAULT_CLUSTERRATIO} AND UNIQUERULE<>'P'@" ;;
    REO005) echo "SELECT 'REO005|' || RTRIM(CHAR(COUNT(*))) FROM SYSCAT.INDEXES WHERE UPPER(TABSCHEMA)=UPPER('${DB_SCHEMA}') AND NLEVELS IS NOT NULL AND NLEVELS>=0 AND NLEVELS>${DEFAULT_NLEVELS}@" ;;
    REO006) echo "SELECT 'REO006|' || RTRIM(CHAR(COUNT(*))) FROM SYSCAT.INDEXES WHERE UPPER(TABSCHEMA)=UPPER('${DB_SCHEMA}') AND LASTUSED<>DATE('0001-01-01') AND LASTUSED < CURRENT DATE - ${DEFAULT_UNUSED_DAYS} DAYS@" ;;
    REO007) echo "SELECT 'REO007|' || RTRIM(CHAR(COUNT(*))) FROM SYSCAT.TABLES WHERE UPPER(TABSCHEMA)=UPPER('${DB_SCHEMA}') AND TYPE='T' AND NPAGES>0 AND DECIMAL((DOUBLE(FPAGES)/DOUBLE(NPAGES))*100,5,2) > ${DEFAULT_FREE_PCT}@" ;;

    IDX001) echo "SELECT 'IDX001|' || CASE WHEN SUM(I.NLEAF)>0 AND SUM(T.NPAGES)>0 THEN RTRIM(CHAR(DECIMAL(DOUBLE(SUM(I.NLEAF))/DOUBLE(SUM(T.NPAGES)),6,2))) ELSE 'NO_DATA' END FROM SYSCAT.TABLES T JOIN SYSCAT.INDEXES I ON T.TABNAME=I.TABNAME AND T.TABSCHEMA=I.TABSCHEMA WHERE UPPER(T.TABSCHEMA)=UPPER('${DB_SCHEMA}') AND T.TYPE='T'@" ;;
    IDX002) echo "SELECT 'IDX002|' || RTRIM(CHAR(COUNT(*))) FROM SYSCAT.INDEXES WHERE UPPER(TABSCHEMA)=UPPER('${DB_SCHEMA}') AND LASTUSED<>DATE('0001-01-01') AND LASTUSED < CURRENT DATE - ${DEFAULT_UNUSED_DAYS} DAYS@" ;;
    IDX003) echo "SELECT 'IDX003|' || RTRIM(CHAR(COUNT(*))) FROM SYSCAT.INDEXES WHERE UPPER(TABSCHEMA)=UPPER('${DB_SCHEMA}') AND NLEVELS IS NOT NULL AND NLEVELS>=0 AND NLEVELS>${DEFAULT_NLEVELS}@" ;;

    *) echo "" ;;
  esac
}

# =============================================================================
# Execute one check via file mode (-td@ -v -f)
# =============================================================================
run_one_check_filemode() {
  local id="$1"
  local select_stmt="$2"   # includes trailing @

  local qf out
  qf="$(mktemp /tmp/db2_check_${id}_XXXXXX.sql)"

  if [ -n "$DB_USER" ]; then
    cat >"$qf" <<SQL
CONNECT TO ${DB_NAME} USER ${DB_USER} USING ${DB_PASS}@
${select_stmt}
CONNECT RESET@
TERMINATE@
SQL
  else
    cat >"$qf" <<SQL
CONNECT TO ${DB_NAME}@
${select_stmt}
CONNECT RESET@
TERMINATE@
SQL
  fi

  {
    echo ""
    echo "==================== ${id} ===================="
    echo "SQL file: ${qf}"
    echo "------------------------------------------------"
    cat "$qf"
    echo "------------------------------------------------"
  } >>"$REPORT_FILE"

  out="$(db2 -td@ -v -f "$qf" 2>>"$REPORT_FILE" || true)"
  rm -f "$qf"

  {
    echo "---- STDOUT (${id}) ----"
    echo "$out"
  } >>"$REPORT_FILE"

  # Extract only ID|VALUE lines (trim each line)
  while IFS= read -r ln; do
    ln="$(trim "$ln")"
    [[ "$ln" == "${id}|"* ]] && echo "$ln" >>"$TMP_RESULTS"
  done <<<"$out"
}

# =============================================================================
# Run all AUTO checks
# =============================================================================
run_all_auto_checks() {
  header "Running AUTO checks (SAFE/SLOW/DEBUG: one db2 file per check)..."

  TMP_RESULTS="$(mktemp /tmp/db2_checker_XXXXXX.results)"
  TMP_PARSED="$(mktemp /tmp/db2_checker_XXXXXX.parsed)"
  : >"$TMP_RESULTS"

  local id sel
  for id in "${AUTO_ORDER[@]}"; do
    sel="$(sql_for_check "$id")"
    if [ -z "$sel" ]; then
      echo "${id}|NO_SQL_DEFINED" >>"$TMP_RESULTS"
      continue
    fi
    run_one_check_filemode "$id" "$sel"
  done

  # Normalize parsed lines: first value wins per ID
  : >"$TMP_PARSED"
  while IFS= read -r ln; do
    ln="$(trim "$ln")"
    [[ "$ln" =~ ^[A-Z][A-Z0-9]*[0-9]\| ]] || continue
    echo "$ln" >>"$TMP_PARSED"
  done <"$TMP_RESULTS"

  while IFS='|' read -r id rest; do
    id="${id^^}"
    rest="$(trim "$rest")"
    if [ -z "${CHECK_VALUE[$id]:-}" ]; then
      CHECK_VALUE["$id"]="$rest"
    fi
  done <"$TMP_PARSED"
}

get_value() { local id="$1"; echo "${CHECK_VALUE[$id]:-NO_RESULT}"; }

# =============================================================================
# Evaluate results against checklist Expected
# =============================================================================
evaluate_auto_checks() {
  local last_section="" id desc exp val

  for id in "${AUTO_ORDER[@]}"; do
    desc="${CHECK_DESC[$id]}"
    exp="${CHECK_EXPECTED[$id]}"
    val="$(get_value "$id")"

    if [ "${CHECK_SECTION[$id]}" != "$last_section" ]; then
      last_section="${CHECK_SECTION[$id]}"
      header "\n=== ${last_section} ==="
    fi

    if [ "$val" = "NO_RESULT" ] || [ "$val" = "NO_SQL_DEFINED" ]; then
      record "$id" FAIL "$val" "$desc"
      continue
    fi

    case "$id" in
      LOG001)
        if [ "$val" -eq "$exp" ] 2>/dev/null; then record "$id" PASS "$val" "$desc"
        else record "$id" FAIL "$val" "$desc (expected ${exp})"; fi
        ;;
      LOG002|LOG003|LOG004|REC002|REC003)
        if [ "$val" -ge "$exp" ] 2>/dev/null; then record "$id" PASS "$val" "$desc"
        else
          if [ "${CHECK_RISK[$id]}" = "HIGH" ]; then record "$id" FAIL "$val" "$desc (expected >=${exp})"
          else record "$id" WARN "$val" "$desc (expected >=${exp})"; fi
        fi
        ;;
      LOG005|REC001|REC004|REC005|HADR001|HADR002|HADR003|REO002)
        if [ "${val^^}" = "${exp^^}" ]; then record "$id" PASS "$val" "$desc"
        else record "$id" FAIL "$val" "$desc (expected ${exp})"; fi
        ;;
      LOG006|LOG007)
        if [ "${val^^}" = "${exp^^}" ]; then record "$id" PASS "$val" "$desc"
        else
          if [ "${CHECK_RISK[$id]}" = "HIGH" ]; then record "$id" FAIL "$val" "$desc (expected ${exp})"
          else record "$id" WARN "$val" "$desc (expected ${exp})"; fi
        fi
        ;;
      ARC001)
        if [ "${val^^}" = "${exp^^}" ]; then record "$id" PASS "$val" "$desc"
        else record "$id" WARN "$val" "$desc (expected ${exp})"; fi
        ;;
      HADR004)
        local t; t="$(expected_number "$exp")"
        if [ -z "$t" ]; then record "$id" WARN "$val" "$desc (could not parse expected ${exp})"
        else
          local ok; ok=$(awk -v gap="$val" -v thr="$t" 'BEGIN{print (gap+0 < thr+0)?"YES":"NO"}')
          if [ "$ok" = "YES" ]; then record "$id" PASS "${val}MB" "$desc (expected ${exp})"
          else record "$id" WARN "${val}MB" "$desc (expected ${exp})"; fi
        fi
        ;;
      HADR005)
        if [ "${val^^}" = "SET" ]; then record "$id" PASS "$val" "$desc (validated via PEER_WINDOW>0)"
        else record "$id" WARN "$val" "$desc (expected SET)"; fi
        ;;
      REO001)
        local t; t="$(expected_number "$exp")"
        if [ -z "$t" ]; then record "$id" WARN "$val" "$desc (could not parse expected ${exp})"
        else
          local ok; ok=$(awk -v util="$val" -v thr="$t" 'BEGIN{print (util+0 < thr+0)?"YES":"NO"}')
          if [ "$ok" = "YES" ]; then record "$id" PASS "${val}%" "$desc (expected ${exp})"
          else record "$id" WARN "${val}%" "$desc (expected ${exp})"; fi
        fi
        ;;
      REO003)
        if [ "$val" -eq 0 ] 2>/dev/null; then record "$id" PASS "$val" "$desc"
        else record "$id" WARN "$val" "$desc (expected 0)"; fi
        ;;
      REO004|REO005|REO006|REO007|IDX002|IDX003)
        if [ "$val" -eq 0 ] 2>/dev/null; then record "$id" PASS "0" "$desc (none)"
        else record "$id" WARN "$val" "$desc"; fi
        ;;
      IDX001)
        if [ "${val^^}" = "NO_DATA" ]; then record "$id" SKIP "$val" "$desc (no stats / no data)"
        else
          local wr; wr=$(awk -v r="$val" 'BEGIN{print (r+0 > 2.0)?"YES":"NO"}' 2>/dev/null || echo "NO")
          if [ "$wr" = "YES" ]; then record "$id" WARN "${val}:1" "$desc (high ratio)"
          else record "$id" PASS "${val}:1" "$desc"; fi
        fi
        ;;
      *)
        record "$id" SKIP "$val" "$desc (no evaluator rule)"
        ;;
    esac
  done
}

print_manual_items() {
  header "\n=== MANUAL CHECKS — DBA ACTION REQUIRED ==="
  log "The following items cannot be verified automatically and require DBA review:\n"
  local id
  for id in "${MANUAL_ORDER[@]}"; do
    manual "[ ] ${id} [${CHECK_RISK[$id]}] — ${CHECK_DESC[$id]} (Expected: ${CHECK_EXPECTED[$id]})"
  done
}

print_summary() {
  local total=$((PASS_COUNT + WARN_COUNT + FAIL_COUNT + SKIP_COUNT))

  log "\n${BOLD}================================================================="
  log " DB2 DBA HEALTH CHECK SUMMARY"
  log "=================================================================${RESET}"
  log " Database  : ${DB_NAME}"
  log " Schema    : ${DB_SCHEMA}"
  log " Run at    : $(date)"
  log " Checklist : ${CHECKLIST_FILE}"
  log " Report    : ${REPORT_FILE}"
  log "-----------------------------------------------------------------"
  log " ${GREEN}PASS${RESET}  : ${PASS_COUNT} / ${total}"
  log " ${YELLOW}WARN${RESET}  : ${WARN_COUNT} / ${total}"
  log " ${RED}FAIL${RESET}  : ${FAIL_COUNT} / ${total}"
  log " SKIP       : ${SKIP_COUNT} / ${total}"
  log "================================================================="

  if [ "$FAIL_COUNT" -gt 0 ]; then
    log "\n${RED}${BOLD}ACTION REQUIRED: ${FAIL_COUNT} critical check(s) failed.${RESET}"
  fi
  if [ "$WARN_COUNT" -gt 0 ]; then
    log "${YELLOW}ATTENTION: ${WARN_COUNT} warning(s) require DBA review.${RESET}"
  fi
  if [ "$FAIL_COUNT" -eq 0 ] && [ "$WARN_COUNT" -eq 0 ]; then
    log "${GREEN}${BOLD}All automated checks passed.${RESET}"
  fi

  log "\n${CYAN}Review manual checklist items above before any REORG or maintenance activity.${RESET}"
}

# =============================================================================
# Main
# =============================================================================
main() {
  {
    echo "================================================================="
    echo " DB2 DBA HEALTH CHECKER (SAFE/SLOW/DEBUG FILE MODE)"
    echo " Database : ${DB_NAME} | Schema: ${DB_SCHEMA}"
    echo " Run at   : $(date)"
    echo " Checklist: ${CHECKLIST_FILE}"
    echo "================================================================="
    echo ""
  } | tee "$REPORT_FILE"

  parse_checklist
  preflight_db2
  run_all_auto_checks
  evaluate_auto_checks
  print_manual_items
  print_summary
}

main