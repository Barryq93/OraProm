#!/bin/bash

# Check if an input file is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <input_file>"
  exit 1
fi

input_file="$1"

# Check if the input file exists
if [ ! -f "$input_file" ]; then
  echo "Error: Input file '$input_file' not found."
  exit 1
fi

# Read each line from the input file
while IFS= read -r line; do
  # Use regex to extract host and port
  if [[ "$line" =~ ^([^:]+):([0-9]+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"
    protocol="https" # Default to https

    # Check if the port is 80, if so use http
    if [ "$port" -eq 80 ]; then
      protocol="http"
    fi

    url="$protocol://${host}:${port}"

    # Attempt to establish a connection using curl
    if curl -s --connect-timeout 2 "$url" >/dev/null 2>&1; then
      echo "Connected: $host:$port ($protocol)"
    else
      echo "Not Connected: $host:$port ($protocol)"
    fi
  else
    echo "Invalid format: $line (Expected format: host:port)"
  fi
done < "$input_file"

exit 0
