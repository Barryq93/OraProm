#!/bin/bash

# Check if an input file is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <input_file>"
  exit 1
fi

input_file="$1"
temp_file=$(mktemp)

# Check if the input file exists
if [ ! -f "$input_file" ]; then
  echo "Error: Input file '$input_file' not found."
  rm -f "$temp_file"
  exit 1
fi

# Read each line from the input file
while IFS= read -r line; do
  # Use regex to extract host and port
  if [[ "$line" =~ ^([^:]+):([0-9]+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"

    # Attempt to establish a connection using openssl s_client and redirect all output to the temp file
    timeout 2 openssl s_client -connect "$host":"$port" </dev/null >"$temp_file" 2>&1

    # Check the content of the temp file for connection success or failure indicators
    if grep -q "CONNECTED" "$temp_file"; then
      echo "Connected: $host:$port"
    else
      echo "Not Connected: $host:$port"
    fi
  else
    echo "Invalid format: $line (Expected format: host:port)"
  fi
done < "$input_file"

# Clean up the temporary file
rm -f "$temp_file"

exit 0
