## Reference Implementation

The following is the current production-ready script. All future scripts must follow
its conventions. Deviations require explicit justification in the PR description.

```bash
#!/usr/bin/env bash
set -euo pipefail

############################################
# CONFIG
############################################

DBNAME="${1:-}"
SCHEMA="${2:-}"
MODE="${3:-sampled}"   # sampled | full

if [[ -z "$DBNAME" || -z "$SCHEMA" ]]; then
  echo "action=runstats status=error message=\"Usage: $0 <DBNAME> <SCHEMA> [sampled|full]\""
  exit 1
fi

SCHEMA=$(echo "$SCHEMA" | tr '[:lower:]' '[:upper:]')

# Reorg candidate thresholds - adjust per environment
REORG_OVERFLOW_PCT=30
REORG_FRAG_PCT=25
REORG_MIN_CARD=1000

############################################
# EXECUTION CONTEXT
# Ansible shell/command tasks have no TTY.
# Interactive runs get human-readable terminal output.
# KVP always goes to the log file regardless.
# Final JSON summary line always goes to stdout regardless.
############################################
if [[ -t 1 ]]; then
  INTERACTIVE=true
else
  INTERACTIVE=false
fi

############################################
# LOAD DB2 ENV (needed for non-interactive Ansible shell)
############################################
if [[ -f "$HOME/sqllib/db2profile" ]]; then
  . "$HOME/sqllib/db2profile"
fi

############################################
# LOGGING
############################################
TS=$(date +%Y%m%d_%H%M%S)
TS_ISO=$(date -u +%Y-%m-%dT%H:%M:%SZ)
LOGDIR="/home/db2inst1/runstats"
mkdir -p "$LOGDIR"

LOG="$LOGDIR/runstats_${DBNAME}_${SCHEMA}_${TS}.log"
OK="$LOGDIR/runstats_${DBNAME}_${SCHEMA}_${TS}.ok"
FAIL="$LOGDIR/runstats_${DBNAME}_${SCHEMA}_${TS}.fail"

# KVP always to log file.
# Ansible gets KVP on stdout; interactive gets human-readable on terminal.
# Final JSON summary is emitted separately at the end via emit_json_summary().
log_kvp() {
  local level="$1"; shift
  local kvp_line="ts=${TS_ISO} level=${level} action=runstats db=${DBNAME} schema=${SCHEMA} mode=${MODE} $*"
  echo "$kvp_line" >> "$LOG"

  if [[ "$INTERACTIVE" == true ]]; then
    printf "[%s] %s %s\n" "$level" "$(date +%H:%M:%S)" "$*"
  else
    echo "$kvp_line"
  fi
}

log_kvp INFO status=started

############################################
# RUNSTATS CLAUSE
# ALLOW WRITE ACCESS: tolerate concurrent DML (OLTP/ECM safe)
# SAMPLED default: avoids extended catalog pressure on icmnlsdb
############################################
if [[ "$MODE" == "full" ]]; then
  CLAUSE="WITH DISTRIBUTION AND DETAILED INDEXES ALL ALLOW WRITE ACCESS"
else
  CLAUSE="WITH DISTRIBUTION AND SAMPLED DETAILED INDEXES ALL ALLOW WRITE ACCESS"
fi

############################################
# CONNECT
############################################
if ! db2 connect to "$DBNAME" >>"$LOG" 2>&1; then
  log_kvp ERROR status=failed message="db2_connect_failed"
  echo "{\"db\":\"${DBNAME}\",\"schema\":\"${SCHEMA}\",\"mode\":\"${MODE}\",\"status\":\"connect_failed\",\"exit_code\":1}"
  exit 1
fi
log_kvp INFO status=connected

############################################
# GET TABLE LIST
############################################
TABLES=$(db2 -x "
SELECT RTRIM(TABSCHEMA)||'.'||RTRIM(TABNAME)
FROM SYSCAT.TABLES
WHERE TYPE='T'
AND TABSCHEMA='${SCHEMA}'
ORDER BY TABNAME
WITH UR
" | grep -E '^[A-Z_][A-Z0-9_]*\.[A-Z_][A-Z0-9_]*$')

COUNT=$(echo "$TABLES" | sed '/^$/d' | wc -l)
log_kvp INFO status=tables_found table_count="${COUNT}"

if [[ "$COUNT" -eq 0 ]]; then
  log_kvp WARN status=no_tables message="no_tables_found_check_schema"
  db2 connect reset >>"$LOG" 2>&1
  echo "{\"db\":\"${DBNAME}\",\"schema\":\"${SCHEMA}\",\"mode\":\"${MODE}\",\"status\":\"no_tables\",\"exit_code\":1}"
  exit 1
fi

############################################
# PROCESS TABLES
############################################
i=0
while read -r T; do
  [[ -z "$T" ]] && continue
  i=$((i+1))

  T_START=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  log_kvp INFO status=running table="${T}" table_num="${i}" table_total="${COUNT}"

  T_OUT=$(db2 "RUNSTATS ON TABLE $T $CLAUSE" 2>&1)
  T_RC=$?
  echo "$T_OUT" >> "$LOG"

  T_END=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  if [[ $T_RC -eq 0 ]]; then
    echo "$T" >> "$OK"
    log_kvp INFO status=success table="${T}" table_num="${i}" table_total="${COUNT}" started="${T_START}" completed="${T_END}"
  else
    echo "$T" >> "$FAIL"
    T_MSG=$(echo "$T_OUT" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')
    log_kvp ERROR status=failed table="${T}" table_num="${i}" table_total="${COUNT}" started="${T_START}" completed="${T_END}" db2_output="\"${T_MSG}\""
  fi

done < <(echo "$TABLES")

############################################
# POST-RUN REORGCHK
# REORGCHK UPDATE STATISTICS confirms stats landed and evaluates
# fragmentation / overflow against tuned thresholds.
# Produces a candidate list for a downstream Ansible REORG play.
# We do NOT REORG here — that is a separate, separately-approved playbook.
#
# REORGCHK output columns (fixed-width CLP):
#   TABSCHEMA TABNAME CARD OV NP FP REORG  (table-level)
#   TABSCHEMA TABNAME INDNAME COLNAMES CLUS TS PS REORG (index-level)
# We parse only the table-level rows here.
# REORG column is '*' if any formula threshold is breached.
############################################
log_kvp INFO status=reorgchk_start

REORGCHK_OUT=$(db2 "REORGCHK UPDATE STATISTICS ON TABLE SCHEMA ${SCHEMA}" 2>&1 || true)
echo "$REORGCHK_OUT" >> "$LOG"

# Build reorg candidates JSON array.
# Parse table lines: lines where col1 matches SCHEMA and col7 (REORG flag) is '*'
# We extract: tabname, overflow%, fragmentation%, cardinality
# and apply our own tighter thresholds on top of REORGCHK's flags.
REORG_JSON_ITEMS=""

while IFS= read -r line; do
  # Table-level data lines start with the schema name in col1
  # Format (space-separated, fixed width):
  # SCHEMA  TABNAME  CARD  OV  NP  FP  REORG
  tabschema=$(echo "$line" | awk '{print $1}')
  [[ "$tabschema" != "$SCHEMA" ]] && continue

  tabname=$(echo "$line"   | awk '{print $2}')
  card=$(echo "$line"      | awk '{print $3}')
  overflow=$(echo "$line"  | awk '{print $4}')
  frag=$(echo "$line"      | awk '{print $6}')

  # Skip if cardinality below minimum — not worth REORGing
  [[ "$card" =~ ^[0-9]+$ ]] || continue
  [[ "$card" -lt "$REORG_MIN_CARD" ]] && continue

  # Strip % signs if present
  overflow=${overflow//%/}
  frag=${frag//%/}

  # Apply our thresholds
  needs_reorg=false
  [[ "$overflow" =~ ^[0-9]+$ ]] && [[ "$overflow" -gt "$REORG_OVERFLOW_PCT" ]] && needs_reorg=true
  [[ "$frag"     =~ ^[0-9]+$ ]] && [[ "$frag"     -gt "$REORG_FRAG_PCT"     ]] && needs_reorg=true

  if [[ "$needs_reorg" == true ]]; then
    fulltable="${SCHEMA}.${tabname}"
    log_kvp WARN status=reorg_candidate table="${fulltable}" card="${card}" overflow_pct="${overflow}" frag_pct="${frag}"

    # Append to JSON array (comma-separated, we trim the leading comma at the end)
    REORG_JSON_ITEMS="${REORG_JSON_ITEMS},{\"table\":\"${fulltable}\",\"overflow_pct\":${overflow},\"frag_pct\":${frag},\"card\":${card}}"
  fi

done < <(echo "$REORGCHK_OUT")

log_kvp INFO status=reorgchk_complete

############################################
# POST-RUN: flag tables still at CARD=-1
# Catches dynamically created ICM item type tables with no stats
############################################
NO_STATS=$(db2 -x "
SELECT RTRIM(TABSCHEMA)||'.'||RTRIM(TABNAME)
FROM SYSCAT.TABLES
WHERE TYPE='T'
AND TABSCHEMA='${SCHEMA}'
AND (CARD = -1 OR STATS_TIME IS NULL)
WITH UR
" | grep -E '^[A-Z_][A-Z0-9_]*\.[A-Z_][A-Z0-9_]*$' || true)

NO_STATS_COUNT=$(echo "$NO_STATS" | sed '/^$/d' | wc -l)
NO_STATS_JSON=""

if [[ "$NO_STATS_COUNT" -gt 0 ]]; then
  while read -r T; do
    [[ -z "$T" ]] && continue
    log_kvp WARN status=no_stats_after_run table="${T}" message="card_negative1_or_null_stats_time"
    NO_STATS_JSON="${NO_STATS_JSON},\"${T}\""
  done < <(echo "$NO_STATS")
fi

############################################
# FINISH
############################################
db2 connect reset >>"$LOG" 2>&1

FAIL_COUNT=$(wc -l < "$FAIL" 2>/dev/null || echo 0)
OK_COUNT=$(wc -l < "$OK"   2>/dev/null || echo 0)

EXIT_CODE=0
[[ "$FAIL_COUNT" -gt 0 ]] && EXIT_CODE=1

log_kvp INFO status=complete tables_ok="${OK_COUNT}" tables_failed="${FAIL_COUNT}" tables_no_stats="${NO_STATS_COUNT}" exit_code="${EXIT_CODE}"

############################################
# JSON SUMMARY - always last line of stdout
# This is the Ansible data contract:
#   stdout_lines | last | from_json
# Fields consumed downstream:
#   reorg_candidates -> REORG playbook iteration
#   failed_tables    -> notification handler
#   exit_code        -> mirrors shell exit for log aggregators
############################################

# Build failed_tables JSON array from .fail file
FAILED_JSON=""
if [[ -f "$FAIL" ]]; then
  while IFS= read -r T; do
    [[ -z "$T" ]] && continue
    FAILED_JSON="${FAILED_JSON},\"${T}\""
  done < "$FAIL"
fi

# Trim leading commas
REORG_JSON_ITEMS="${REORG_JSON_ITEMS#,}"
FAILED_JSON="${FAILED_JSON#,}"
NO_STATS_JSON="${NO_STATS_JSON#,}"

