#!/bin/bash

# DB2 Reorganization Script with Estimation Mode (Offline Tables, Index Reorg, Runstats, and db2rbind)
# SIMPLIFIED VERSION: Processes largest tables first, up to CONCURRENT_JOBS in parallel, no batch files
# Quiesces the database, performs offline reorgs and runstats concurrently, rebinds packages with db2rbind

# Check command line arguments
if [ "$#" -ne 1 ] || ([ "$1" != "estimate" ] && [ "$1" != "run" ]); then
    echo "Usage: $0 estimate|run"
    echo "  estimate - Only show time estimates without running reorg, runstats, or db2rbind"
    echo "  run      - Execute the full offline reorganization, runstats, and db2rbind"
    exit 1
fi

MODE=$1
echo "Running in $MODE mode"

# --- BEGIN USER CONFIGURATION ---
DB_NAME="your_database_name" # <--- CHANGE THIS
DB_USER="your_db_user"       # <--- CHANGE THIS
DB_PASS="your_db_password"   # <--- CHANGE THIS (insecure, use safer methods in production)
CONCURRENT_JOBS=3            # Number of concurrent reorg jobs
LOG_DIR="/path/to/logs"      # <--- CHANGE THIS
# --- END USER CONFIGURATION ---

mkdir -p $LOG_DIR

# Single log file
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SUMMARY_LOG="$LOG_DIR/reorg_summary_${MODE}_${TIMESTAMP}.log"
echo "DB2 Offline Reorganization, Runstats, and db2rbind $MODE started at $(date)" > $SUMMARY_LOG
TOTAL_START_TIME=$(date +%s)
echo "Time window: 4 hours" >> $SUMMARY_LOG
echo "WARNING: Hardcoded credentials used. NOT recommended for production." >> $SUMMARY_LOG

# Initialize variables
TABLE_COUNT=0
# Ensure CONCURRENT_JOBS is numeric and at least 1
if [ -z "$CONCURRENT_JOBS" ] || ! echo "$CONCURRENT_JOBS" | grep -qE '^[0-9]+$'; then
    echo "ERROR: CONCURRENT_JOBS invalid ('$CONCURRENT_JOBS'). Defaulting to 3." >> $SUMMARY_LOG
    CONCURRENT_JOBS=3
fi

# Function to estimate reorg, runstats, and db2rbind time based on table and index sizes
estimate_time() {
    TABLE_SIZE_GB=$1
    INDEX_SIZE_GB=$2
    # Validate sizes
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid TABLE_SIZE_GB '$TABLE_SIZE_GB', defaulting to 0.01" >> $SUMMARY_LOG
        TABLE_SIZE_GB="0.01"
    else
        TABLE_SIZE_GB=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.2f", size + 0}')
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "WARNING: Invalid INDEX_SIZE_GB '$INDEX_SIZE_GB', defaulting to 0.01" >> $SUMMARY_LOG
        INDEX_SIZE_GB="0.01"
    fi

    # Table reorg: 1 min/GB, 1.2x for >50GB
    if [ $(awk -v size="$TABLE_SIZE_GB" 'BEGIN {print (size > 50) ? 1 : 0}') -eq 1 ]; then
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.0f", size * 1.2}')
    else
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size}')
    fi
    # Index reorg: 0.5 min/GB
    INDEX_EST_MINS=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size * 0.5}')
    # Runstats: 0.1 min/GB for table + indexes
    RUNSTATS_EST_MINS=$(awk -v table="$TABLE_SIZE_GB" -v idx="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", ((table + idx) < 0.01) ? 1 : (table + idx) * 0.1}')
    # Total with 5% reduction
    TOTAL_EST_MINS=$(awk -v table="$TABLE_EST_MINS" -v idx="$INDEX_EST_MINS" -v runstats="$RUNSTATS_EST_MINS" 'BEGIN {printf "%.0f", (table + idx + runstats) * 0.95}')
    [ "$TOTAL_EST_MINS" -lt 1 ] && TOTAL_EST_MINS=1
    echo "$TOTAL_EST_MINS"
}

# Function to process a single table
process_table() {
    TABLE_NAME=$1
    SCHEMA_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    # Validate sizes
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        TABLE_SIZE_GB="0.01"
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        INDEX_SIZE_GB="0.01"
    fi

    # Estimate time for logging
    TOTAL_EST_MINS=$(estimate_time "$TABLE_SIZE_GB" "$INDEX_SIZE_GB")

    if [ "$MODE" = "run" ]; then
        # Connect to database
        db2 connect to "$DB_NAME" user "$DB_USER" using "$DB_PASS" > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo "ERROR: Failed to connect to $DB_NAME for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
            return 1
        fi

        START_TIME=$(date +%s)
        echo "Starting offline reorg for $SCHEMA_NAME.$TABLE_NAME (Table: ${TABLE_SIZE_GB}GB, Indexes: ${INDEX_SIZE_GB}GB, est. ${TOTAL_EST_MINS} mins) at $(date)" >> $SUMMARY_LOG

        # Table reorg
        echo "Running REORG TABLE for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
        db2 "REORG TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG 2>&1
        TABLE_REORG_STATUS=$?
        if [ $TABLE_REORG_STATUS -ne 0 ]; then
            echo "ERROR: Table reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $TABLE_REORG_STATUS" >> $SUMMARY_LOG
            db2 terminate > /dev/null 2>&1
            return 1
        fi

        # Index reorg
        echo "Running index reorg for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
        db2 "REORG INDEXES ALL FOR TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\"" >> $SUMMARY_LOG 2>&1
        INDEX_REORG_STATUS=$?
        if [ $INDEX_REORG_STATUS -ne 0 ]; then
            echo "ERROR: Index reorg for $SCHEMA_NAME.$TABLE_NAME failed with status $INDEX_REORG_STATUS" >> $SUMMARY_LOG
            db2 terminate > /dev/null 2>&1
            return 1
        fi

        # Runstats
        echo "Running runstats for $SCHEMA_NAME.$TABLE_NAME" >> $SUMMARY_LOG
        db2 "RUNSTATS ON TABLE \"$SCHEMA_NAME\".\"$TABLE_NAME\" WITH DISTRIBUTION AND DETAILED INDEXES ALL" >> $SUMMARY_LOG 2>&1
        RUNSTATS_STATUS=$?
        if [ $RUNSTATS_STATUS -ne 0 ]; then
            echo "ERROR: Runstats for $SCHEMA_NAME.$TABLE_NAME failed with status $RUNSTATS_STATUS" >> $SUMMARY_LOG
            db2 terminate > /dev/null 2>&1
            return 1
        fi

        END_TIME=$(date +%s)
        DURATION=$((END_TIME - START_TIME))
        MINUTES=$((DURATION / 60))
        SECONDS=$((DURATION % 60))
        echo "Completed reorg, index reorg, and runstats for $SCHEMA_NAME.$TABLE_NAME in ${MINUTES}m ${SECONDS}s" >> $SUMMARY_LOG

        # Disconnect
        db2 terminate > /dev/null 2>&1
    else
        # Estimate mode
        TABLE_EST_MINS=$(awk -v size="$TABLE_SIZE_GB" -v thresh=50 'BEGIN {print (size > thresh) ? int(size * 1.2) : (size < 0.01) ? 1 : int(size)}')
        INDEX_EST_MINS=$(awk -v size="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", (size < 0.01) ? 1 : size * 0.5}')
        RUNSTATS_EST_MINS=$(awk -v table="$TABLE_SIZE_GB" -v idx="$INDEX_SIZE_GB" 'BEGIN {printf "%.0f", ((table + idx) < 0.01) ? 1 : (table + idx) * 0.1}')
        echo "ESTIMATE: $SCHEMA_NAME.$TABLE_NAME (Table: ${TABLE_SIZE_GB}GB, est. ${TABLE_EST_MINS} mins; Indexes: ${INDEX_SIZE_GB}GB, est. ${INDEX_EST_MINS} mins; Runstats: est. ${RUNSTATS_EST_MINS} mins; Total: ${TOTAL_EST_MINS} mins)" >> $SUMMARY_LOG
    fi
}

# --- Main Script Logic ---

# Connect to database
echo "Connecting to $DB_NAME..." >> $SUMMARY_LOG
db2 connect to "$DB_NAME" user "$DB_USER" using "$DB_PASS" > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to connect to database $DB_NAME" >> $SUMMARY_LOG
    exit 1
fi

# Quiesce database in run mode
if [ "$MODE" = "run" ]; then
    echo "Quiescing database $DB_NAME at $(date)" >> $SUMMARY_LOG
    db2 "QUIESCE DATABASE IMMEDIATE FORCE CONNECTIONS" >> $SUMMARY_LOG 2>&1
    if [ $? -ne 0 ]; then
        echo "ERROR: Failed to quiesce database $DB_NAME" >> $SUMMARY_LOG
        db2 terminate > /dev/null 2>&1
        exit 1
    fi
    echo "Database $DB_NAME quiesced successfully" >> $SUMMARY_LOG
fi

# Get list of tables, sorted by size (largest first)
TABLE_LIST_FILE="${LOG_DIR}/all_tables_${TIMESTAMP}.txt"
echo "Identifying tables for reorganization..." >> $SUMMARY_LOG
SQL_QUERY="SELECT RTRIM(TABNAME), RTRIM(TABSCHEMA), \
           COALESCE(CAST(DECIMAL(GREATEST(DATA_OBJECT_P_SIZE, 0)) / 1024.0 / 1024.0 AS DECIMAL(10,2)), 0.01), \
           COALESCE(CAST(DECIMAL(GREATEST(INDEX_OBJECT_P_SIZE, 0)) / 1024.0 / 1024.0 AS DECIMAL(10,2)), 0.01) \
           FROM SYSIBMADM.ADMINTABINFO \
           WHERE TABSCHEMA NOT LIKE 'SYS%' AND DATA_OBJECT_P_SIZE IS NOT NULL AND INDEX_OBJECT_P_SIZE IS NOT NULL \
           ORDER BY (DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE) DESC"

db2 -x "$SQL_QUERY" > "$TABLE_LIST_FILE"
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to get table list" >> $SUMMARY_LOG
    if [ "$MODE" = "run" ]; then
        db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1
    fi
    db2 terminate > /dev/null 2>&1
    exit 1
fi

# Check if table list is empty
if [ ! -s "$TABLE_LIST_FILE" ]; then
    echo "ERROR: No tables found for processing" >> $SUMMARY_LOG
    if [ "$MODE" = "run" ]; then
        db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1
    fi
    db2 terminate > /dev/null 2>&1
    exit 1
fi

# Calculate total time estimate
echo "Calculating time estimates..." >> $SUMMARY_LOG
TOTAL_EST_MINS=0
TABLE_COUNT=0

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    set -- $line
    TABLE_NAME=$1
    SCHEMA_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    # Validate sizes
    if [ -z "$TABLE_SIZE_GB" ] || ! echo "$TABLE_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        TABLE_SIZE_GB="0.01"
    fi
    if [ -z "$INDEX_SIZE_GB" ] || ! echo "$INDEX_SIZE_GB" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        INDEX_SIZE_GB="0.01"
    fi

    TABLE_EST=$(estimate_time "$TABLE_SIZE_GB" "$INDEX_SIZE_GB")
    TOTAL_EST_MINS=$((TOTAL_EST_MINS + TABLE_EST))
    TABLE_COUNT=$((TABLE_COUNT + 1))
done < "$TABLE_LIST_FILE"

echo "Total tables to process: $TABLE_COUNT" >> $SUMMARY_LOG

# Estimate with concurrency
if [ "$TABLE_COUNT" -gt 0 ] && [ "$CONCURRENT_JOBS" -gt 0 ]; then
    PARALLEL_EST_MINS=$(( (TOTAL_EST_MINS / CONCURRENT_JOBS) + 1 ))
else
    echo "WARNING: No tables or CONCURRENT_JOBS=0, setting PARALLEL_EST_MINS to 0" >> $SUMMARY_LOG
    PARALLEL_EST_MINS=0
fi

# Add db2rbind estimate
DB2RBIND_EST_MINS=5
FINAL_EST_MINS=$((PARALLEL_EST_MINS + DB2RBIND_EST_MINS))
TOTAL_EST_HRS=$(awk -v mins="$FINAL_EST_MINS" 'BEGIN {printf "%.1f", mins / 60}')
echo "Estimated time (serial, no concurrency): $TOTAL_EST_MINS minutes" >> $SUMMARY_LOG
echo "Estimated time (parallel, with $CONCURRENT_JOBS jobs): $PARALLEL_EST_MINS minutes" >> $SUMMARY_LOG
echo "Total estimated time (including db2rbind): $FINAL_EST_MINS minutes ($TOTAL_EST_HRS hours)" >> $SUMMARY_LOG

# Warn if estimate exceeds 4 hours
if [ -n "$TOTAL_EST_HRS" ] && [ $(awk -v hrs="$TOTAL_EST_HRS" 'BEGIN {print (hrs > 4.0) ? 1 : 0}') -eq 1 ]; then
    echo "WARNING: Estimated time exceeds 4-hour window!" >> $SUMMARY_LOG
fi

# Exit if estimating
if [ "$MODE" = "estimate" ]; then
    echo "Estimation completed. See log: $SUMMARY_LOG"
    db2 terminate > /dev/null 2>&1
    rm -f "$TABLE_LIST_FILE"
    exit 0
fi

# --- Execution Mode ---
echo "Starting reorganization with $CONCURRENT_JOBS concurrent jobs..." >> $SUMMARY_LOG

# Validate CONCURRENT_JOBS again before execution
if [ -z "$CONCURRENT_JOBS" ] || [ "$CONCURRENT_JOBS" -lt 1 ] 2>/dev/null; then
    echo "ERROR: CONCURRENT_JOBS invalid ('$CONCURRENT_JOBS'). Defaulting to 3." >> $SUMMARY_LOG
    CONCURRENT_JOBS=3
fi

# Process tables in parallel, largest first
ACTIVE_JOBS=0
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    set -- $line
    TABLE_NAME=$1
    SCHEMA_NAME=$2
    TABLE_SIZE_GB=$3
    INDEX_SIZE_GB=$4

    # Launch job if fewer than CONCURRENT_JOBS are running
    if [ $ACTIVE_JOBS -lt $CONCURRENT_JOBS ]; then
        process_table "$TABLE_NAME" "$SCHEMA_NAME" "$TABLE_SIZE_GB" "$INDEX_SIZE_GB" &
        ACTIVE_JOBS=$((ACTIVE_JOBS + 1))
        echo "Launched job for $SCHEMA_NAME.$TABLE_NAME (PID: $!, Active jobs: $ACTIVE_JOBS)" >> $SUMMARY_LOG
    else
        # Wait for a job to finish
        wait -n
        ACTIVE_JOBS=$((ACTIVE_JOBS - 1))
        echo "Job completed, active jobs now: $ACTIVE_JOBS" >> $SUMMARY_LOG
        # Launch next job
        process_table "$TABLE_NAME" "$SCHEMA_NAME" "$TABLE_SIZE_GB" "$INDEX_SIZE_GB" &
        ACTIVE_JOBS=$((ACTIVE_JOBS + 1))
        echo "Launched job for $SCHEMA_NAME.$TABLE_NAME (PID: $!, Active jobs: $ACTIVE_JOBS)" >> $SUMMARY_LOG
    fi
done < "$TABLE_LIST_FILE"

# Wait for remaining jobs
echo "Waiting for all jobs to complete..." >> $SUMMARY_LOG
wait
echo "All table processing completed." >> $SUMMARY_LOG

# Perform db2rbind
echo "Starting db2rbind at $(date)" >> $SUMMARY_LOG
db2rbind "$DB_NAME" -l "$SUMMARY_LOG" -u "$DB_USER" -p "$DB_PASS" all
RBIND_STATUS=$?
if [ $RBIND_STATUS -eq 0 ]; then
    echo "db2rbind completed successfully" >> $SUMMARY_LOG
elif [ $RBIND_STATUS -eq 4 ]; then
    echo "WARNING: db2rbind completed with warnings (Status: $RBIND_STATUS)" >> $SUMMARY_LOG
else
    echo "ERROR: db2rbind failed with status $RBIND_STATUS" >> $SUMMARY_LOG
fi

# Unquiesce database
echo "Unquiescing database $DB_NAME at $(date)" >> $SUMMARY_LOG
db2 "UNQUIESCE DATABASE" >> $SUMMARY_LOG 2>&1
if [ $? -ne 0 ]; then
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> $SUMMARY_LOG
    echo "ERROR: Failed to unquiesce database $DB_NAME. MANUAL INTERVENTION REQUIRED!" >> $SUMMARY_LOG
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> $SUMMARY_LOG
else
    echo "Database $DB_NAME unquiesced successfully" >> $SUMMARY_LOG
fi

# Final summary
TOTAL_END_TIME=$(date +%s)
TOTAL_DURATION=$((TOTAL_END_TIME - TOTAL_START_TIME))
TOTAL_HOURS=$((TOTAL_DURATION / 3600))
TOTAL_MINUTES=$(( (TOTAL_DURATION % 3600) / 60 ))
TOTAL_SECONDS=$((TOTAL_DURATION % 60))

echo "--------------------------------------------------" >> $SUMMARY_LOG
echo "DB2 Offline Reorg/Runstats/Rbind Summary" >> $SUMMARY_LOG
echo "Mode: $MODE" >> $SUMMARY_LOG
echo "End Time: $(date)" >> $SUMMARY_LOG
echo "Total execution time: ${TOTAL_HOURS}h ${TOTAL_MINUTES}m ${TOTAL_SECONDS}s" >> $SUMMARY_LOG
echo "Total tables processed: $TABLE_COUNT" >> $SUMMARY_LOG
echo "--------------------------------------------------" >> $SUMMARY_LOG

# Cleanup
db2 terminate > /dev/null 2>&1
rm -f "$TABLE_LIST_FILE"

echo "DB2 offline reorganization completed. See log: $SUMMARY_LOG"
exit 0
