echo "══ EXPERT 2: IBM ECM 8.7.4 SPECIALIST VERIFICATION ══" >> "$VERIFY"
echo "" >> "$VERIFY"

e_pass=0; e_fail=0; e_warn=0

check_e() {
  local label="$1"
  local result="$2"
  local detail="$3"
  printf "  [%-4s] %s — %s\n" "$result" "$label" "$detail" >> "$VERIFY"
  case "$result" in
    PASS) ((e_pass++)) ;;
    FAIL) ((e_fail++)) ;;
    WARN) ((e_warn++)) ;;
  esac
}

# ECM schemas detected?
for DB in $DBS; do
  if [ "${DB_ECM_SCHEMAS[$DB]:-UNKNOWN}" != "UNKNOWN" ] && [ "${DB_ECM_SCHEMAS[$DB]:-}" != "" ]; then
    check_e "ECM schemas detected [$DB]" "PASS" "Schemas: ${DB_ECM_SCHEMAS[$DB]}"
  else
    check_e "ECM schemas detected [$DB]" "WARN" "No schemas detected — may be system DB or schema query failed"
  fi
done

# Large ECM tables (DOCVERSION etc) visible?
if grep -qiE 'DOCVERSION|QUEUEITEM|ROSIDMAP|OBJECT_|AUDIT' "$REPORT" 2>/dev/null; then
  check_e "ECM-specific tables visible in top tables" "PASS" "Key ECM tables found in large table list"
else
  check_e "ECM-specific tables visible in top tables" "WARN" "No recognizable ECM table names — may be aliased, or schema owner differs"
fi

# Reorg pending check ran?
if grep -qi 'REORG_PENDING' "$REPORT" 2>/dev/null; then
  check_e "Reorg pending check executed" "PASS" "REORG_PENDING column queried"
else
  check_e "Reorg pending check executed" "FAIL" "Reorg pending check missing — ECM index health unknown"
fi

# Long transaction check ran?
if grep -qi 'UOW_ELAPSED_TIME\|MON_GET_UNIT_OF_WORK' "$REPORT" 2>/dev/null; then
  check_e "Long transaction check executed" "PASS" "UOW monitoring ran"
else
  check_e "Long transaction check executed" "FAIL" "Long transaction check missing — hung ECM CE transactions won't be flagged"
fi

# Connection analysis ran?
if grep -qi 'MON_GET_CONNECTION\|APPLICATION_NAME.*conn_count' "$REPORT" 2>/dev/null; then
  check_e "Connection pool analysis ran" "PASS" "Connection data present"
else
  check_e "Connection pool analysis ran" "FAIL" "Connection data missing — ECM pool saturation not assessable"
fi

# Top SQL captured?
if grep -qi 'MON_GET_PKG_CACHE\|total_exec_ms\|sql_snippet' "$REPORT" 2>/dev/null; then
  check_e "Top SQL by execution time captured" "PASS" "Package cache data present"
else
  check_e "Top SQL by execution time captured" "WARN" "Top SQL not found — ECM slow query root cause analysis limited"
fi

# Stale statistics check ran?
if grep -qi 'STATS_TIME\|days_since_stats\|last_stats_date' "$REPORT" 2>/dev/null; then
  check_e "Stale statistics check ran" "PASS" "Statistics age data present"
else
  check_e "Stale statistics check ran" "FAIL" "Stats check missing — optimizer health for ECM queries unknown"
fi

# Cluster ratio index check ran?
if grep -qi 'CLUSTERRATIO\|cluster_ratio' "$REPORT" 2>/dev/null; then
  check_e "Index cluster ratio check ran" "PASS" "Cluster ratio data present"
else
  check_e "Index cluster ratio check ran" "WARN" "No cluster ratio data — ECM range scan performance unknown"
fi

# Fragmented tablespace check ran?
if grep -qi 'free_pct\|Free Space.*Reorg' "$REPORT" 2>/dev/null; then
  check_e "Tablespace fragmentation check ran" "PASS" "Free space per tablespace data present"
else
  check_e "Tablespace fragmentation check ran" "FAIL" "Fragmentation check missing — ECM tablespace bloat not assessable"
fi

# LOCKTIMEOUT checked?
for DB in $DBS; do
  lt="${DB_LOCKTIMEOUT[$DB]:-UNKNOWN}"
  if [ "$lt" != "UNKNOWN" ]; then
    check_e "LOCKTIMEOUT extracted [$DB]" "PASS" "Value: $lt sec"
  else
    check_e "LOCKTIMEOUT extracted [$DB]" "WARN" "Could not extract LOCKTIMEOUT — ECM lock cascade risk unknown"
  fi
done

echo "" >> "$VERIFY"
echo "  ECM Specialist Score: PASS=$e_pass  FAIL=$e_fail  WARN=$e_warn" >> "$VERIFY"
if [ $e_fail -ge 3 ]; then
  echo "  VERDICT: CRITICAL ECM-SPECIFIC GAPS — major blind spots for ECM health review" >> "$VERIFY"
elif [ $e_fail -ge 1 ] || [ $e_warn -ge 3 ]; then
  echo "  VERDICT: MODERATE ECM GAPS — Claude analysis will flag these as unknowns" >> "$VERIFY"
else
  echo "  VERDICT: ECM DATA COLLECTION ADEQUATE" >> "$VERIFY"
fi

# ── EXPERT 3: Prompt Engineer ─────────────────────────────────────────────────
echo "" >> "$VERIFY"
echo "══ EXPERT 3: PROMPT ENGINEER VERIFICATION ══" >> "$VERIFY"
echo "" >> "$VERIFY"

p_pass=0; p_fail=0; p_warn=0

check_p() {
  local label="$1"
  local result="$2"
  local detail="$3"
  printf "  [%-4s] %s — %s\n" "$result" "$label" "$detail" >> "$VERIFY"
  case "$result" in
    PASS) ((p_pass++)) ;;
    FAIL) ((p_fail++)) ;;
    WARN) ((p_warn++)) ;;
  esac
}

# Does the prompt file exist and have content?
prompt_lines=$(wc -l < "$PROMPT_MD" 2>/dev/null || echo 0)
if [ "$prompt_lines" -gt 50 ]; then
  check_p "Prompt file generated" "PASS" "$prompt_lines lines — substantial content"
elif [ "$prompt_lines" -gt 0 ]; then
  check_p "Prompt file generated" "WARN" "Only $prompt_lines lines — may be incomplete"
else
  check_p "Prompt file generated" "FAIL" "Prompt file empty or not found"
fi

# Does the prompt contain the live report?
if grep -q "db2level\|LOGFILSIZ\|MON_GET" "$PROMPT_MD" 2>/dev/null; then
  check_p "Live report embedded in prompt" "PASS" "Db2 data visible inside prompt"
else
  check_p "Live report embedded in prompt" "FAIL" "Live data not embedded — Claude will have no grounding data"
fi

# Does the prompt contain the pass/fail table?
if grep -q "PASS\|FAIL\|Warning" "$PROMPT_MD" 2>/dev/null; then
  check_p "Pass/fail table embedded in prompt" "PASS" "Verdict table visible in prompt"
else
  check_p "Pass/fail table embedded in prompt" "FAIL" "No pass/fail table in prompt — Claude lacks structured findings to validate"
fi

# Does the prompt define Claude's role explicitly?
if grep -qi 'senior.*DBA\|ECM.*expert\|Your Role' "$PROMPT_MD" 2>/dev/null; then
  check_p "Role definition present" "PASS" "Persona and expertise loaded"
else
  check_p "Role definition present" "FAIL" "No role definition — Claude will reason generically, not as ECM+Db2 expert"
fi

# Does the prompt specify NOT to blindly trust the pass/fail table?
if grep -qi 'validate\|do not.*accept\|raw data.*precedence\|validate.*don.*accept' "$PROMPT_MD" 2>/dev/null; then
  check_p "Anti-anchoring instruction present" "PASS" "Prompt instructs Claude to validate verdicts, not just accept them"
else
  check_p "Anti-anchoring instruction present" "FAIL" "Prompt may anchor Claude to script verdicts — Claude reasoning suppressed"
fi

# Does the prompt specify output sections?
if grep -qi 'EXECUTIVE SUMMARY\|Action Plan\|Confidence' "$PROMPT_MD" 2>/dev/null; then
  check_p "Structured output format specified" "PASS" "Executive summary, action plan, confidence sections defined"
else
  check_p "Structured output format specified" "WARN" "Output format not clearly specified — Claude may produce unstructured response"
fi

# Does the prompt include ECM-specific context (not just generic Db2)?
if grep -qi 'DOCVERSION\|Content Engine\|QUEUEITEM\|GCD\|FileNet' "$PROMPT_MD" 2>/dev/null; then
  check_p "ECM-specific domain context loaded" "PASS" "FileNet/GCD/DOCVERSION context present"
else
  check_p "ECM-specific domain context loaded" "FAIL" "No ECM 8.7.4 domain context — Claude will give generic Db2 advice"
fi

# Does the prompt include the swap anomaly as a specific focus area?
if grep -qi 'swap\|SHEAPTHRES_SHR\|STMM.*anomaly\|memory.*anomaly' "$PROMPT_MD" 2>/dev/null; then
  check_p "Known swap anomaly highlighted to Claude" "PASS" "Swap issue called out as specific investigation target"
else
  check_p "Known swap anomaly highlighted to Claude" "WARN" "Swap anomaly not prominently flagged — Claude may bury it in generic findings"
fi

# Does the prompt ask Claude to flag corrections?
if grep -qi '\[CORRECTION\]\|corrections\|discrepancy' "$PROMPT_MD" 2>/dev/null; then
  check_p "Correction/discrepancy tracking requested" "PASS" "Claude instructed to flag script verdict corrections"
else
  check_p "Correction/discrepancy tracking requested" "WARN" "No explicit correction tracking — Claude may silently override verdicts"
fi

# Is the per-DB extracted facts section present?
if grep -qi 'Used GB\|Log used KB\|LOGARCHMETH' "$PROMPT_MD" 2>/dev/null; then
  check_p "Per-DB extracted facts in prompt" "PASS" "Key values per database listed for Claude's reference"
else
  check_p "Per-DB extracted facts in prompt" "WARN" "Per-DB facts section incomplete"
fi

# Is prompt likely under context limit? (rough heuristic: <80KB)
prompt_size=$(wc -c < "$PROMPT_MD" 2>/dev/null || echo 0)
if [ "$prompt_size" -lt 80000 ]; then
  check_p "Prompt size within reasonable Claude context limit" "PASS" "~$((prompt_size/1024)) KB — fits comfortably"
elif [ "$prompt_size" -lt 150000 ]; then
  check_p "Prompt size within reasonable Claude context limit" "WARN" "~$((prompt_size/1024)) KB — large but usable; consider using Claude.ai Pro or API for full context"
else
  check_p "Prompt size within reasonable Claude context limit" "FAIL" "~$((prompt_size/1024)) KB — too large for default Claude context; truncate top SQL or tablespace details"
fi

echo "" >> "$VERIFY"
echo "  Prompt Engineer Score: PASS=$p_pass  FAIL=$p_fail  WARN=$p_warn" >> "$VERIFY"
if [ $p_fail -ge 3 ]; then
  echo "  VERDICT: PROMPT CRITICALLY DEFICIENT — fix before submitting to Claude" >> "$VERIFY"
elif [ $p_fail -ge 1 ] || [ $p_warn -ge 4 ]; then
  echo "  VERDICT: PROMPT USABLE BUT SUBOPTIMAL — review warnings before submission" >> "$VERIFY"
else
  echo "  VERDICT: PROMPT IS WELL-FORMED FOR CLAUDE SUBMISSION" >> "$VERIFY"
fi

# ── COMBINED FINAL VERDICT ────────────────────────────────────────────────────
echo "" >> "$VERIFY"
echo "════════════════════════════════════════════════════════════" >> "$VERIFY"
echo "COMBINED VERDICT" >> "$VERIFY"
echo "════════════════════════════════════════════════════════════" >> "$VERIFY"

total_fail=$((v_fail + e_fail + p_fail))
total_warn=$((v_warn + e_warn + p_warn))
