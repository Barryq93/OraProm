SELECT 
    d.*, 
    ds.*, 
    dt.*,
    da.attr1_row1, da.attr1_row2,
    da.attr2_row1, da.attr2_row2,
    da.attr3_row1, da.attr3_row2,
    da.attr4_row1, da.attr4_row2
FROM 
    document d
JOIN 
    documents ds ON d.docid = ds.documentID
JOIN 
    DocumentType dt ON dt.DocumentTypeID = d.DocumentTypeID
LEFT JOIN (
    SELECT *
    FROM (
        SELECT 
            docid,
            attr1,
            attr2,
            attr3,
            attr4,
            ROW_NUMBER() OVER (PARTITION BY docid ORDER BY attr1) AS rn
        FROM 
            documentattributes
    )
    PIVOT (
        MAX(attr1) AS attr1, 
        MAX(attr2) AS attr2, 
        MAX(attr3) AS attr3, 
        MAX(attr4) AS attr4
        FOR rn IN (1 AS row1, 2 AS row2)
    )
) da ON d.docid = da.docid;
