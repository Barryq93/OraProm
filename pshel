-- File: db2_tuning_cm873.sql
-- Purpose: Tune and monitor a DB2 LUW database supporting IBM CM 8.7.3
-- Date: February 26, 2025
-- Notes: Replace <dbname>, <schema>, and <table> with actual values before running

-- Connect to the database
CONNECT TO <dbname>;

-- *** Section 1: Assess Current Performance Baseline ***
-- Monitor database activity
SELECT SUBSTR(DB_NAME, 1, 15) AS DBNAME, 
       MEMBER, 
       TOTAL_CPU_TIME, 
       TOTAL_WAIT_TIME, 
       ROWS_READ, 
       ROWS_RETURNED 
FROM TABLE(MON_GET_DATABASE(-2));

-- Check buffer pool hit ratios
SELECT SUBSTR(BP_NAME, 1, 20) AS BP_NAME, 
       TOTAL_LOGICAL_READS, 
       TOTAL_PHYSICAL_READS, 
       (TOTAL_LOGICAL_READS - TOTAL_PHYSICAL_READS) * 100 / TOTAL_LOGICAL_READS AS HIT_RATIO 
FROM TABLE(MON_GET_BUFFERPOOL('', -2));

-- *** Section 2: Optimize Database Configuration ***
-- Check current DATABASE_MEMORY setting
SELECT NAME, VALUE 
FROM SYSIBMADM.DBCFG 
WHERE NAME = 'DATABASE_MEMORY';

-- Example: Adjust buffer pool size (tune based on memory availability)
ALTER BUFFERPOOL IBMDEFAULTBP SIZE 50000;

-- Tune sort heap for IBM CM queries
UPDATE DB CFG FOR <dbname> USING SHEAPTHRES_SHR 100000 SORTHEAP 10000;

-- Configure log settings for sufficient transaction space
UPDATE DB CFG FOR <dbname> USING LOGFILSIZ 4096 LOGPRIMARY 10 LOGSECOND 20;

-- Optional: Enable CUR_COMMIT to reduce lock contention (verify IBM CM compatibility)
UPDATE DB CFG FOR <dbname> USING CUR_COMMIT ON;

-- *** Section 3: Update Statistics and Reorganize ***
-- Update statistics for all tables in a schema (replace <schema>)
CALL ADMIN_CMD('RUNSTATS ON TABLE ALL FOR SCHEMA <schema> WITH DISTRIBUTION AND DETAILED INDEXES ALL');

-- Check tables/indexes needing reorganization
CALL ADMIN_CMD('REORGCHK UPDATE STATISTICS ON TABLE ALL');

-- Example: Reorg a specific table (replace <schema>.<table>)
CALL ADMIN_CMD('REORG TABLE <schema>.<table>');
CALL ADMIN_CMD('REORG INDEXES ALL FOR TABLE <schema>.<table>');

-- Example: Online reorg to minimize downtime
CALL ADMIN_CMD('REORG TABLE <schema>.<table> INPLACE');

-- *** Section 4: Index Tuning ***
-- Example: Create an index (replace with actual columns and table)
CREATE INDEX IDX_CM_DOCS ON <schema>.<table> (DOCUMENT_ID, METADATA_FIELD);

-- *** Section 5: Monitor Workload ***
-- Check for lock waits or deadlocks
SELECT SUBSTR(APPLICATION_NAME, 1, 20) AS APP_NAME, 
       LOCK_WAIT_TIME, 
       LOCK_WAITS 
FROM TABLE(MON_GET_APPLICATION('', -2));

-- Identify expensive queries
SELECT SUBSTR(STMT_TEXT, 1, 50) AS QUERY, 
       TOTAL_CPU_TIME, 
       NUM_EXECUTIONS, 
       TOTAL_WAIT_TIME 
FROM TABLE(MON_GET_PKG_CACHE_STMT('', NULL, NULL, -2)) 
ORDER BY TOTAL_CPU_TIME DESC 
FETCH FIRST 10 ROWS ONLY;

-- *** Section 6: Diagnostic Queries ***
-- Check for missing indexes (high table scans)
SELECT SUBSTR(TABSCHEMA, 1, 10) AS SCHEMA, 
       SUBSTR(TABNAME, 1, 20) AS TABLE_NAME, 
       TABLE_SCANS, 
       ROWS_READ 
FROM TABLE(MON_GET_TABLE('', '', -2)) 
WHERE TABLE_SCANS > 1000 
ORDER BY TABLE_SCANS DESC;

-- Verify index usage (unused indexes older than 30 days)
SELECT SUBSTR(INDSCHEMA, 1, 10) AS SCHEMA, 
       SUBSTR(INDNAME, 1, 20) AS INDEX_NAME, 
       SUBSTR(TABSCHEMA, 1, 10) AS TAB_SCHEMA, 
       SUBSTR(TABNAME, 1, 20) AS TABLE_NAME, 
       LASTUSED 
FROM SYSCAT.INDEXES 
WHERE LASTUSED < CURRENT_DATE - 30 DAYS 
ORDER BY LASTUSED;

-- Check table fragmentation and outdated stats
SELECT SUBSTR(TABSCHEMA, 1, 10) AS SCHEMA, 
       SUBSTR(TABNAME, 1, 20) AS TABLE_NAME, 
       STATS_TIME, 
       CARD, 
       NPAGES 
FROM SYSCAT.TABLES 
WHERE STATS_TIME < CURRENT_TIMESTAMP - 7 DAYS 
AND TABSCHEMA NOT LIKE 'SYS%';

-- Check index fragmentation
SELECT SUBSTR(INDSCHEMA, 1, 10) AS SCHEMA, 
       SUBSTR(INDNAME, 1, 20) AS INDEX_NAME, 
       SUBSTR(TABSCHEMA, 1, 10) AS TAB_SCHEMA, 
       SUBSTR(TABNAME, 1, 20) AS TABLE_NAME, 
       NLEAF, 
       NLEVELS 
FROM SYSCAT.INDEXES 
WHERE NLEVELS > 4 OR NLEAF > 10000;

-- Monitor tablespace usage
SELECT SUBSTR(TBSPACE, 1, 20) AS TABLESPACE, 
       TOTAL_PAGES, 
       USED_PAGES, 
       (USED_PAGES * 100 / TOTAL_PAGES) AS PCT_USED 
FROM TABLE(MON_GET_TABLESPACE('', -2)) 
WHERE PCT_USED > 85;

-- Check database connections
SELECT NUM_AGENTS, 
       AGENTS_WAITING, 
       APPLICATIONS_WAITING 
FROM TABLE(MON_GET_SERVICE_CLASS('', '', -2));

-- Identify slow queries
SELECT SUBSTR(STMT_TEXT, 1, 50) AS QUERY, 
       EXECUTION_TIME, 
       TOTAL_CPU_TIME 
FROM TABLE(MON_GET_ACTIVITY(NULL, -2)) 
WHERE EXECUTION_TIME > 1000 
ORDER BY EXECUTION_TIME DESC;

-- Detect lock waits
SELECT SUBSTR(APPLICATION_NAME, 1, 20) AS APP, 
       LOCK_OBJECT_TYPE, 
       LOCK_WAIT_TIME 
FROM TABLE(MON_GET_LOCKS(NULL, -2)) 
WHERE LOCK_WAIT_TIME > 0;

-- Disconnect from the database
CONNECT RESET;

-- End of script
