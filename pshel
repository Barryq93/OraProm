# Configuration
$servers = "Server1", "Server2", "Server3", "Server4", "Server5", "Server6", "Server7" # Replace with your server names
$runTimeMinutes = 60 # Run for 1 hour
$logDirectory = "C:\NetworkLogs" # Adjust the log directory as needed

# Ensure log directory exists
if (!(Test-Path -Path $logDirectory -PathType Container)) {
    New-Item -ItemType Directory -Path $logDirectory | Out-Null
}

$jobs = @() # Array to store job objects

foreach ($server in $servers) {
    $job = Start-Job -ScriptBlock {
        param($serverName, $runMinutes, $logDir)

        $inboundLogPath = Join-Path $logDir "$($serverName)_inbound.log"
        $outboundLogPath = Join-Path $logDir "$($serverName)_outbound.log"

        if (Test-Path $inboundLogPath) { Clear-Content $inboundLogPath }
        if (Test-Path $outboundLogPath) { Clear-Content $outboundLogPath }

        $uniqueInbound = @{}
        $uniqueOutbound = @{}

        $endTime = (Get-Date).AddMinutes($runMinutes)

        Write-Host "Starting network capture on $serverName..."

        while ((Get-Date) -lt $endTime) {
            try {
                $inboundConnections = Get-NetTCPConnection -State Established
                foreach ($connection in $inboundConnections) {
                    $uniqueKey = "$($connection.RemoteAddress):$($connection.RemotePort) -> $($connection.LocalAddress):$($connection.LocalPort)"
                    if (-not $uniqueInbound.ContainsKey($uniqueKey)) {
                        $uniqueInbound[$uniqueKey] = $true

                        try {
                            $resolvedRemoteName = [System.Net.Dns]::GetHostEntry($connection.RemoteAddress).HostName
                        } catch {
                            $resolvedRemoteName = $connection.RemoteAddress # If resolution fails, use IP
                        }

                        try {
                            $resolvedLocalName = [System.Net.Dns]::GetHostEntry($connection.LocalAddress).HostName
                        } catch {
                            $resolvedLocalName = $connection.LocalAddress
                        }

                        try {
                            $process = Get-Process -Id $connection.OwningProcess -ErrorAction SilentlyContinue
                            $processName = $process.ProcessName
                        } catch {
                            $processName = "N/A"
                        }

                        "$($resolvedRemoteName):$($connection.RemotePort) -> $($resolvedLocalName):$($connection.LocalPort), Process: $($processName)" | Out-File -FilePath $inboundLogPath -Append
                    }
                }
                $outboundConnections = Get-NetTCPConnection -State Established
                foreach ($connection in $outboundConnections) {
                    $uniqueKey = "$($connection.LocalAddress):$($connection.LocalPort) -> $($connection.RemoteAddress):$($connection.RemotePort)"
                    if (-not $uniqueOutbound.ContainsKey($uniqueKey)) {
                        $uniqueOutbound[$uniqueKey] = $true

                        try {
                            $resolvedRemoteName = [System.Net.Dns]::GetHostEntry($connection.RemoteAddress).HostName
                        } catch {
                            $resolvedRemoteName = $connection.RemoteAddress
                        }

                        try {
                            $resolvedLocalName = [System.Net.Dns]::GetHostEntry($connection.LocalAddress).HostName
                        } catch {
                            $resolvedLocalName = $connection.LocalAddress
                        }

                        try {
                            $process = Get-Process -Id $connection.OwningProcess -ErrorAction SilentlyContinue
                            $processName = $process.ProcessName
                        } catch {
                            $processName = "N/A"
                        }

                        "$($resolvedLocalName):$($connection.LocalPort) -> $($resolvedRemoteName):$($connection.RemotePort), Process: $($processName)" | Out-File -FilePath $outboundLogPath -Append
                    }
                }
            } catch {
                Write-Warning "Error on $serverName: $($_.Exception.Message)"
            }
            Start-Sleep -Seconds 5
        }
        Write-Host "Network capture on $serverName completed."
    } -ArgumentList $server, $runTimeMinutes, $logDirectory
    $jobs += $job
}

Write-Host "Waiting for all network captures to complete..."
Wait-Job -Job $jobs | Out-Null
Write-Host "All network captures completed."
