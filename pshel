#!/bin/bash
# ════════════════════════════════════════════════════════════════════════════════
# db2_ecm_health_check_v2.sh
# IBM FileNet / ECM 8.7.4 + Db2 LUW Health Check — Three-Expert Edition
#
# Expert perspectives woven throughout:
#   [DB2]  Db2 LUW DBA — config, tuning, storage, HA
#   [ECM]  IBM ECM 8.7.4 specialist — schema patterns, workload, known pain points
#   [PE]   Prompt Engineer — structures output for maximum Claude reasoning quality
#
# Output files:
#   db2_ecm_health_report.txt   — full raw data report
#   claude_ecm_prompt.md        — structured prompt to paste into Claude
#   verification_report.txt     — three-expert verification checklist
#
# Requirements: Run as Db2 instance owner (or user with SYSMON/SYSCTRL authority)
# Tested against: Db2 LUW 11.5.x, RHEL 8.x, FileNet P8 / ECM 8.7.4
# ════════════════════════════════════════════════════════════════════════════════

set -uo pipefail

# ── Output files ─────────────────────────────────────────────────────────────
REPORT="db2_ecm_health_report.txt"
PROMPT_MD="claude_ecm_prompt.md"
VERIFY="verification_report.txt"
RUN_TS=$(date '+%Y-%m-%d_%H%M%S')

> "$REPORT"
> "$PROMPT_MD"
> "$VERIFY"

# ── Logging helpers ───────────────────────────────────────────────────────────
log()    { echo "$*" >> "$REPORT"; }
section(){ echo "" >> "$REPORT"; echo "══════════════════════════════════════════════════════════" >> "$REPORT"; echo "  $*" >> "$REPORT"; echo "══════════════════════════════════════════════════════════" >> "$REPORT"; }
subsect(){ echo "" >> "$REPORT"; echo "--- $* ---" >> "$REPORT"; }
blankln(){ echo "" >> "$REPORT"; }

# ── Pass/Fail table helper ────────────────────────────────────────────────────
# Usage: pstatus "Label" "Pass|Fail|Warning|Partial|Unknown" "Critical|High|Medium|Low" "Comment"
pstatus() {
  printf "%-45s | %-8s | %-8s | %s\n" "$1" "$2" "$3" "$4" >> "$REPORT"
}

# ── Safe integer test ─────────────────────────────────────────────────────────
is_int() { [[ "$1" =~ ^[0-9]+$ ]]; }
is_num() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; }

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 0 — HEADER
# ════════════════════════════════════════════════════════════════════════════════
section "Db2 + IBM ECM 8.7.4 Health Check Report"
log "Run timestamp : $RUN_TS"
log "Hostname      : $(hostname)"
log "OS            : $(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"' || uname -r)"
log "Run user      : $(whoami)"
log "Script version: db2_ecm_health_check_v2.sh"
blankln

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 1 — ENVIRONMENT & Db2 AVAILABILITY
# [DB2] Source profile correctly — tilde must expand via $HOME not literal ~/
# ════════════════════════════════════════════════════════════════════════════════
section "1. Environment & Db2 Availability"

PROFILE_SOURCED=false
for prof in \
    "$HOME/sqllib/db2profile" \
    "/home/db2inst1/sqllib/db2profile" \
    "/home/db2inst2/sqllib/db2profile" \
    "/opt/ibm/db2/V11.5/db2profile" \
    "/opt/ibm/db2/V11.1/db2profile"; do
  if [ -f "$prof" ]; then
    log "Sourcing Db2 profile: $prof"
    # shellcheck source=/dev/null
    . "$prof" 2>/dev/null && PROFILE_SOURCED=true
    break
  fi
done

if ! $PROFILE_SOURCED; then
  log "WARNING: No db2profile found. Db2 commands may fail."
fi

if ! which db2 >/dev/null 2>&1; then
  log "CRITICAL: 'db2' not in PATH. Exiting."
  exit 1
fi

subsect "Db2 Version"
db2level 2>&1 | head -12 >> "$REPORT"
blankln

# [DB2] Instance-level config — critical for connection pooling, parallelism, memory ceiling
subsect "Database Manager Config (Instance Level)"
db2 get dbm cfg 2>&1 | grep -iE \
  'MAX_CONNECTIONS|MAX_COORDAGENTS|INTRA_PARALLEL|ASLHEAPSZ|SVCENAME|SHEAPTHRES|'\
'SHEAPTHRES_SHR|FCM_NUM_BUFFERS|FCM_NUM_CHANNELS|AUTHENTICATION|SYSADM_GROUP|'\
'DB2COMM|INDEXREC|HEALTH_MON|NUM_INITAGENTS|NUM_POOLAGENTS|MAXAGENTS|'\
'RESYNC_INTERVAL|SPM_NAME|TRUST_ALLCLNTS|TRUST_CLNTAUTH' >> "$REPORT" 2>&1
blankln

# [DB2] OS-level memory and swap — critical given observed 100% swap anomaly
subsect "OS Memory & Swap"
free -h 2>&1 >> "$REPORT" || log "(free command unavailable)"
cat /proc/meminfo 2>/dev/null | grep -iE 'MemTotal|MemFree|MemAvailable|SwapTotal|SwapFree|Hugepage|AnonHugePages' >> "$REPORT" || true
blankln

subsect "Transparent Huge Pages (THP) Status"
# [DB2] IBM mandates THP=never for Db2 on Linux. ECM compound it further with high lock table usage.
cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null >> "$REPORT" || log "(THP status unavailable)"
blankln

subsect "Db2 IPC / Shared Memory Segments"
ipcs -m 2>/dev/null | head -20 >> "$REPORT" || log "(ipcs unavailable)"
blankln

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 2 — DATABASE DISCOVERY
# ════════════════════════════════════════════════════════════════════════════════
section "2. Database Discovery"

db2 list database directory 2>&1 >> "$REPORT"
DBS=$(db2 list database directory 2>/dev/null | grep -i "Database name" | awk '{print $4}' | sort)

if [ -z "$DBS" ]; then
  log "FATAL: No databases detected. Cannot continue."
  exit 1
fi

log "Databases found: $DBS"
blankln

# ════════════════════════════════════════════════════════════════════════════════
# HELPER — LOGFILSIZ recommendation based on DB used size
# [DB2] Sized for ECM 8.7.4: metadata-heavy, high-frequency small transactions,
#       workflow engine, document ingestion bursts, no row deletes (append-only pattern)
# ════════════════════════════════════════════════════════════════════════════════
suggest_logfilsiz() {
  # Returns recommended LOGFILSIZ in 4KB pages
  # ECM workload inflates log pressure: add 25% buffer vs generic Db2 guidance
  local gb="$1"
  is_num "$gb" || { echo "0"; return; }
  awk -v g="$gb" 'BEGIN {
    if      (g <  50)  print 81920;   # ~320 MB: small ECM object stores
    else if (g < 150)  print 163840;  # ~640 MB: mid-size
    else if (g < 300)  print 262144;  # ~1 GB:   large metadata stores
    else if (g < 600)  print 393216;  # ~1.5 GB: very large / multi-OS stores
    else               print 524288;  # ~2 GB:   enterprise / consolidated stores
  }'
}

suggest_logprimary() {
  # ECM: LOGPRIMARY * LOGFILSIZ should cover peak ingestion burst (~2x average)
  local gb="$1"
  is_num "$gb" || { echo "0"; return; }
  awk -v g="$gb" 'BEGIN {
    if      (g <  50)  print 13;
    else if (g < 150)  print 16;
    else if (g < 300)  print 20;
    else if (g < 600)  print 25;
    else               print 30;
  }'
}

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 3 — PER-DATABASE COLLECTION
# ════════════════════════════════════════════════════════════════════════════════

# Tracking variables for pass/fail and prompt summary
declare -A DB_USED_GB
declare -A DB_TOTAL_GB
declare -A DB_LOGFILSIZ
declare -A DB_LOGPRIMARY
declare -A DB_LOGSECOND
declare -A DB_LOGARCHMETH1
declare -A DB_LOGARCHMETH2
declare -A DB_LOGARCHCOMPR
declare -A DB_TRACKMOD
declare -A DB_HADR_SYNC
declare -A DB_STMM
declare -A DB_AUTOCOLLECT_STATS
declare -A DB_LOG_USED_KB
declare -A DB_LOG_AVAIL_KB
declare -A DB_LOCKTIMEOUT
declare -A DB_DEADLOCK_CHK
declare -A DB_LOCKLIST
declare -A DB_MAXLOCKS
declare -A DB_LAST_BACKUP
declare -A DB_REORG_PENDING_COUNT
declare -A DB_LOCK_WAITS
declare -A DB_CONNECT_COUNT
declare -A DB_LONG_TXN_COUNT
declare -A DB_ECM_SCHEMAS

for DB in $DBS; do

  section "Database: $DB"

  db2 connect to "$DB" >> "$REPORT" 2>&1
  rc=$?
  if [ $rc -ne 0 ]; then
    log "CONNECT FAILED (rc=$rc) — skipping $DB"
    continue
  fi

  # ── 3a. Database configuration ────────────────────────────────────────────
  subsect "Database Config (db cfg)"
  # [DB2] All parameters relevant to ECM production: logging, HA, maintenance, memory, locking
  db2 get db cfg for "$DB" 2>&1 | grep -iE \
    'LOGFILSIZ|LOGPRIMARY|LOGSECOND|LOGARCHMETH|LOGARCHCOMPR|FAILARCHPATH|'\
'LOGPATH|NEWLOGPATH|MIRRORLOGPATH|HADR_DB_ROLE|HADR_LOCAL|HADR_REMOTE|'\
'HADR_SYNC_MODE|HADR_TIMEOUT|HADR_PEER_WINDOW|AUTO_MAINT|AUTO_DB_BACKUP|'\
'AUTO_TBL_MAINT|AUTO_RUNSTATS|AUTO_REORG|TRACKMOD|SELF_TUNING_MEM|'\
'DATABASE_MEMORY|SHEAPTHRES_SHR|LOCKTIMEOUT|DLCHKTIME|LOCKLIST|MAXLOCKS|'\
'REC_HIS_RETENTN|AUTO_DEL_REC_OBJ|NUM_LOG_SPAN|SOFTMAX|MINCOMMIT|'\
'CHNGPGS_THRESH|LOGINDEXBUILD|STAT_HEAP_SZ|CATALOGCACHE_SZ|'\
'PCKCACHESZ|STMTHEAP|APPLHEAPSZ|SEQDETECT|DFT_DEGREE|'\
'DBHEAP|CATALOGCACHE_SZ|UTIL_HEAP_SZ' >> "$REPORT" 2>&1
  blankln

  # Capture key values for pass/fail tracking
  _logfilsiz=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Log file size" | awk '{print $NF}')
  _logprimary=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Number of primary log files" | awk '{print $NF}')
  _logsecond=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Number of secondary log files" | awk '{print $NF}')
  _archmeth1=$(db2 get db cfg for "$DB" 2>/dev/null | grep "LOGARCHMETH1" | awk '{print $NF}')
  _archmeth2=$(db2 get db cfg for "$DB" 2>/dev/null | grep "LOGARCHMETH2" | awk '{print $NF}')
  _archcompr=$(db2 get db cfg for "$DB" 2>/dev/null | grep "LOGARCHCOMPR1" | awk '{print $NF}')
  _trackmod=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Track modified pages" | awk '{print $NF}')
  _hadr_sync=$(db2 get db cfg for "$DB" 2>/dev/null | grep "HADR_SYNC_MODE" | awk '{print $NF}')
  _stmm=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Self tuning memory" | awk '{print $NF}')
  _locktimeout=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Lock timeout" | awk '{print $NF}')
  _dlchktime=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Changed pages threshold" | awk '{print $NF}' || echo "UNKNOWN")
  _locklist=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Max storage for lock list" | awk '{print $NF}')
  _maxlocks=$(db2 get db cfg for "$DB" 2>/dev/null | grep "Percent. of lock lists per application" | awk '{print $NF}')
  _autocollect=$(db2 get db cfg for "$DB" 2>/dev/null | grep "AUTO_RUNSTATS" | awk '{print $NF}')

  DB_LOGFILSIZ[$DB]="${_logfilsiz:-UNKNOWN}"
  DB_LOGPRIMARY[$DB]="${_logprimary:-UNKNOWN}"
  DB_LOGSECOND[$DB]="${_logsecond:-UNKNOWN}"
  DB_LOGARCHMETH1[$DB]="${_archmeth1:-UNKNOWN}"
  DB_LOGARCHMETH2[$DB]="${_archmeth2:-UNKNOWN}"
  DB_LOGARCHCOMPR[$DB]="${_archcompr:-UNKNOWN}"
  DB_TRACKMOD[$DB]="${_trackmod:-UNKNOWN}"
  DB_HADR_SYNC[$DB]="${_hadr_sync:-NOT_CONFIGURED}"
  DB_STMM[$DB]="${_stmm:-UNKNOWN}"
  DB_LOCKTIMEOUT[$DB]="${_locktimeout:-UNKNOWN}"
  DB_LOCKLIST[$DB]="${_locklist:-UNKNOWN}"
  DB_MAXLOCKS[$DB]="${_maxlocks:-UNKNOWN}"
  DB_AUTOCOLLECT_STATS[$DB]="${_autocollect:-UNKNOWN}"

  # ── 3b. Storage sizing ────────────────────────────────────────────────────
  subsect "Database Size (MON_GET_TABLESPACE)"
  db2 -x "SELECT 
    TBSP_NAME,
    TBSP_TYPE,
    TBSP_CONTENT_TYPE,
    TBSP_STATE,
    ROUND(TBSP_TOTAL_SIZE_KB/1024.0/1024.0, 2) AS total_gb,
    ROUND(TBSP_USED_SIZE_KB/1024.0/1024.0, 2)  AS used_gb,
    ROUND((TBSP_TOTAL_SIZE_KB - TBSP_USED_SIZE_KB)/1024.0/1024.0, 2) AS free_gb,
    ROUND((TBSP_TOTAL_SIZE_KB - TBSP_USED_SIZE_KB) * 100.0 / TBSP_TOTAL_SIZE_KB, 1) AS free_pct,
    TBSP_AUTO_RESIZE_ENABLED,
    TBSP_MAX_SIZE
  FROM TABLE(MON_GET_TABLESPACE(NULL, -2))
  ORDER BY total_gb DESC" >> "$REPORT" 2>&1

  subsect "Database Totals"
  db2 -x "SELECT 
    ROUND(SUM(TBSP_TOTAL_SIZE_KB)/1024.0/1024.0, 2) AS total_allocated_gb,
    ROUND(SUM(TBSP_USED_SIZE_KB)/1024.0/1024.0, 2)  AS total_used_gb
  FROM TABLE(MON_GET_TABLESPACE(NULL, -2))" >> "$REPORT" 2>&1

  # Extract scalars for downstream logic — use awk on column position to avoid alias/grep fragility
  _used_gb=$(db2 -x "SELECT CHAR(ROUND(SUM(TBSP_USED_SIZE_KB)/1024.0/1024.0,2)) FROM TABLE(MON_GET_TABLESPACE(NULL,-2))" 2>/dev/null | awk 'NR==1{gsub(/[^0-9.]/,"",$1); if($1~/^[0-9]/) print $1}')
  _total_gb=$(db2 -x "SELECT CHAR(ROUND(SUM(TBSP_TOTAL_SIZE_KB)/1024.0/1024.0,2)) FROM TABLE(MON_GET_TABLESPACE(NULL,-2))" 2>/dev/null | awk 'NR==1{gsub(/[^0-9.]/,"",$1); if($1~/^[0-9]/) print $1}')
  DB_USED_GB[$DB]="${_used_gb:-UNKNOWN}"
  DB_TOTAL_GB[$DB]="${_total_gb:-UNKNOWN}"

  log "Captured: used=${DB_USED_GB[$DB]} GB, total=${DB_TOTAL_GB[$DB]} GB"

  # ── 3c. Tablespace fragmentation (high free space = reorg candidate) ─────
  subsect "Tablespaces with >20% Free Space (Reorg / Over-allocation Candidates)"
  # [ECM] ECM never deletes rows — tablespaces accumulate pseudo-free space after
  # workflow completions and document soft-deletes. This identifies reorg candidates.
  db2 -x "SELECT 
    TBSP_NAME,
    ROUND(TBSP_USED_SIZE_KB/1024.0/1024.0,2)  AS used_gb,
    ROUND((TBSP_TOTAL_SIZE_KB - TBSP_USED_SIZE_KB)/1024.0/1024.0,2) AS free_gb,
    ROUND((TBSP_TOTAL_SIZE_KB - TBSP_USED_SIZE_KB)*100.0/TBSP_TOTAL_SIZE_KB,1) AS free_pct
  FROM TABLE(MON_GET_TABLESPACE(NULL,-2))
  WHERE TBSP_TOTAL_SIZE_KB > 0
    AND (TBSP_TOTAL_SIZE_KB - TBSP_USED_SIZE_KB)*100.0/TBSP_TOTAL_SIZE_KB > 20
  ORDER BY free_pct DESC" >> "$REPORT" 2>&1
  blankln

  # ── 3d. Top tables by physical size ──────────────────────────────────────
  subsect "Top 15 Largest Tables (Physical Size)"
  # [ECM] Watch for: DOCVERSION, OBJECT, QUEUEITEM, ROSIDMAP, SYNCTARGET, 
  #       AUDIT_*, workflow roster tables — these grow unboundedly in ECM 8.7.4
  db2 -x "SELECT 
    TABSCHEMA,
    TABNAME,
    CARD AS row_count,
    ROUND((DATA_OBJECT_P_SIZE + INDEX_OBJECT_P_SIZE + LONG_OBJECT_P_SIZE +
           LOB_OBJECT_P_SIZE + XML_OBJECT_P_SIZE)/1024.0/1024.0, 3) AS total_gb,
    ROUND(DATA_OBJECT_P_SIZE/1024.0/1024.0, 3)  AS data_gb,
    ROUND(INDEX_OBJECT_P_SIZE/1024.0/1024.0, 3) AS idx_gb,
    REORG_PENDING
  FROM SYSIBMADM.ADMINTABINFO
  WHERE TABSCHEMA NOT LIKE 'SYS%'
  ORDER BY total_gb DESC
  FETCH FIRST 15 ROWS ONLY" >> "$REPORT" 2>&1
  blankln

  # ── 3e. Reorg pending tables ──────────────────────────────────────────────
  subsect "Tables with REORG_PENDING = YES"
  # [ECM] ECM's append-only pattern causes index splits and overflow pages over time.
  # Reorg_pending tables cause query plan degradation — optimizer can't use those indexes reliably.
  _reorg_count=$(db2 -x "SELECT COUNT(*) FROM SYSIBMADM.ADMINTABINFO WHERE REORG_PENDING='Y' AND TABSCHEMA NOT LIKE 'SYS%'" 2>/dev/null | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_REORG_PENDING_COUNT[$DB]="${_reorg_count:-0}"
  log "Tables with REORG_PENDING: ${DB_REORG_PENDING_COUNT[$DB]}"
  db2 -x "SELECT TABSCHEMA, TABNAME, CARD, REORG_PENDING 
    FROM SYSIBMADM.ADMINTABINFO 
    WHERE REORG_PENDING='Y' AND TABSCHEMA NOT LIKE 'SYS%'
    ORDER BY CARD DESC" >> "$REPORT" 2>&1
  blankln

  # ── 3f. Transaction log utilization ──────────────────────────────────────
  subsect "Transaction Log Status (MON_GET_TRANSACTION_LOG)"
  # [DB2] The most critical real-time check: active log space + HADR log gap.
  # ECM ingestion bursts can exhaust active logs in minutes if undersized.
  db2 -x "SELECT 
    TOTAL_LOG_USED_KB,
    TOTAL_LOG_AVAILABLE_KB,
    ROUND(TOTAL_LOG_USED_KB * 100.0 / NULLIF(TOTAL_LOG_USED_KB + TOTAL_LOG_AVAILABLE_KB, 0), 1) AS log_used_pct,
    NUM_LOG_SPAN,
    LOG_HADR_WAITS_TOTAL,
    LOG_HADR_WAIT_TIME,
    CURRENT_ACTIVE_LOG,
    APPLID_HOLDING_OLDEST_XACT
  FROM TABLE(MON_GET_TRANSACTION_LOG(-2))" >> "$REPORT" 2>&1

  _log_used=$(db2 -x "SELECT CHAR(TOTAL_LOG_USED_KB) FROM TABLE(MON_GET_TRANSACTION_LOG(-2))" 2>/dev/null | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  _log_avail=$(db2 -x "SELECT CHAR(TOTAL_LOG_AVAILABLE_KB) FROM TABLE(MON_GET_TRANSACTION_LOG(-2))" 2>/dev/null | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_LOG_USED_KB[$DB]="${_log_used:-0}"
  DB_LOG_AVAIL_KB[$DB]="${_log_avail:-0}"
  blankln

  # ── 3g. Lock activity ─────────────────────────────────────────────────────
  subsect "Current Lock Waits (MON_GET_APPL_LOCKWAIT)"
  # [ECM] Lock waits are the #1 performance killer in ECM. FileNet P8 uses
  # optimistic locking at application level but Db2 row-level locks still contend
  # heavily on DOCVERSION and workflow QUEUEITEM tables during batch ingestion.
  db2 -x "SELECT 
    AGENT_ID,
    LOCK_OBJECT_TYPE,
    LOCK_MODE,
    LOCK_MODE_REQUESTED,
    LOCK_WAIT_ELAPSED_TIME,
    LOCK_STATUS,
    SUBSTR(LOCK_NAME,1,20) AS lock_name_short
  FROM TABLE(MON_GET_APPL_LOCKWAIT(NULL,-2))
  ORDER BY LOCK_WAIT_ELAPSED_TIME DESC
  FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1

  _lock_waits=$(db2 -x "SELECT CHAR(COUNT(*)) FROM TABLE(MON_GET_APPL_LOCKWAIT(NULL,-2))" 2>/dev/null | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_LOCK_WAITS[$DB]="${_lock_waits:-0}"
  blankln

  # ── 3h. Long-running transactions ────────────────────────────────────────
  subsect "Long-Running Transactions (>60 seconds)"
  # [ECM] A hung ECM workflow step or failed Content Engine call can hold open
  # transactions indefinitely, blocking log archiving and HADR log shipping.
  db2 -x "SELECT 
    APPLICATION_HANDLE,
    SUBSTR(APPLICATION_NAME,1,30) AS app_name,
    SUBSTR(CLIENT_HOSTNAME,1,20) AS client_host,
    UOW_ELAPSED_TIME_US / 1000000 AS elapsed_sec,
    ROWS_MODIFIED,
    ISOLATION_LEVEL,
    LOCK_TIMEOUT_VAL
  FROM TABLE(MON_GET_UNIT_OF_WORK(NULL,-2))
  WHERE UOW_ELAPSED_TIME_US > 60000000
  ORDER BY UOW_ELAPSED_TIME_US DESC" >> "$REPORT" 2>&1

  _long_txn=$(db2 -x "SELECT CHAR(COUNT(*)) FROM TABLE(MON_GET_UNIT_OF_WORK(NULL,-2)) WHERE UOW_ELAPSED_TIME_US > 60000000" 2>/dev/null | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_LONG_TXN_COUNT[$DB]="${_long_txn:-0}"
  blankln

  # ── 3i. Active connections ────────────────────────────────────────────────
  subsect "Active Connections by Application"
  # [ECM] FileNet P8 CE uses JDBC connection pools. Saturated pools cause
  # "connection refused" errors in ECM admin console. JNDI pool exhaustion
  # appears as rapid connect/disconnect cycling here.
  db2 -x "SELECT 
    SUBSTR(APPLICATION_NAME,1,35) AS app_name,
    COUNT(*) AS conn_count,
    SUM(ROWS_READ) AS total_rows_read,
    SUM(ROWS_MODIFIED) AS total_rows_modified
  FROM TABLE(MON_GET_CONNECTION(NULL,-2))
  GROUP BY APPLICATION_NAME
  ORDER BY conn_count DESC
  FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1

  _total_conns=$(db2 -x "SELECT CHAR(COUNT(*)) FROM TABLE(MON_GET_CONNECTION(NULL,-2))" 2>/dev/null | awk 'NR==1{gsub(/[^0-9]/,"",$1); print $1+0}')
  DB_CONNECT_COUNT[$DB]="${_total_conns:-0}"
  blankln

  # ── 3j. Top SQL by execution time ────────────────────────────────────────
  subsect "Top 10 SQL Statements by Total Execution Time (Package Cache)"
  # [ECM] ECM 8.7.4 generates heavy repeated queries against DOCVERSION, OBJECT,
  # and QUEUEITEM. Slow SQL here directly maps to ECM user latency.
  db2 -x "SELECT 
    ROUND(TOTAL_EXEC_TIME/1000.0, 2)   AS total_exec_ms,
    NUM_EXECUTIONS,
    ROUND(AVG_EXEC_TIME/1000.0, 2)    AS avg_exec_ms,
    ROWS_RETURNED,
    STMT_SORTS,
    SUBSTR(STMT_TEXT,1,120)            AS sql_snippet
  FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL,NULL,NULL,-2))
  WHERE STMT_TYPE_ID = 5
  ORDER BY TOTAL_EXEC_TIME DESC
  FETCH FIRST 10 ROWS ONLY" >> "$REPORT" 2>&1
  blankln

  # ── 3k. Statistics health ─────────────────────────────────────────────────
  subsect "Tables with Stale Statistics (STATS_TIME > 7 days or never collected)"
  # [ECM] Auto-runstats may lag on very large ECM tables. Stale stats cause
  # optimizer to choose nested-loop over hash join on DOCVERSION joins — catastrophic.
  db2 -x "SELECT 
    TABSCHEMA,
    TABNAME,
    CARD,
    DATE(STATS_TIME) AS last_stats_date,
    DAYS(CURRENT_DATE) - DAYS(STATS_TIME) AS days_since_stats
  FROM SYSCAT.TABLES
  WHERE TABSCHEMA NOT LIKE 'SYS%'
    AND TYPE = 'T'
    AND (STATS_TIME IS NULL OR STATS_TIME < CURRENT_TIMESTAMP - 7 DAYS)
    AND CARD > 100000
  ORDER BY CARD DESC
  FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1
  blankln

  # ── 3l. ECM Schema detection ──────────────────────────────────────────────
  subsect "ECM Schema Detection"
  # [ECM] Known ECM 8.7.4 schemas: GCD DB owner, object store schema(s), 
  # workflow schema, ICMADMIN for legacy, FNBODY (deprecated in 8.7), 
  # XDMS (if using extended document management)
  db2 -x "SELECT SCHEMANAME, COUNT(*) AS table_count
    FROM SYSCAT.TABLES
    WHERE TYPE = 'T'
    GROUP BY SCHEMANAME
    ORDER BY table_count DESC
    FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1

  _ecm_schemas=$(db2 -x "SELECT LISTAGG(SCHEMANAME, ',') WITHIN GROUP (ORDER BY SCHEMANAME) FROM (
    SELECT DISTINCT SCHEMANAME FROM SYSCAT.TABLES WHERE TYPE='T' AND SCHEMANAME NOT LIKE 'SYS%'
    FETCH FIRST 30 ROWS ONLY)" 2>/dev/null | awk 'NR==1{print $0}')
  DB_ECM_SCHEMAS[$DB]="${_ecm_schemas:-UNKNOWN}"
  blankln

  # ── 3m. Index health ──────────────────────────────────────────────────────
  subsect "Indexes with High CLUSTERRATIO Issues (<80% cluster) on Large Tables"
  # [ECM] ECM 8.7.4 queries use range scans on DOCVERSION (by date, class, folder).
  # Low cluster ratio forces random I/O, magnifying latency for document retrieval.
  db2 -x "SELECT 
    I.TABSCHEMA,
    I.TABNAME,
    I.INDNAME,
    I.CLUSTERRATIO,
    I.FULLKEYCARD,
    T.CARD AS table_rows
  FROM SYSCAT.INDEXES I
  JOIN SYSCAT.TABLES T ON I.TABSCHEMA=T.TABSCHEMA AND I.TABNAME=T.TABNAME
  WHERE I.TABSCHEMA NOT LIKE 'SYS%'
    AND T.CARD > 500000
    AND I.CLUSTERRATIO < 80
    AND I.CLUSTERRATIO >= 0
  ORDER BY T.CARD DESC
  FETCH FIRST 20 ROWS ONLY" >> "$REPORT" 2>&1
  blankln

  # ── 3n. Backup history ────────────────────────────────────────────────────
  subsect "Backup History (Last 7 Days)"
  # [DB2] ECM 8.7.4 is not tolerant of data loss — GCD is single point of truth
  # for all object store metadata. Missed backups are a Critical finding.
  db2 "LIST HISTORY BACKUP ALL FOR $DB" 2>&1 | grep -E "Backup|Start|End|Type|Status|Location" | tail -50 >> "$REPORT"

  _last_backup=$(db2 "LIST HISTORY BACKUP ALL FOR $DB" 2>/dev/null | grep "Start Time" | tail -1 | awk '{print $NF}' || echo "UNKNOWN")
  DB_LAST_BACKUP[$DB]="${_last_backup:-UNKNOWN}"
  blankln

  # ── 3o. HADR status ───────────────────────────────────────────────────────
  subsect "HADR Status Detail"
  # [DB2+ECM] NEARSYNC is the correct mode for ECM — SYNC adds latency to every
  # CE write commit. ASYNC risks data loss on failover which is unacceptable
  # for ECM metadata consistency.
  db2 get snapshot for database on "$DB" 2>/dev/null | \
    grep -iE 'HADR|Standby|Primary|Log gap|Sync' >> "$REPORT" || \
    log "(Snapshot unavailable — try: db2pd -hadr -db $DB)"
  db2pd -hadr -db "$DB" 2>/dev/null | head -40 >> "$REPORT" || true
  blankln

  # ── 3p. Self-tuning memory detail ────────────────────────────────────────
  subsect "Current Memory Pool Sizes (db2pd)"
  # [DB2] STMM + swap anomaly: if SHEAPTHRES_SHR is unset or set too high,
  # Db2 can allocate more shared memory than physical RAM, forcing OS swap.
  # This is the likely cause of 100% swap with 24 GB free RAM.
  db2pd -memsets -db "$DB" 2>/dev/null | head -60 >> "$REPORT" || \
    log "(db2pd -memsets unavailable)"
  blankln

  db2 terminate >/dev/null 2>&1

done  # end per-database loop

# ════════════════════════════════════════════════════════════════════════════════
# SECTION 4 — PASS / FAIL / WARNING SUMMARY TABLE
# [PE] Structured machine-readable verdicts that Claude uses as reference anchors,
#      but is instructed to validate rather than blindly accept.
# ════════════════════════════════════════════════════════════════════════════════
section "4. Pass / Fail / Warning Summary Table"

printf "%-45s | %-8s | %-8s | %s\n" "Check Item" "Status" "Severity" "Comment" >> "$REPORT"
printf "%-45s | %-8s | %-8s | %s\n" "---------------------------------------------" "--------" "--------" "-------" >> "$REPORT"

# ── OS / Environment ─────────────────────────────────────────────────────────
thp=$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || echo "unknown")
if echo "$thp" | grep -q '\[never\]'; then
  pstatus "Transparent Huge Pages" "Pass" "Low" "THP=never (correct for Db2)"
else
  pstatus "Transparent Huge Pages" "Fail" "High" "THP not set to never — IBM mandate for Db2+ECM. Current: $thp"
fi

swap_total=$(grep SwapTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
swap_free=$(grep SwapFree /proc/meminfo 2>/dev/null | awk '{print $2}')
if is_int "${swap_total:-0}" && is_int "${swap_free:-0}" && [ "${swap_total:-0}" -gt 0 ]; then
  swap_used_pct=$(awk "BEGIN{printf \"%.0f\", (${swap_total}-${swap_free})*100/${swap_total}}")
  if [ "$swap_used_pct" -gt 90 ]; then
    pstatus "OS Swap Usage" "Fail" "Critical" "${swap_used_pct}% swap in use — likely Db2 STMM/SHEAPTHRES_SHR misconfiguration"
  elif [ "$swap_used_pct" -gt 50 ]; then
    pstatus "OS Swap Usage" "Warning" "High" "${swap_used_pct}% swap in use — investigate Db2 memory config"
  else
    pstatus "OS Swap Usage" "Pass" "Low" "${swap_used_pct}% swap used"
  fi
else
  pstatus "OS Swap Usage" "Unknown" "High" "Could not determine swap usage"
fi

# ── Per-database checks ───────────────────────────────────────────────────────
for DB in $DBS; do

  used="${DB_USED_GB[$DB]:-UNKNOWN}"
  sug_logfilsiz="0"
  sug_logprimary="0"
  if is_num "$used"; then
    sug_logfilsiz=$(suggest_logfilsiz "$used")
    sug_logprimary=$(suggest_logprimary "$used")
  fi

  # Log file size
  cur_filsiz="${DB_LOGFILSIZ[$DB]:-0}"
  if is_int "$cur_filsiz" && is_int "$sug_logfilsiz" && [ "$sug_logfilsiz" -gt 0 ]; then
    if [ "$cur_filsiz" -ge "$sug_logfilsiz" ]; then
      pstatus "[$DB] LOGFILSIZ" "Pass" "Low" "Current $cur_filsiz >= ECM-suggested $sug_logfilsiz pages"
    elif [ "$cur_filsiz" -ge $((sug_logfilsiz * 6 / 10)) ]; then
      pstatus "[$DB] LOGFILSIZ" "Warning" "Medium" "Current $cur_filsiz — ECM suggests $sug_logfilsiz pages; upgrade during window"
    else
      pstatus "[$DB] LOGFILSIZ" "Fail" "High" "Current $cur_filsiz pages — ECM requires ~$sug_logfilsiz; risk of log-full on ingestion burst"
    fi
  else
    pstatus "[$DB] LOGFILSIZ" "Unknown" "High" "Could not determine (cur=$cur_filsiz, sug=$sug_logfilsiz)"
  fi

  # Primary log count
  cur_primary="${DB_LOGPRIMARY[$DB]:-0}"
  if is_int "$cur_primary" && is_int "$sug_logprimary" && [ "$sug_logprimary" -gt 0 ]; then
    if [ "$cur_primary" -ge "$sug_logprimary" ]; then
      pstatus "[$DB] LOGPRIMARY" "Pass" "Low" "Current $cur_primary >= ECM-suggested $sug_logprimary"
    else
      pstatus "[$DB] LOGPRIMARY" "Warning" "Medium" "Current $cur_primary — ECM suggests $sug_logprimary for burst headroom"
    fi
  else
    pstatus "[$DB] LOGPRIMARY" "Unknown" "Medium" "cur=$cur_primary sug=$sug_logprimary"
  fi

  # Log archive method 1
  am1="${DB_LOGARCHMETH1[$DB]:-UNKNOWN}"
  if echo "$am1" | grep -qiE 'DISK:|VENDOR:|TSM:'; then
    pstatus "[$DB] LOGARCHMETH1" "Pass" "Low" "Archive configured: $am1"
  else
    pstatus "[$DB] LOGARCHMETH1" "Fail" "Critical" "Log archiving NOT configured ($am1) — ECM backup/recovery broken"
  fi

  # Log archive method 2 (dual path)
  am2="${DB_LOGARCHMETH2[$DB]:-UNKNOWN}"
  if echo "$am2" | grep -qiE 'DISK:|VENDOR:|TSM:'; then
    pstatus "[$DB] LOGARCHMETH2" "Pass" "Low" "Dual archive: $am2"
  elif echo "$am1" | grep -qiE 'DISK:|VENDOR:|TSM:'; then
    pstatus "[$DB] LOGARCHMETH2" "Warning" "High" "No dual path — single NAS failure = log gap, HADR fall-behind, potential data loss"
  else
    pstatus "[$DB] LOGARCHMETH2" "Fail" "Critical" "No archive paths at all"
  fi

  # Log compression
  compr="${DB_LOGARCHCOMPR[$DB]:-UNKNOWN}"
  if echo "$compr" | grep -qi 'ON'; then
    pstatus "[$DB] Log Archive Compression" "Pass" "Low" "LOGARCHCOMPR=ON"
  else
    pstatus "[$DB] Log Archive Compression" "Fail" "Medium" "OFF — ECM log volumes are high; enable to reduce NAS pressure"
  fi

  # TRACKMOD (incremental backups)
  track="${DB_TRACKMOD[$DB]:-UNKNOWN}"
  if echo "$track" | grep -qi 'ON'; then
    pstatus "[$DB] TRACKMOD (Incremental Backup)" "Pass" "Low" "ON"
  else
    pstatus "[$DB] TRACKMOD (Incremental Backup)" "Fail" "Medium" "OFF — ECM backup window 1-6AM only; incrementals reduce NAS I/O"
  fi

  # HADR sync mode
  hadr="${DB_HADR_SYNC[$DB]:-NOT_CONFIGURED}"
  case "$hadr" in
    NEARSYNC) pstatus "[$DB] HADR Sync Mode" "Pass" "Low" "NEARSYNC — correct for ECM (low latency + durability balance)" ;;
    SYNC)     pstatus "[$DB] HADR Sync Mode" "Warning" "Medium" "SYNC — safe but adds commit latency to every ECM write operation" ;;
    ASYNC|SUPERASYNC) pstatus "[$DB] HADR Sync Mode" "Fail" "High" "$hadr — data loss on failover; unacceptable for ECM metadata integrity" ;;
    NOT_CONFIGURED) pstatus "[$DB] HADR Sync Mode" "Unknown" "Medium" "HADR not detected — confirm if HA is via other means" ;;
    *) pstatus "[$DB] HADR Sync Mode" "Unknown" "Medium" "Unexpected value: $hadr" ;;
  esac

  # STMM
  stmm="${DB_STMM[$DB]:-UNKNOWN}"
  if echo "$stmm" | grep -qi 'ON'; then
    pstatus "[$DB] Self-Tuning Memory (STMM)" "Pass" "Low" "ON — but verify SHEAPTHRES_SHR cap given swap anomaly"
  else
    pstatus "[$DB] Self-Tuning Memory (STMM)" "Warning" "Medium" "OFF — manual memory sizing required; risk of imbalance"
  fi

  # Lock timeout
  lto="${DB_LOCKTIMEOUT[$DB]:-UNKNOWN}"
  if [ "$lto" = "-1" ] 2>/dev/null; then
    pstatus "[$DB] Lock Timeout (LOCKTIMEOUT)" "Fail" "High" "-1 (never timeout) — ECM lock waits will cascade; set 30-120 seconds"
  elif is_int "$lto" && [ "$lto" -gt 0 ] && [ "$lto" -le 120 ]; then
    pstatus "[$DB] Lock Timeout (LOCKTIMEOUT)" "Pass" "Low" "${lto}s — within ECM-recommended range (30-120s)"
  elif is_int "$lto" && [ "$lto" -gt 120 ]; then
    pstatus "[$DB] Lock Timeout (LOCKTIMEOUT)" "Warning" "Medium" "${lto}s — too long; ECM users will hang during contention; reduce to 60-90s"
  else
    pstatus "[$DB] Lock Timeout (LOCKTIMEOUT)" "Unknown" "High" "Value: $lto"
  fi

  # Reorg pending
  reorg="${DB_REORG_PENDING_COUNT[$DB]:-0}"
  if [ "$reorg" -eq 0 ] 2>/dev/null; then
    pstatus "[$DB] Reorg Pending Tables" "Pass" "Low" "None detected"
  elif [ "$reorg" -le 5 ] 2>/dev/null; then
    pstatus "[$DB] Reorg Pending Tables" "Warning" "Medium" "$reorg table(s) — schedule REORG during next maintenance window"
  else
    pstatus "[$DB] Reorg Pending Tables" "Fail" "High" "$reorg table(s) — ECM query plans degraded; prioritize REORG + RUNSTATS"
  fi

  # Lock waits
  lw="${DB_LOCK_WAITS[$DB]:-0}"
  if [ "$lw" -eq 0 ] 2>/dev/null; then
    pstatus "[$DB] Current Lock Waits" "Pass" "Low" "None at collection time"
  elif [ "$lw" -le 5 ] 2>/dev/null; then
    pstatus "[$DB] Current Lock Waits" "Warning" "Medium" "$lw active — monitor for ECM workflow contention"
  else
    pstatus "[$DB] Current Lock Waits" "Fail" "High" "$lw active lock waits — likely ECM ingestion or workflow contention in progress"
  fi

  # Long transactions
  lt="${DB_LONG_TXN_COUNT[$DB]:-0}"
  if [ "$lt" -eq 0 ] 2>/dev/null; then
    pstatus "[$DB] Long-Running Transactions (>60s)" "Pass" "Low" "None detected"
  else
    pstatus "[$DB] Long-Running Transactions (>60s)" "Fail" "High" "$lt found — blocking log archival and HADR shipping; investigate immediately"
  fi

  # Auto-runstats
  ar="${DB_AUTOCOLLECT_STATS[$DB]:-UNKNOWN}"
  if echo "$ar" | grep -qi 'ON'; then
    pstatus "[$DB] AUTO_RUNSTATS" "Pass" "Low" "ON"
  else
    pstatus "[$DB] AUTO_RUNSTATS" "Fail" "High" "OFF — ECM query optimizer will use stale stats; enable or schedule manual RUNSTATS"
  fi

  # Log utilization
  lu_kb="${DB_LOG_USED_KB[$DB]:-0}"
  la_kb="${DB_LOG_AVAIL_KB[$DB]:-0}"
  if is_int "$lu_kb" && is_int "$la_kb" && [ $((lu_kb + la_kb)) -gt 0 ]; then
    lu_pct=$(awk "BEGIN{printf \"%.0f\", ${lu_kb}*100/(${lu_kb}+${la_kb})}")
    if [ "$lu_pct" -lt 70 ]; then
      pstatus "[$DB] Active Log Utilization" "Pass" "Low" "${lu_pct}% used"
    elif [ "$lu_pct" -lt 85 ]; then
      pstatus "[$DB] Active Log Utilization" "Warning" "High" "${lu_pct}% used — ECM burst could exhaust; review LOGPRIMARY+LOGSECOND"
    else
      pstatus "[$DB] Active Log Utilization" "Fail" "Critical" "${lu_pct}% used — near log-full; immediate risk of ECM transaction failures"
    fi
  else
    pstatus "[$DB] Active Log Utilization" "Unknown" "High" "Could not determine log utilization"
  fi

  # Backup age
  lb="${DB_LAST_BACKUP[$DB]:-UNKNOWN}"
  pstatus "[$DB] Last Backup Timestamp" "Info" "Review" "Last backup: $lb — verify within 24h window"

  # ECM Schemas detected
  pstatus "[$DB] ECM Schemas Detected" "Info" "Low" "${DB_ECM_SCHEMAS[$DB]:-none detected}"

done

blankln

