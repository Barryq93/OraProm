#!/bin/bash

# This script recursively changes ownership of files and directories
# in a specified directory to the provided user and group.
# It also measures the total time and the time taken for each directory.

# Ensure the script is run with sudo or root privileges
if [[ $EUID -ne 0 ]]; then
    echo "This script must be run as root. Please use sudo."
    exit 1
fi

# Check if the user has provided correct arguments
if [[ $# -ne 2 ]]; then
    echo "Usage: $0 <user:group> <directory>"
    echo "Example: $0 john:developers /path/to/dir"
    exit 1
fi

# Parse arguments
OWNER=$1    # Ownership format: user:group
DIR=$2      # Target directory to process

# Check if the target directory exists
if [[ ! -d $DIR ]]; then
    echo "Error: Directory '$DIR' does not exist."
    exit 1
fi

# Initialize a counter for processed files and directories
PROCESSED_COUNT=0

# Start timer to measure script execution time
START_TIME=$(date +%s)

# Function to process items in a given directory and time each one
process_items() {
    local path=$1
    echo "Starting processing for: $path"
    
    # Record start time for this directory
    DIR_START_TIME=$(date +%s)
    
    # Change ownership of all files and directories under the current directory
    # Increment the counter for each processed item
    find "$path" -mindepth 1 -print0 | xargs -0 -n 1000 -P 8 chown "$OWNER" && ((PROCESSED_COUNT+=1000)) || true
    
    # Record end time for this directory
    DIR_END_TIME=$(date +%s)
    
    # Calculate elapsed time for this directory
    DIR_ELAPSED_TIME=$((DIR_END_TIME - DIR_START_TIME))
    echo "Finished processing for: $path (Time: $DIR_ELAPSED_TIME seconds)"
}

# Change ownership of the root directory itself
echo "Changing ownership of the root directory: $DIR"
chown "$OWNER" "$DIR" && ((PROCESSED_COUNT++))

# Export variables and function for use in subshells
export OWNER
export PROCESSED_COUNT
export -f process_items

# Recursively process all subdirectories and include directories themselves
# `find "$DIR"` locates all subdirectories, including their parents, starting from the root.
# `-type d` ensures only directories are selected.
# `-print0` produces null-separated output for safe handling of directory names with spaces or special characters.
# Each directory is passed to the `process_items` function for processing.
echo "Processing all subdirectories under: $DIR"
find "$DIR" -type d -print0 | xargs -0 -n 1 -P 8 bash -c 'process_items "$@"' _ || true

# Change ownership of all files in the root directory itself (not already done in subdirectories)
echo "Changing ownership of files in the root directory: $DIR"
find "$DIR" -mindepth 1 -maxdepth 1 ! -type d -print0 | xargs -0 -n 1000 -P 8 chown "$OWNER" && ((PROCESSED_COUNT+=1000)) || true

# End timer and calculate total elapsed time
END_TIME=$(date +%s)
TOTAL_ELAPSED_TIME=$((END_TIME - START_TIME))

# Output elapsed time and total files processed
echo "Ownership change completed!"
echo "Total files and directories processed: $PROCESSED_COUNT"
echo "Total elapsed time: $((TOTAL_ELAPSED_TIME / 60)) minutes and $((TOTAL_ELAPSED_TIME % 60)) seconds."