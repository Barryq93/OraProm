<#
.SYNOPSIS
Logs deduped inbound and outbound TCP connections for a hardcoded PID over a 60-minute period.

.DESCRIPTION
This script monitors both inbound and outbound TCP connections associated with a
hardcoded Process ID (PID) for a duration of 60 minutes. The script periodically
samples the connections, dedupes the remote addresses for outbound connections
and the remote endpoints for inbound connections, and logs them separately to
text files with timestamps.

.NOTES
- Requires administrative privileges to run effectively.
- Logs will be saved in the same directory as the script.
- Inbound connections are deduped based on the remote IP:Port.
- Outbound connections are deduped based on the remote IP address.
- **The PID to monitor is hardcoded in the script.**
#>

# --- Configuration ---
$ScriptName = $MyInvocation.MyCommand.Name
$LogDirectory = Split-Path -Path $MyInvocation.MyCommand.Path -Parent
$Timestamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$OutboundLogFile = Join-Path -Path $LogDirectory -ChildPath "$ScriptName-Outbound-HARDCODED-$Timestamp.log"
$InboundLogFile = Join-Path -Path $LogDirectory -ChildPath "$ScriptName-Inbound-HARDCODED-$Timestamp.log"
$MonitoringIntervalSeconds = 10
$MonitoringDurationMinutes = 60
$TotalIterations = ($MonitoringDurationMinutes * 60) / $MonitoringIntervalSeconds
$IterationCount = 0
$LoggedOutboundConnections = [System.Collections.Generic.HashSet[string]]::new()
$LoggedInboundConnections = [System.Collections.Generic.HashSet[string]]::new()

# --- HARDCODED PID ---
$PIDToMonitor = 12345 # Replace 12345 with the actual PID you want to monitor

# --- Validate PID exists ---
try {
    $Process = Get-Process -Id $PIDToMonitor -ErrorAction Stop
    Write-Host "Monitoring process: [$($Process.ProcessName)] (PID: $PIDToMonitor) for $MonitoringDurationMinutes minutes..."
} catch {
    Write-Error "Process with PID $PIDToMonitor not found or inaccessible. Exiting."
    exit 1
}

# --- Initialize Log Files with Header ---
$Header = @"
=== TCP Connection Monitor ===
Start Time: $(Get-Date)
Monitoring PID: $PIDToMonitor
Process Name: $($Process.ProcessName)
Monitoring Interval: $MonitoringIntervalSeconds seconds
Total Duration: $MonitoringDurationMinutes minutes
"@

Add-Content -Path $OutboundLogFile -Value $Header
Add-Content -Path $InboundLogFile -Value $Header

# --- Helper Function to Get Established Connections for a PID ---
function Get-EstablishedProcessConnections {
    param(
        [Parameter(Mandatory=$true)]
        [int]$ProcessId
    )
    
    try {
        Get-NetTCPConnection -State Established -ErrorAction Stop | Where-Object {$_.OwningProcess -eq $ProcessId}
    } catch {
        Write-Warning "Error retrieving TCP connections: $_"
        return $null
    }
}

# --- Helper Function to Get Listening Ports for a PID ---
function Get-ProcessListeningPorts {
    param(
        [Parameter(Mandatory=$true)]
        [int]$ProcessId
    )
    
    try {
        Get-NetTCPConnection -State Listen -ErrorAction Stop | Where-Object {$_.OwningProcess -eq $ProcessId} | 
        Select-Object -ExpandProperty LocalPort -Unique
    } catch {
        Write-Warning "Error retrieving listening ports: $_"
        return @()
    }
}

# --- Helper Function to Log Data with Timestamp ---
function Log-Data {
    param(
        [Parameter(Mandatory=$true)]
        [string]$LogFilePath,
        [Parameter(Mandatory=$true)]
        [string[]]$Data,
        [string]$ConnectionType
    )
    
    if ($Data -and $Data.Count -gt 0) {
        $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        $logEntry = @()
        $logEntry += "`n[$timestamp] New $ConnectionType connections ($($Data.Count)):"
        $logEntry += $Data | Sort-Object -Unique
        Add-Content -Path $LogFilePath -Value $logEntry
    }
}

# --- Monitoring Loop ---
try {
    while ($IterationCount -lt $TotalIterations) {
        $IterationCount++
        $CurrentTime = Get-Date -Format "HH:mm:ss"
        Write-Host "[$CurrentTime] Iteration $IterationCount of $TotalIterations..."

        # --- Get Outbound Connections ---
        $OutboundConnections = Get-EstablishedProcessConnections -ProcessId $PIDToMonitor
        if ($OutboundConnections) {
            $CurrentOutboundRemoteAddresses = $OutboundConnections | 
                Select-Object -ExpandProperty RemoteAddress | 
                Where-Object { $_ -notlike '*::*' } |  # Exclude IPv6 if desired
                Sort-Object -Unique
            
            $NewOutboundConnections = @()
            foreach ($Address in $CurrentOutboundRemoteAddresses) {
                if (-not $LoggedOutboundConnections.Contains($Address)) {
                    $NewOutboundConnections += $Address
                    $null = $LoggedOutboundConnections.Add($Address)
                }
            }
            Log-Data -LogFilePath $OutboundLogFile -Data $NewOutboundConnections -ConnectionType "outbound"
            Write-Host "  Found $($NewOutboundConnections.Count) new outbound remote addresses."
        }

        # --- Get Inbound Connections ---
        $ListeningPorts = Get-ProcessListeningPorts -ProcessId $PIDToMonitor
        if ($ListeningPorts) {
            $CurrentInboundConnections = Get-NetTCPConnection -State Established | 
                Where-Object { $ListeningPorts -contains $_.LocalPort } | 
                Select-Object RemoteAddress, RemotePort | 
                ForEach-Object { "$($_.RemoteAddress):$($_.RemotePort)" } | 
                Sort-Object -Unique
            
            $NewInboundConnections = @()
            foreach ($Endpoint in $CurrentInboundConnections) {
                if (-not $LoggedInboundConnections.Contains($Endpoint)) {
                    $NewInboundConnections += $Endpoint
                    $null = $LoggedInboundConnections.Add($Endpoint)
                }
            }
            Log-Data -LogFilePath $InboundLogFile -Data $NewInboundConnections -ConnectionType "inbound"
            Write-Host "  Found $($NewInboundConnections.Count) new inbound remote endpoints."
        }

        # Add a separator to console output every 5 iterations for better readability
        if ($IterationCount % 5 -eq 0) {
            Write-Host "`n----- [Progress: $($IterationCount * $MonitoringIntervalSeconds / 60) minutes elapsed] -----`n"
        }

        Start-Sleep -Seconds $MonitoringIntervalSeconds
    }
} catch {
    Write-Error "Monitoring error: $_"
} finally {
    # --- Final Summary ---
    $Summary = @"

=== Monitoring Summary ===
End Time: $(Get-Date)
Total Iterations: $IterationCount
Unique Outbound Addresses: $($LoggedOutboundConnections.Count)
Unique Inbound Endpoints: $($LoggedInboundConnections.Count)
"@

    Add-Content -Path $OutboundLogFile -Value $Summary
    Add-Content -Path $InboundLogFile -Value $Summary

    Write-Host "`nMonitoring complete. Logs saved to:"
    Write-Host "  Outbound: '$OutboundLogFile'"
    Write-Host "  Inbound: '$InboundLogFile'"
    Write-Host "`nSummary:"
    Write-Host "  Unique Outbound Addresses: $($LoggedOutboundConnections.Count)"
    Write-Host "  Unique Inbound Endpoints: $($LoggedInboundConnections.Count)"
}