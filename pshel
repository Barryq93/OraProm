_any=0; _cf=0
for DB in $DBS; do
  [ "${DB_CONNECT_STATUS[$DB]:-FAILED}" = "CONNECTED" ] && (( _any++ )) || (( _cf++ )) || true
done
[ "$_any" -gt 0 ] \
  && _chk e PASS "Connects" "$_any / $DB_COUNT connected" \
  || _chk e FAIL "Connects" "ALL failed"
[ "$_cf" -eq 0 ] \
  && _chk e PASS "All DBs connected" "No failures" \
  || _chk e WARN "All DBs connected" "$_cf DB(s) failed — partial data"
_parity=0
for DB in $DBS; do
  tc="${DB_TOTAL_CARD[$DB]:-0}"; is_int "$tc" && [ "$tc" -gt 0 ] && (( _parity++ )) || true
done
[ "$_parity" -ge 2 ] \
  && _chk e PASS "Row parity data" "$_parity DBs have row counts" \
  || _chk e WARN "Row parity data" "Fewer than 2 DBs — parity check limited"
_mts=0
for DB in $DBS; do
  [ "${DB_CONNECT_STATUS[$DB]:-FAILED}" = "CONNECTED" ] || continue
  [ "${DB_BACKUP_TS[$DB]:-UNKNOWN}" = "UNKNOWN" ] && (( _mts++ )) || true
done
[ "$_mts" -eq 0 ] \
  && _chk e PASS "Backup timestamps" "All connected DBs captured" \
  || _chk e WARN "Backup timestamps" "$_mts DB(s) missing timestamp"
grep -qiE 'lssam|IBM\.ResourceManager|rsct' "$REPORT" 2>/dev/null \
  && _chk e PASS "SA MP data" "Present" \
  || _chk e WARN "SA MP data" "Not accessible — RM cluster HA unverifiable"
grep -qiE 'TABNAME|TABSCHEMA' "$REPORT" 2>/dev/null \
  && _chk e PASS "Table names visible" "LLM can classify from names" \
  || _chk e WARN "Table names visible" "Overall mode adds this — weekly uses stats only"
vlog "  ECM Specialist: PASS=$e_p  FAIL=$e_f  WARN=$e_w"

vsect "EXPERT 3: Prompt Engineer"
[ "$PROMPT_SIZE" -gt 1000 ] \
  && _chk p PASS "Prompt generated" "~$((PROMPT_SIZE/1024)) KB" \
  || _chk p FAIL "Prompt generated" "Empty or near-empty"
grep -q 'Classification Taxonomy' "$PROMPT_MD" 2>/dev/null \
  && _chk p PASS "Taxonomy table" "Present" \
  || _chk p FAIL "Taxonomy table" "Missing — LLM has no classification guide"
grep -q 'Architecture' "$PROMPT_MD" 2>/dev/null \
  && _chk p PASS "Architecture context" "Dependency chain present" \
  || _chk p FAIL "Architecture context" "Missing"
grep -q 'Backup Coordination' "$PROMPT_MD" 2>/dev/null \
  && _chk p PASS "Backup coordination rules" "15-min skew rule present" \
  || _chk p FAIL "Backup coordination rules" "Missing"
grep -q 'CORRECTION' "$PROMPT_MD" 2>/dev/null \
  && _chk p PASS "Anti-anchoring" "Validate-not-accept instruction present" \
  || _chk p WARN "Anti-anchoring" "Missing"
if   [ "$PROMPT_SIZE" -lt 60000  ]; then
  _chk p PASS "Prompt size" "~$((PROMPT_SIZE/1024)) KB — fits all models"
elif [ "$PROMPT_SIZE" -lt 100000 ]; then
  _chk p PASS "Prompt size" "~$((PROMPT_SIZE/1024)) KB — GPT-4o / Gemini Pro range"
elif [ "$PROMPT_SIZE" -lt 150000 ]; then
  _chk p WARN "Prompt size" "~$((PROMPT_SIZE/1024)) KB — use Gemini Pro"
else
  _chk p FAIL "Prompt size" "~$((PROMPT_SIZE/1024)) KB — Gemini Pro only"
fi
vlog "  Prompt Engineer: PASS=$p_p  FAIL=$p_f  WARN=$p_w"

vsect "EXPERT 4: RHEL Sysadmin"
rlines=$(wc -l < "$REPORT" 2>/dev/null || echo 0)
[ "$rlines" -gt 50 ] \
  && _chk s PASS "Report content" "$rlines lines" \
  || _chk s FAIL "Report content" "$rlines lines — collection likely failed"
grep -qiE 'MemTotal|SwapTotal' "$REPORT" 2>/dev/null \
  && _chk s PASS "OS memory" "/proc/meminfo captured" \
  || _chk s FAIL "OS memory" "Missing — swap anomaly undiagnosable"
grep -qiE 'always|madvise|never' "$REPORT" 2>/dev/null \
  && _chk s PASS "THP status" "Captured" \
  || _chk s WARN "THP status" "Not found"
grep -qiE 'lssam|rsct' "$REPORT" 2>/dev/null \
  && _chk s PASS "SA MP data" "Present" \
  || _chk s WARN "SA MP data" "lssam not accessible"
_errs=$(grep -cE '^(CRITICAL|CONNECT FAILED)' "$REPORT" 2>/dev/null || echo 0)
is_int "${_errs:-0}" || _errs=0
if   [ "$_errs" -eq 0 ]; then _chk s PASS "Collection errors" "None"
elif [ "$_errs" -le 3 ]; then _chk s WARN "Collection errors" "$_errs error(s)"
else                           _chk s FAIL "Collection errors" "$_errs errors — significant failures"
fi
vlog "  RHEL Sysadmin: PASS=$s_p  FAIL=$s_f  WARN=$s_w"

# ── LLM Recommendation ───────────────────────────────────────────────────────
vsect "LLM RECOMMENDATION"

total_lw=0; total_lt=0
for DB in $DBS; do
  lw="${DB_LOCK_WAITS[$DB]:-0}";    is_int "$lw" || lw=0; (( total_lw += lw )) || true
  lt="${DB_LONG_TXN_COUNT[$DB]:-0}"; is_int "$lt" || lt=0; (( total_lt += lt )) || true
done

INCIDENT=false
[ "$total_lw" -gt 0 ] && INCIDENT=true
[ "$total_lt" -gt 0 ] && INCIDENT=true
is_int "${swap_pct:-0}" && [ "${swap_pct:-0}" -gt 90 ] && INCIDENT=true

if $INCIDENT; then
  LLM="Claude Opus 4";      LLM_ALT="GPT-4o"
  LLM_REASON="Active incident (lock_waits=${total_lw} long_txns=${total_lt} swap=${swap_pct}%). Reasoning depth > token cost when production is degraded."
elif [ "$_cf" -gt 0 ] || [ "$p_f" -ge 3 ]; then
  LLM="Claude Sonnet 4";    LLM_ALT="GPT-4o"
  LLM_REASON="Connect failures ($_cf) or prompt gaps ($p_f failed). Sonnet handles missing data better than Flash/mini."
elif [ "$PROMPT_SIZE" -gt 100000 ]; then
  LLM="Gemini 1.5 Pro";     LLM_ALT="Claude Sonnet 4"
  LLM_REASON="Prompt ~$((PROMPT_SIZE/1024)) KB. Gemini's 1M context removes truncation risk at this size."
elif is_overall; then
  LLM="GPT-4o";             LLM_ALT="Gemini 1.5 Pro"
  LLM_REASON="Overall review, clean data. GPT-4o handles the structured taxonomy and 9-task prompt reliably."
else
  LLM="Gemini 1.5 Flash";   LLM_ALT="GPT-4o mini"
  LLM_REASON="Weekly check, no incidents, clean data, small prompt (~$((PROMPT_SIZE/1024)) KB). Structured prompt does the work — best token value."
fi

total_f=$(( v_f + e_f + p_f + s_f ))
total_w=$(( v_w + e_w + p_w + s_w ))
total_p=$(( v_p + e_p + p_p + s_p ))

if   [ "$total_f" -eq 0 ] && [ "$total_w" -le 3 ]; then VERDICT="ALL EXPERTS APPROVE"
elif [ "$total_f" -eq 0 ];                          then VERDICT="MOSTLY READY — review warnings"
elif [ "$total_f" -le 3 ];                          then VERDICT="USABLE WITH GAPS — $total_f failure(s)"
else                                                      VERDICT="NOT READY — $total_f failures"
fi

vlog ""
vlog "  Mode          : $MODE"
vlog "  Prompt size   : ~$((PROMPT_SIZE/1024)) KB"
vlog "  Incidents     : lock_waits=$total_lw  long_txns=$total_lt  swap=${swap_pct}%"
vlog "  Connect fails : $_cf / $DB_COUNT"
vlog ""
vlog "  ┌─────────────────────────────────────────────────────────┐"
vlog "  │  RECOMMENDED : $LLM"
vlog "  │  ALTERNATIVE : $LLM_ALT"
vlog "  │  Reason: $LLM_REASON"
vlog "  ├─────────────────────────────────────────────────────────┤"
vlog "  │  GitHub Copilot → select $LLM → paste $PROMPT_MD"
vlog "  └─────────────────────────────────────────────────────────┘"
vlog ""
vlog "  Decision logic (top-down, first match):"
vlog "    Incident (lock waits / long txns / swap >90%)  → Claude Opus 4"
vlog "    Connect failures or prompt gaps                 → Claude Sonnet 4"
vlog "    Prompt >100 KB                                  → Gemini 1.5 Pro"
vlog "    Overall mode, clean data                        → GPT-4o"
vlog "    Weekly, no incidents, clean, <100 KB (default) → Gemini 1.5 Flash"
vlog ""
vlog "  Checks: $((total_p+total_f+total_w))  PASS: $total_p  FAIL: $total_f  WARN: $total_w"
vlog "  $VERDICT"

# ── Console summary ───────────────────────────────────────────────────────────
ELAPSED=$(( $(date +%s) - SCRIPT_START ))
echo ""
echo "════════════════════════════════════════════════════════"
echo " db2_ecm_health_check.sh  [${MODE}]  ${ELAPSED}s"
echo "════════════════════════════════════════════════════════"
echo " Report  : $REPORT"
echo " Prompt  : $PROMPT_MD"
echo " Verify  : $VERIFY"
echo ""
echo " Expert verification:"
echo "   Db2 DBA    PASS=$v_p  FAIL=$v_f  WARN=$v_w"
echo "   ECM Spec   PASS=$e_p  FAIL=$e_f  WARN=$e_w"
echo "   Prompt Eng PASS=$p_p  FAIL=$p_f  WARN=$p_w"
echo "   RHEL Admin PASS=$s_p  FAIL=$s_f  WARN=$s_w"
echo "   ─────────────────────────────────────────"
echo "   $VERDICT"
echo ""
echo " LLM : $LLM  (alt: $LLM_ALT)"
echo " Paste $PROMPT_MD into GitHub Copilot using $LLM"
echo "════════════════════════════════════════════════════════"
