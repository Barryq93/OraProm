SELECT TABSCHEMA, TABNAME, DATA_PARTITION_ID, ROWS_READ, ROWS_INSERTED, ROWS_UPDATED, ROWS_DELETED, 
       ROWS_MODIFIED, OVERFLOW_ACCESSES, TABLE_SCANS, RANGE_SCANS, SEQUENTIAL_PAGE_READS, DIRECT_READS
FROM TABLE(MON_GET_TABLE('', -2))
WHERE TABLE_SCANS > 1000 
AND RANGE_SCANS < TABLE_SCANS -- Low range scan usage suggests missing indexes
ORDER BY TABLE_SCANS DESC;