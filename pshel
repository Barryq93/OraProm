SELECT
    TABSCHEMA,
    TABNAME,
    'TABLE' AS OBJTYPE,
    ROWS_INSERTED,
    ROWS_DELETED,
    ROWS_UPDATED,
    DATA_P_READS,
    DATA_P_WRITES,
    STATS_TIME
FROM
    SYSIBMADM.SNAPTAB
WHERE
    DB_NAME = 'DBNAME' -- Replace with your database name
UNION ALL
SELECT
    INDSCHEMA,
    INDNAME,
    'INDEX' AS OBJTYPE,
    ROWS_INSERTED,
    ROWS_DELETED,
    ROWS_UPDATED,
    DATA_P_READS,
    DATA_P_WRITES,
    STATS_TIME
FROM
    SYSIBMADM.SNAPINDEX
WHERE
    DB_NAME = 'DBNAME' -- Replace with your database name
ORDER BY
    TABSCHEMA, TABNAME;
