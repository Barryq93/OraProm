# Percentage of each status code by instance and application
(
  sum by (application, instance, status) (
    rate(http_server_requests_seconds_count{job="eureka-discovery"}[5m])
  )
  /
  sum by (application, instance) (
    rate(http_server_requests_seconds_count{job="eureka-discovery"}[5m])
  )
) * 100

# Same query with status codes grouped into categories
(
  sum by (application, instance, status_category) (
    rate(
      http_server_requests_seconds_count{job="eureka-discovery"}[5m]
    ) * on(status) group_left(status_category)
    (
      label_replace(
        {__name__="status_mapping"},
        "status_category",
        "2xx",
        "status",
        "2.."
      ) or
      label_replace(
        {__name__="status_mapping"},
        "status_category",
        "3xx",
        "status",
        "3.."
      ) or
      label_replace(
        {__name__="status_mapping"},
        "status_category",
        "4xx",
        "status",
        "4.."
      ) or
      label_replace(
        {__name__="status_mapping"},
        "status_category",
        "5xx",
        "status",
        "5.."
      )
    )
  )
  /
  sum by (application, instance) (
    rate(http_server_requests_seconds_count{job="eureka-discovery"}[5m])
  )
) * 100

# With specific endpoints included
(
  sum by (application, instance, status, uri) (
    rate(http_server_requests_seconds_count{job="eureka-discovery"}[5m])
  )
  /
  sum by (application, instance, uri) (
    rate(http_server_requests_seconds_count{job="eureka-discovery"}[5m])
  )
) * 100