-- *************************************************************
-- DB2 PERFORMANCE MONITORING & INDEX OPTIMIZATION CHECKS
-- *************************************************************

-- 1. Check overall database performance metrics
SELECT DB_NAME, SNAPSHOT_TIMESTAMP, TOTAL_ROWS_READ, TOTAL_ROWS_RETURNED, TOTAL_SORTS, 
       TOTAL_LOCKS_WAITED, TOTAL_CPU_TIME, TOTAL_ELAPSED_TIME
FROM SYSIBMADM.MON_DB_SUMMARY;

-- 2. Identify tables with heavy full table scans (potential index candidates)
SELECT TABSCHEMA, TABNAME, ROWS_READ, ROWS_MODIFIED, TABLE_SCANS, SEQUENTIAL_PAGE_READS
FROM TABLE(MON_GET_TABLE('', -2))
WHERE TABLE_SCANS > 1000
ORDER BY TABLE_SCANS DESC;

-- 3. Identify high-CPU-consuming queries
SELECT STMT_TEXT, NUM_EXECUTIONS, TOTAL_CPU_TIME, TOTAL_EXEC_TIME, ROWS_READ
FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL, NULL, NULL, -2))
ORDER BY TOTAL_CPU_TIME DESC
FETCH FIRST 10 ROWS ONLY;

-- 4. Identify queries with high buffer pool reads (potential indexing issue)
SELECT STMT_TEXT, NUM_EXECUTIONS, POOL_READS, POOL_TEMP_DATA_L_READS
FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL, NULL, NULL, -2))
ORDER BY POOL_READS DESC
FETCH FIRST 10 ROWS ONLY;

-- 5. Find queries doing full table scans (inefficient queries)
SELECT STMT_TEXT, NUM_EXECUTIONS, ROWS_READ, ROWS_RETURNED, TOTAL_EXEC_TIME, STMT_TYPE
FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL, NULL, NULL, -2))
WHERE ROWS_READ > 1000000
AND ROWS_RETURNED < (ROWS_READ * 0.01)
ORDER BY ROWS_READ DESC
FETCH FIRST 10 ROWS ONLY;

-- 6. Find the top 10 longest-running queries
SELECT STMT_TEXT, NUM_EXECUTIONS, TOTAL_EXEC_TIME
FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL, NULL, NULL, -2))
ORDER BY TOTAL_EXEC_TIME DESC
FETCH FIRST 10 ROWS ONLY;

-- 7. Find queries with high sort activity (potential index or query tuning issue)
SELECT STMT_TEXT, TOTAL_SORTS, TOTAL_SORT_OVERFLOWS
FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL, NULL, NULL, -2))
WHERE TOTAL_SORTS > 1000
ORDER BY TOTAL_SORTS DESC
FETCH FIRST 10 ROWS ONLY;

-- 8. Find queries with high lock waits (possible contention issue)
SELECT STMT_TEXT, LOCK_WAIT_TIME, LOCK_WAITS
FROM TABLE(MON_GET_PKG_CACHE_STMT(NULL, NULL, NULL, -2))
WHERE LOCK_WAIT_TIME > 10000
ORDER BY LOCK_WAIT_TIME DESC
FETCH FIRST 10 ROWS ONLY;

-- 9. Check index effectiveness (index scans vs table scans)
SELECT TABSCHEMA, TABNAME, INDEX_SCANS, TABLE_SCANS, INDEX_LOOKUPS
FROM TABLE(MON_GET_INDEX('', -2))
WHERE TABLE_SCANS > INDEX_SCANS
ORDER BY TABLE_SCANS DESC;

-- 10. Find tables needing REORG (fragmentation issues)
SELECT TABSCHEMA, TABNAME, REORG_PENDING, OVERFLOW
FROM SYSCAT.TABLES
WHERE REORG_PENDING = 'Y' OR OVERFLOW > (CARD * 0.10)
ORDER BY OVERFLOW DESC;