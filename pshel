#!/bin/bash

# --- Configuration ---
# Add the directories you want to monitor to this array
TARGET_DIRS=(
    "/path/to/your/first/directory"
    "/path/to/your/second/directory"
    # Add more directories here if needed
)
# Set the desired permissions in octal format
DESIRED_PERMS="755"
# Set the path for the log file
LOG_FILE="/var/log/permission_checker.log"
# --- End Configuration ---

EXIT_CODE=0 # Track overall success/failure for the script run

# Function to simplify logging
log_message() {
    # Appends timestamp and message to the log file
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# Ensure log directory exists (optional, depends on location)
# log_dir=$(dirname "$LOG_FILE")
# if [ ! -d "$log_dir" ]; then
#    mkdir -p "$log_dir" || { echo "ERROR: Cannot create log directory $log_dir"; exit 1; }
# fi
# touch "$LOG_FILE" || { echo "ERROR: Cannot create log file $LOG_FILE"; exit 1; }
# chmod 640 "$LOG_FILE" # Example permissions

# Loop through each directory specified in the TARGET_DIRS array
for target_dir in "${TARGET_DIRS[@]}"; do
    # Check if the target directory exists
    if [ ! -d "$target_dir" ]; then
        log_message "WARNING: Directory '$target_dir' not found. Skipping."
        continue # Move to the next directory in the list
    fi

    # Get current permissions in octal format
    CURRENT_PERMS=$(stat -c "%a" "$target_dir")

    # Check if current permissions match the desired permissions
    if [ "$CURRENT_PERMS" != "$DESIRED_PERMS" ]; then
        log_message "INFO: Permissions for '$target_dir' were '$CURRENT_PERMS'. Changing to '$DESIRED_PERMS'."
        # Attempt to change permissions
        if chmod "$DESIRED_PERMS" "$target_dir"; then
            # Verify the change (optional but good practice)
            NEW_PERMS=$(stat -c "%a" "$target_dir")
            if [ "$NEW_PERMS" == "$DESIRED_PERMS" ]; then
                log_message "SUCCESS: Permissions for '$target_dir' successfully changed to '$DESIRED_PERMS'."
            else
                log_message "ERROR: Chmod reported success for '$target_dir', but permissions are now '$NEW_PERMS' (expected '$DESIRED_PERMS')."
                EXIT_CODE=1 # Indicate an error occurred
            fi
        else
            # chmod command failed
            log_message "ERROR: Failed to change permissions for '$target_dir' to '$DESIRED_PERMS'."
            EXIT_CODE=1 # Indicate an error occurred
        fi
    else
        # Optional: Log that permissions were already correct - uncomment if needed
        # log_message "INFO: Permissions for '$target_dir' are already '$DESIRED_PERMS'. No action taken."
        : # Do nothing if permissions are correct
    fi
done # End of directory loop

exit $EXIT_CODE
