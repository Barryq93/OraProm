#!/bin/bash
set -e

# Source DB2 environment
. /home/db2inst1/sqllib/db2profile

# List of databases
DATABASES=("db1" "db2" "db3" "db4" "db5" "db6" "db7")

# Step 1: Start DB2 instance
echo "Starting DB2..."
db2start

# Step 2: Start HADR for each database
for DB_NAME in "${DATABASES[@]}"; do
    echo "Starting HADR for database: $DB_NAME"
    db2 connect to $DB_NAME

    # Check current role
    role=$(db2pd -hadr -db $DB_NAME | grep -i "Role:" | awk '{print $2}')

    if [[ "$role" == "STANDBY" ]]; then
        db2 "START HADR ON DATABASE $DB_NAME AS STANDBY"
        echo "HADR started as STANDBY for $DB_NAME."
    elif [[ "$role" == "PRIMARY" ]]; then
        db2 "START HADR ON DATABASE $DB_NAME AS PRIMARY"
        echo "HADR started as PRIMARY for $DB_NAME."
    else
        echo "Warning: HADR role undefined for $DB_NAME. Skipping..."
    fi
done

echo "Startup complete. All databases are running with HADR."
