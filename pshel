SELECT 
    d.*, 
    ds.*, 
    dt.*,
    MAX(CASE WHEN da.rn = 1 THEN da.documenttypeid END) AS documenttypeid_row1,
    MAX(CASE WHEN da.rn = 2 THEN da.documenttypeid END) AS documenttypeid_row2,
    MAX(CASE WHEN da.rn = 1 THEN da.indextypeid END) AS indextypeid_row1,
    MAX(CASE WHEN da.rn = 2 THEN da.indextypeid END) AS indextypeid_row2,
    MAX(CASE WHEN da.rn = 1 THEN da.value END) AS value_row1,
    MAX(CASE WHEN da.rn = 2 THEN da.value END) AS value_row2,
    MAX(CASE WHEN da.rn = 1 THEN da.linkid END) AS linkid_row1,
    MAX(CASE WHEN da.rn = 2 THEN da.linkid END) AS linkid_row2
FROM 
    document d
JOIN 
    documents ds ON d.docid = ds.documentID
JOIN 
    DocumentType dt ON dt.DocumentTypeID = d.DocumentTypeID
LEFT JOIN (
    SELECT 
        docid,
        documenttypeid,
        indextypeid,
        value,
        linkid,
        ROW_NUMBER() OVER (PARTITION BY docid ORDER BY documenttypeid) AS rn
    FROM 
        documentattributes
) da ON d.docid = da.docid
GROUP BY 
    d.docid, d.DocumentTypeID, d.name,  -- List all document columns
    ds.documentID, ds.ds_col,           -- List all documents columns
    dt.DocumentTypeID, dt.dt_col;       -- List all DocumentType columns
