SELECT 
    TABSCHEMA AS TABLE_SCHEMA,
    TABNAME AS TABLE_NAME,
    INDSCHEMA AS INDEX_SCHEMA,
    INDNAME AS INDEX_NAME,
    CASE 
        WHEN INDEX_USAGE_COUNT > 0 THEN 'USED'
        ELSE 'NOT USED'
    END AS INDEX_USAGE_STATUS,
    INDEX_USAGE_COUNT,
    LAST_USED_TIMESTAMP
FROM 
    TABLE(MON_GET_INDEX(NULL, NULL, -2)) AS INDEX_USAGE
ORDER BY 
    INDEX_USAGE_STATUS, TABLE_SCHEMA, TABLE_NAME, INDEX_SCHEMA, INDEX_NAME;