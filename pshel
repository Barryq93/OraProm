# Load assemblies (adjust paths as needed)
Add-Type -Path "path\to\Confluent.Kafka.dll"
Add-Type -Path "path\to\Confluent.SchemaRegistry.dll"
Add-Type -Path "path\to\Confluent.SchemaRegistry.Serdes.Avro.dll"

# Kafka & Schema Registry config
$bootstrapServers = "localhost:9092"
$schemaRegistryUrl = "http://localhost:8081"
$groupId           = "ecm-documents-consumer-group"
$topic             = "ECMDocuments"

# Schema Registry client
$srConfig = [Confluent.SchemaRegistry.SchemaRegistryConfig]::new()
$srConfig.Url = $schemaRegistryUrl
$schemaRegistryClient = [Confluent.SchemaRegistry.CachedSchemaRegistryClient]::new($srConfig)

# Consumer config
$consumerConfig = [Confluent.Kafka.ConsumerConfig]::new()
$consumerConfig.BootstrapServers  = $bootstrapServers
$consumerConfig.GroupId           = $groupId
$consumerConfig.AutoOffsetReset   = [Confluent.Kafka.AutoOffsetReset]::Earliest
$consumerConfig.EnableAutoCommit  = $true

# Build consumer with Avro deserializer (GenericRecord for dynamic Avro schemas)
$consumerBuilder = [Confluent.Kafka.ConsumerBuilder[
    Confluent.Kafka.Ignore,
    Avro.Generic.GenericRecord
]]::new($consumerConfig)

$avroDeserializer = [Confluent.SchemaRegistry.Serdes.AvroDeserializer[Avro.Generic.GenericRecord]]::new($schemaRegistryClient, $null)
$consumerBuilder.SetValueDeserializer($avroDeserializer.AsSyncOverAsync())

$consumer = $consumerBuilder.Build()
$consumer.Subscribe($topic)

Write-Host "Consuming from topic: $topic ..."

try {
    while ($true) {
        $result = $consumer.Consume([System.TimeSpan]::FromSeconds(5))

        if ($null -ne $result) {
            Write-Host "Offset: $($result.Offset) | Partition: $($result.Partition)"

            # Access Avro fields dynamically
            $record = $result.Message.Value
            foreach ($field in $record.Schema.Fields) {
                Write-Host "  $($field.Name): $($record[$field.Name])"
            }
        }
    }
} catch [System.OperationCanceledException] {
    Write-Host "Consumer cancelled."
} finally {
    $consumer.Close()
    $consumer.Dispose()
}