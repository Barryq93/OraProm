#!/bin/bash

# Script to check tables and indexes needing REORG in DB2
# Outputs to CSV: Table Name,Index Name,Reason (F1-F8 for tables, F1-F3 for indexes)

# Variables
DB_NAME="your_db_name"  # Replace with your database name
OUTPUT_FILE="reorg_check.out"
TEMP_FILE="reorg_check_temp.out"
CSV_FILE="reorg_needed.csv"
DEBUG_FILE="reorg_debug.log"

# Initialize debug log
echo "Starting script at $(date)" > $DEBUG_FILE

# Ensure the database is connected
echo "Connecting to database $DB_NAME..."
db2 connect to $DB_NAME >> $DEBUG_FILE 2>&1
if [ $? -ne 0 ]; then
    echo "Error: Unable to connect to database $DB_NAME. Check $DEBUG_FILE for details."
    exit 1
fi
echo "Connected to $DB_NAME" >> $DEBUG_FILE

# Run REORGCHK on all tables with current statistics
echo "Running REORGCHK on all tables..."
db2 "reorgchk current statistics on table all" > $OUTPUT_FILE 2>> $DEBUG_FILE
if [ $? -ne 0 ]; then
    echo "Error: REORGCHK command failed. Check $DEBUG_FILE for details."
    exit 1
fi
echo "REORGCHK completed. Output written to $OUTPUT_FILE" >> $DEBUG_FILE

# Verify REORGCHK output
if [ ! -s $OUTPUT_FILE ]; then
    echo "Error: $OUTPUT_FILE is empty. REORGCHK produced no output."
    echo "Check permissions, statistics, or DB2 version compatibility." >> $DEBUG_FILE
    exit 1
fi
echo "REORGCHK output size: $(wc -l $OUTPUT_FILE | awk '{print $1}') lines" >> $DEBUG_FILE

# Initialize CSV file with header
echo "Table Name,Index Name,Reason" > $CSV_FILE
echo "CSV initialized with header" >> $DEBUG_FILE

# Parse the output for tables and indexes needing REORG
echo "Analyzing REORGCHK output and generating CSV..."

# Process table section
echo "Parsing table section..." >> $DEBUG_FILE
grep -A 5 "Table:" $OUTPUT_FILE | grep -E "Table:|\*" > $TEMP_FILE
TABLE_COUNT=0
while IFS= read -r line; do
    echo "Processing table line: '$line'" >> $DEBUG_FILE
    if [[ $line =~ ^Table:\ (.*) ]]; then
        TABLE_NAME="${BASH_REMATCH[1]}"
        REASON=""
        echo "Found table: $TABLE_NAME" >> $DEBUG_FILE
    elif [[ $line =~ .*\* ]]; then
        REASON=""
        # Split line into fields, ignoring leading spaces
        fields=($(echo "$line" | tr -s ' ' | sed 's/^[ ]*//'))
        echo "Fields: ${fields[*]}" >> $DEBUG_FILE
        # Map fields to F1-F8 (adjust based on your DB2 version's output)
        for i in "${!fields[@]}"; do
            if [[ "${fields[$i]}" =~ \* ]]; then
                case $i in
                    0) REASON="$REASON *F1 Overflow records" ;;
                    1) REASON="$REASON *F2 Space utilization" ;;
                    2) REASON="$REASON *F3 Fragmentation" ;;
                    3) REASON="$REASON *F4 Clustering" ;;
                    4) REASON="$REASON *F5 Page reorg" ;;
                    5) REASON="$REASON *F6 Compression" ;;
                    6) REASON="$REASON *F7" ;;  # Version-dependent
                    7) REASON="$REASON *F8" ;;  # Version-dependent
                esac
            fi
        done
        if [ -n "$REASON" ]; then
            TABLE_NAME_ESCAPED=$(echo "$TABLE_NAME" | sed 's/,/\\,/g')
            REASON_ESCAPED=$(echo "$REASON" | sed 's/,/\\,/g')
            echo "Writing to CSV: \"$TABLE_NAME_ESCAPED\",\"-\",\"$REASON_ESCAPED\"" >> $DEBUG_FILE
            echo "\"$TABLE_NAME_ESCAPED\",\"-\",\"$REASON_ESCAPED\"" >> $CSV_FILE
            ((TABLE_COUNT++))
            echo "Table $TABLE_NAME needs REORG: $REASON" >> $DEBUG_FILE
        else
            echo "No specific reason identified for table $TABLE_NAME" >> $DEBUG_FILE
        fi
    fi
done < $TEMP_FILE
echo "Processed $TABLE_COUNT tables needing REORG" >> $DEBUG_FILE

# Process index section
echo "Parsing index section..." >> $DEBUG_FILE
grep -A 5 "Index:" $OUTPUT_FILE | grep -E "Index:|\*" > $TEMP_FILE
INDEX_COUNT=0
while IFS= read -r line; do
    echo "Processing index line: '$line'" >> $DEBUG_FILE
    if [[ $line =~ ^Index:\ (.*) ]]; then
        INDEX_NAME="${BASH_REMATCH[1]}"
        TABLE_NAME=$(echo "$INDEX_NAME" | cut -d'.' -f1-2)
        REASON=""
        echo "Found index: $INDEX_NAME" >> $DEBUG_FILE
    elif [[ $line =~ .*\* ]]; then
        REASON=""
        # Split line into fields, ignoring leading spaces
        fields=($(echo "$line" | tr -s ' ' | sed 's/^[ ]*//'))
        echo "Fields: ${fields[*]}" >> $DEBUG_FILE
        # Map fields to F1-F3 for indexes (adjust based on your output)
        for i in "${!fields[@]}"; do
            if [[ "${fields[$i]}" =~ \* ]]; then
                case $i in
                    0) REASON="$REASON *F1 Cardinality" ;;
                    1) REASON="$REASON *F2 Leaf pages" ;;
                    2) REASON="$REASON *F3 Levels" ;;
                esac
            fi
        done
        # If no specific F1-F3 match, check for trailing *----
        if [ -z "$REASON" ] && [[ "$line" =~ \*----$ ]]; then
            REASON="*F3 Levels"  # Assuming *---- indicates index levels
        fi
        if [ -n "$REASON" ]; then
            TABLE_NAME_ESCAPED=$(echo "$TABLE_NAME" | sed 's/,/\\,/g')
            INDEX_NAME_ESCAPED=$(echo "$INDEX_NAME" | sed 's/,/\\,/g')
            REASON_ESCAPED=$(echo "$REASON" | sed 's/,/\\,/g')
            echo "Writing to CSV: \"$TABLE_NAME_ESCAPED\",\"$INDEX_NAME_ESCAPED\",\"$REASON_ESCAPED\"" >> $DEBUG_FILE
            echo "\"$TABLE_NAME_ESCAPED\",\"$INDEX_NAME_ESCAPED\",\"$REASON_ESCAPED\"" >> $CSV_FILE
            ((INDEX_COUNT++))
            echo "Index $INDEX_NAME needs REORG: $REASON" >> $DEBUG_FILE
        else
            echo "No specific reason identified for index $INDEX_NAME" >> $DEBUG_FILE
        fi
    fi
done < $TEMP_FILE
echo "Processed $INDEX_COUNT indexes needing REORG" >> $DEBUG_FILE

# Cleanup temporary files (commented out for debugging)
# rm -f $OUTPUT_FILE $TEMP_FILE

# Disconnect from the database
db2 terminate >> $DEBUG_FILE 2>&1

echo "-------------------------------------------------------------"
echo "Analysis complete. Results written to $CSV_FILE"
echo "Debug log available in $DEBUG_FILE"
echo "Tables flagged: $TABLE_COUNT, Indexes flagged: $INDEX_COUNT"
echo "If reasons are missing, check $DEBUG_FILE and $OUTPUT_FILE."
echo "-------------------------------------------------------------"
exit 0
