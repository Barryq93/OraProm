# Get input from the user
$csvFile = Read-Host "Enter the path to the CSV file:"
$groupName = Read-Host "Enter the group name:"

# Read the CSV file
$users = Import-Csv -Path $csvFile -Header UserID 

# Create empty arrays to store users 
$usersNotInGroup = @()
$usersNotFound = @()

foreach ($user in $users) {
    try {
        # Check if the user exists using net user
        $userCheck = & net user "$($user.UserID)" /domain 2>&1 

        # Check if the user is active (basic check, may not be accurate)
        if ($userCheck -match "Account disabled") {
            Write-Warning "The user $($user.UserID) is not active."
            continue
        }

        # Check if the specified group is in the net user output
        if ($userCheck -match $groupName) {
            Write-Host "User $($user.UserID) is a member of group $groupName."
        } else {
            Write-Host "User $($user.UserID) is not a member of group $groupName."
            $usersNotInGroup += [PSCustomObject]@{
                UserID = $user.UserID
                GroupName = $groupName 
            }
        }
    } catch [System.Exception] {
        Write-Warning "The user name $($user.UserID) could not be found."
        $usersNotFound += [PSCustomObject]@{
            UserID = $user.UserID
        }
    }
}

# Export users not in the group to a new CSV file
if ($usersNotInGroup) {
    $outputFile = "UsersNotInGroup_$groupName.csv"
    Export-Csv -Path $outputFile -InputObject $usersNotInGroup -NoTypeInformation -Force
    Write-Host "Users not in group $groupName exported to $outputFile."
} else {
    Write-Host "All users in the CSV file are already members of group $groupName."
}

# Export users not found to a new CSV file
if ($usersNotFound) {
    $outputFile = "UsersNotFound.csv"
    Export-Csv -Path $outputFile -InputObject $usersNotFound -NoTypeInformation -Force
    Write-Host "Users not found exported to $outputFile."
} else {
    Write-Host "All users in the CSV file were found."
}

This script now includes the following enhancements:
 * Separate array for users not found: A new array, $usersNotFound, is created to store UserIDs that could not be found during the net user check.
 * Exporting users not found: After processing all users, the script exports the $usersNotFound array to a separate CSV file named "UsersNotFound.csv".
 * Informative messages: The script provides messages indicating whether any users were not found.
This modified script should now fulfill your requirement of outputting a separate CSV file for users that do not exist in Active Directory.
