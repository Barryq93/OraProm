# Define server list and output paths
$servers = @("server1", "server2", "server3", "server4", "server5", "server6", "server7")
$outputPath = "C:\NetworkLogs" # Adjust this path as needed
$duration = 3600 # 1 hour in seconds

# Create output directory if it doesn't exist
if (-not (Test-Path $outputPath)) {
    New-Item -Path $outputPath -ItemType Directory | Out-Null
}

# Initialize CSV files with headers
"InboundTime,SourceIP,SourceHost,DestIP,DestHost,DestPort,Protocol,Server,Application" | Out-File "$outputPath\server_inbound.csv" -Encoding UTF8
"OutboundTime,SourceIP,SourceHost,SourcePort,DestIP,DestHost,DestPort,Protocol,Server,Application" | Out-File "$outputPath\server_outbound.csv" -Encoding UTF8

# Function to resolve IP to hostname with cache
$dnsCache = @{}
function Resolve-Hostname($ip) {
    if ($dnsCache.ContainsKey($ip)) {
        return $dnsCache[$ip]
    }
    try {
        $hostname = (nslookup $ip 2>$null | Select-String "Name:" | Select-Object -First 1).ToString().Split(":")[1].Trim()
        if (-not $hostname) { $hostname = $ip }
    } catch {
        $hostname = $ip
    }
    $dnsCache[$ip] = $hostname
    return $hostname
}

# Start time tracking
$startTime = Get-Date
$endTime = $startTime.AddSeconds($duration)

Write-Host "Starting network monitoring for 1 hour across $($servers.Count) servers..."

# Main monitoring loop
while ((Get-Date) -lt $endTime) {
    foreach ($server in $servers) {
        try {
            # Get current network connections and process info
            $connections = Invoke-Command -ComputerName $server -ScriptBlock {
                $tcpConnections = Get-NetTCPConnection -ErrorAction SilentlyContinue
                $processes = Get-Process -ErrorAction SilentlyContinue | Select-Object Id, ProcessName
                $results = @()
                foreach ($conn in $tcpConnections) {
                    $process = $processes | Where-Object { $_.Id -eq $conn.OwningProcess }
                    $processName = if ($process.ProcessName) { $process.ProcessName } else { "PID_$($conn.OwningProcess)" }
                    $conn | Add-Member -NotePropertyName "ProcessName" -NotePropertyValue $processName -PassThru
                    $results += $conn
                }
                return $results
            }

            foreach ($conn in $connections) {
                # Skip loopback connections
                if ($conn.LocalAddress -eq "127.0.0.1" -or $conn.RemoteAddress -eq "127.0.0.1") {
                    continue
                }

                $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                
                # Determine if connection is inbound or outbound
                if ($conn.LocalAddress -ne "0.0.0.0" -and $conn.LocalAddress -ne "::") {
                    # Inbound connection
                    $sourceHost = Resolve-Hostname $conn.RemoteAddress
                    $destHost = Resolve-Hostname $conn.LocalAddress
                    $logEntry = "$timestamp,$($conn.RemoteAddress),$sourceHost,$($conn.LocalAddress),$destHost,$($conn.LocalPort),TCP,$server,$($conn.ProcessName)"
                    $logEntry | Out-File "$outputPath\server_inbound.csv" -Append -Encoding UTF8
                }
                
                if ($conn.RemoteAddress -ne "0.0.0.0" -and $conn.RemoteAddress -ne "::") {
                    # Outbound connection
                    $sourceHost = Resolve-Hostname $conn.LocalAddress
                    $destHost = Resolve-Hostname $conn.RemoteAddress
                    $logEntry = "$timestamp,$($conn.LocalAddress),$sourceHost,$($conn.LocalPort),$($conn.RemoteAddress),$destHost,$($conn.RemotePort),TCP,$server,$($conn.ProcessName)"
                    $logEntry | Out-File "$outputPath\server_outbound.csv" -Append -Encoding UTF8
                }
            }
        }
        catch {
            Write-Warning "Error processing $server : $_"
        }
    }
    
    # Wait 30 seconds before next iteration
    Start-Sleep -Seconds 30
}

Write-Host "Network monitoring completed. Logs saved to $outputPath"