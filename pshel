#!/bin/bash

# Check if an input file is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <input_file>"
  exit 1
fi

input_file="$1"

# Check if the input file exists
if [ ! -f "$input_file" ]; then
  echo "Error: Input file '$input_file' not found."
  exit 1
fi

# Read each line from the input file
while IFS= read -r line; do
  # Use regex to extract host and port
  if [[ "$line" =~ ^([^:]+):([0-9]+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"

    url="http://${host}:${port}" # Try with http first

    # Attempt to establish a connection using curl (without -s)
    if curl --connect-timeout 2 "$url" >/dev/null 2>&1; then
      echo "Connected: $host:$port"
    else
      url="https://${host}:${port}" # If http fails, try https
      if curl --connect-timeout 2 "$url" >/dev/null 2>&1; then
        echo "Connected: $host:$port"
      else
        echo "Not Connected: $host:$port"
      fi
    fi
  else
    echo "Invalid format: $line (Expected format: host:port)"
  fi
done < "$input_file"

exit 0
