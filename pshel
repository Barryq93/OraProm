#!/bin/bash

# Script to check server access to a list of endpoints using openssl s_client.

# --- Configuration ---
ENDPOINT_FILE="endpoints.txt" # File containing the list of endpoints (e.g., host:port)
OUTPUT_LOG="endpoint_check_$(date +%Y%m%d_%H%M%S).log" # Log file for results
TIMEOUT_SECONDS=5 # Timeout for each openssl connection attempt

# --- Functions ---

log_message() {
    echo "$(date +'%Y-%m-%d %H:%M:%S') - $1" | tee -a "$OUTPUT_LOG"
}

check_endpoint() {
    local endpoint="$1"
    log_message "Checking endpoint: $endpoint"

    # Use openssl s_client -connect to check connectivity
    # -servername: Essential for SNI (Server Name Indication)
    # -quiet: Suppresses non-essential output
    # -noout: Suppresses certificate output
    # -debug: Useful for debugging, but typically not needed for a simple check.
    #         Remove for production or if you don't need detailed handshake info.
    # -timeout: Sets a timeout for the connection.
    # 2>/dev/null: Redirects stderr (error messages) to /dev/null to keep output clean.
    #              You might want to remove this during debugging to see openssl errors.

    if openssl s_client -connect "$endpoint" -servername "$(echo "$endpoint" | cut -d':' -f1)" -quiet -noout -timeout "$TIMEOUT_SECONDS" >/dev/null 2>&1; then
        log_message "  SUCCESS: Endpoint $endpoint is accessible."
        return 0 # Success
    else
        log_message "  FAILURE: Endpoint $endpoint is NOT accessible or connection timed out."
        return 1 # Failure
    fi
}

# --- Main Script Logic ---

# Check if the endpoint file exists
if [ ! -f "$ENDPOINT_FILE" ]; then
    log_message "Error: Endpoint file '$ENDPOINT_FILE' not found."
    log_message "Please create '$ENDPOINT_FILE' with one endpoint (host:port) per line."
    exit 1
fi

log_message "Starting endpoint accessibility check..."
log_message "Reading endpoints from: $ENDPOINT_FILE"
log_message "Results will be logged to: $OUTPUT_LOG"
log_message "Connection timeout set to: $TIMEOUT_SECONDS seconds"
log_message "----------------------------------------------------"

SUCCESS_COUNT=0
FAILURE_COUNT=0

# Read endpoints from the file, line by line
while IFS= read -r endpoint || [[ -n "$endpoint" ]]; do
    # Skip empty lines and comments
    if [[ -z "$endpoint" || "$endpoint" =~ ^# ]]; then
        continue
    fi

    # Remove leading/trailing whitespace
    endpoint=$(echo "$endpoint" | xargs)

    # Validate endpoint format (simple host:port check)
    if ! echo "$endpoint" | grep -qE '^[^:]+:[0-9]+$'; then
        log_message "  WARNING: Invalid endpoint format (expected host:port): $endpoint - Skipping."
        continue
    fi

    check_endpoint "$endpoint"
    if [ $? -eq 0 ]; then
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        FAILURE_COUNT=$((FAILURE_COUNT + 1))
    fi
    echo "" # Add a blank line for readability between checks
done < "$ENDPOINT_FILE"

log_message "----------------------------------------------------"
log_message "Endpoint check complete."
log_message "Total Endpoints Checked: $((SUCCESS_COUNT + FAILURE_COUNT))"
log_message "Successfully Accessible: $SUCCESS_COUNT"
log_message "Failed Accessibility:    $FAILURE_COUNT"

if [ "$FAILURE_COUNT" -gt 0 ]; then
    log_message "Some endpoints were not accessible. Please check the log file '$OUTPUT_LOG' for details."
    exit 1 # Exit with a non-zero status to indicate failures
else
    log_message "All endpoints are accessible."
    exit 0 # Exit with zero status for success
fi

