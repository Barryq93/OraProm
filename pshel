# Multi-Server Network Traffic Monitor
# This script monitors network traffic on multiple servers simultaneously,
# logging unique connections to CSV files with source, destination, and process info

# List of servers to monitor
$servers = @(
    "Server1",
    "Server2",
    "Server3",
    "Server4",
    "Server5",
    "Server6",
    "Server7"
)

# Function to resolve IP address to hostname
function Resolve-IPAddress {
    param (
        [string]$IPAddress
    )
    
    try {
        $result = nslookup $IPAddress 2>$null
        if ($result -match "Name:\s+(.+)") {
            return $Matches[1].Trim()
        }
        else {
            return $IPAddress
        }
    }
    catch {
        return $IPAddress
    }
}

# Function to monitor network traffic on a server
function Monitor-NetworkTraffic {
    param (
        [string]$ServerName
    )

    Write-Host "Starting network monitoring on $ServerName"
    
    # Create log directories if they don't exist
    $logDir = ".\NetworkLogs"
    if (-not (Test-Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    }

    # Create CSV files for inbound and outbound traffic
    $inboundLogFile = "$logDir\${ServerName}_inbound.csv"
    $outboundLogFile = "$logDir\${ServerName}_outbound.csv"
    
    # Initialize hash tables to track unique connections
    $inboundConnections = @{}
    $outboundConnections = @{}
    
    # Add CSV headers if files don't exist
    if (-not (Test-Path $inboundLogFile)) {
        "Timestamp,Source,Destination,Process" | Out-File -FilePath $inboundLogFile -Encoding utf8
    }
    
    if (-not (Test-Path $outboundLogFile)) {
        "Timestamp,Source,Destination,Process" | Out-File -FilePath $outboundLogFile -Encoding utf8
    }
    
    # Set monitoring duration (1 hour)
    $endTime = (Get-Date).AddHours(1)
    
    while ((Get-Date) -lt $endTime) {
        try {
            # If monitoring a remote server, use Invoke-Command
            if ($ServerName -ne $env:COMPUTERNAME) {
                $connections = Invoke-Command -ComputerName $ServerName -ScriptBlock {
                    Get-NetTCPConnection | Select-Object LocalAddress, LocalPort, RemoteAddress, RemotePort, OwningProcess, State
                }
            }
            else {
                # For local server
                $connections = Get-NetTCPConnection | Select-Object LocalAddress, LocalPort, RemoteAddress, RemotePort, OwningProcess, State
            }
            
            $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            
            # Process each connection
            foreach ($conn in $connections) {
                # Skip loopback addresses and connections in listening state
                if (($conn.RemoteAddress -eq "0.0.0.0" -or $conn.RemoteAddress -eq "::" -or $conn.RemoteAddress -eq "127.0.0.1" -or $conn.RemoteAddress -eq "::1") -or 
                    ($conn.State -eq "Listen")) {
                    continue
                }
                
                # Get process name
                try {
                    if ($ServerName -ne $env:COMPUTERNAME) {
                        $processInfo = Invoke-Command -ComputerName $ServerName -ScriptBlock {
                            param($pid)
                            $process = Get-Process -Id $pid -ErrorAction SilentlyContinue
                            if ($process) { return $process.Name }
                            else { return "NA" }
                        } -ArgumentList $conn.OwningProcess
                    }
                    else {
                        $process = Get-Process -Id $conn.OwningProcess -ErrorAction SilentlyContinue
                        $processInfo = if ($process) { $process.Name } else { "NA" }
                    }
                }
                catch {
                    $processInfo = "NA"
                }
                
                # Resolve IP addresses to hostnames
                $remoteHostname = Resolve-IPAddress -IPAddress $conn.RemoteAddress
                $localHostname = Resolve-IPAddress -IPAddress $conn.LocalAddress
                
                # Format connection details
                $localEndpoint = "${localHostname}:$($conn.LocalPort)"
                $remoteEndpoint = "${remoteHostname}:$($conn.RemotePort)"
                
                # For established connections, determine direction and log accordingly
                if ($conn.State -eq "Established") {
                    # Outbound connections (local process initiated)
                    $outboundKey = "$localEndpoint-$remoteEndpoint-$processInfo"
                    if (-not $outboundConnections.ContainsKey($outboundKey)) {
                        # Log new outbound connection
                        $outboundConnections[$outboundKey] = $true
                        "$timestamp,$localEndpoint,$remoteEndpoint,$processInfo" | Out-File -FilePath $outboundLogFile -Append -Encoding utf8
                    }
                    
                    # Inbound connections (remote process initiated)
                    $inboundKey = "$remoteEndpoint-$localEndpoint-$processInfo"
                    if (-not $inboundConnections.ContainsKey($inboundKey)) {
                        # Log new inbound connection
                        $inboundConnections[$inboundKey] = $true
                        "$timestamp,$remoteEndpoint,$localEndpoint,$processInfo" | Out-File -FilePath $inboundLogFile -Append -Encoding utf8
                    }
                }
            }
            
            Write-Host "$(Get-Date -Format 'HH:mm:ss') - Logged network connections on $ServerName"
        }
        catch {
            Write-Host "Error monitoring $ServerName: $_"
        }
        
        # Wait for 1 minute before next check
        Start-Sleep -Seconds 60
    }
    
    Write-Host "Completed network monitoring on $ServerName"
}

# Main script execution
Write-Host "Starting network traffic monitoring on all servers..."

# Create jobs to monitor all servers simultaneously
$jobs = @()

foreach ($server in $servers) {
    $jobs += Start-Job -ScriptBlock {
        param($serverName)
        
        # Import the function definition
        ${function:Resolve-IPAddress} = $using:function:Resolve-IPAddress
        ${function:Monitor-NetworkTraffic} = $using:function:Monitor-NetworkTraffic
        
        # Execute the monitoring function
        Monitor-NetworkTraffic -ServerName $serverName
    } -ArgumentList $server
}

# Display progress while jobs are running
Write-Host "Monitoring network traffic on all servers for 1 hour..."
$runningJobs = $jobs.Count

while ($runningJobs -gt 0) {
    $completedJobs = @($jobs | Where-Object { $_.State -eq "Completed" }).Count
    $runningJobs = $jobs.Count - $completedJobs
    
    Write-Host "Jobs still running: $runningJobs"
    if ($runningJobs -gt 0) {
        Start-Sleep -Seconds 60
    }
}

# Get job results
foreach ($job in $jobs) {
    Receive-Job -Job $job
    Remove-Job -Job $job
}

Write-Host "Network monitoring completed for all servers."
Write-Host "Log files are available in the NetworkLogs directory."