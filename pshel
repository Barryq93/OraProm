WITH used AS (
    SELECT DISTINCT batch_id,
           ROW_NUMBER() OVER (ORDER BY batch_id) AS rn
    FROM ECMEVT_BATCH_INFO
    WHERE TRUNC(operation_date) >= TO_DATE('18-NOV-25','DD-MON-YY')
      AND batch_id BETWEEN 2000000 AND 2100000
      AND batch_status IS NULL
),
unused AS (
    SELECT not_used,
           ROW_NUMBER() OVER (ORDER BY not_used) AS rn
    FROM (
        SELECT (2000000 + LEVEL - 1) AS not_used
        FROM dual
        CONNECT BY LEVEL <= (2100000 - 2000000 + 1)
    )
    WHERE not_used NOT IN (
        SELECT batch_id
        FROM ECMEVT_BATCH_INFO
        WHERE TRUNC(operation_date) >= TO_DATE('18-NOV-25','DD-MON-YY')
          AND batch_id BETWEEN 2000000 AND 2100000
          AND batch_status IS NULL
    )
)
SELECT 
    u.batch_id   AS old_batch,
    n.not_used   AS new_batch
FROM used u
JOIN unused n ON u.rn = n.rn
WHERE n.rn <= 2000
ORDER BY n.not_used;
