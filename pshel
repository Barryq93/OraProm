# ════════════════════════════════════════════════════════════════════════════════
# SECTION 6 — PASS / FAIL TABLE
# ════════════════════════════════════════════════════════════════════════════════
section "6. Pass / Fail / Warning Summary"
progress "Section 6: pass/fail"

printf "%-52s | %-8s | %-8s | %s\n" \
  "Check" "Status" "Severity" "Detail" >> "$REPORT"
printf "%-52s | %-8s | %-8s | %s\n" \
  "----------------------------------------------------" "--------" "--------" "------" \
  >> "$REPORT"

# THP
thp=$(grep -o '.*' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null \
  || echo "unknown")
if echo "$thp" | grep -q '\[never\]'; then
  pstatus "THP setting" "Pass" "Low" "never"
else
  pstatus "THP setting" "Fail" "High" "NOT never — current: $thp"
fi

# Swap
swap_pct=0
_st=$(grep '^SwapTotal:' /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 0)
_sf=$(grep '^SwapFree:'  /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 0)
is_int "${_st:-0}" || _st=0; is_int "${_sf:-0}" || _sf=0
if [ "${_st:-0}" -gt 0 ]; then
  swap_pct=$(awk -v st="$_st" -v sf="$_sf" 'BEGIN{printf "%.0f",(st-sf)*100/st}')
  is_int "${swap_pct:-0}" || swap_pct=0
fi
if   [ "$swap_pct" -gt 90 ]; then
  pstatus "OS Swap usage" "Fail"    "Critical" "${swap_pct}% — investigate SHEAPTHRES_SHR"
elif [ "$swap_pct" -gt 50 ]; then
  pstatus "OS Swap usage" "Warning" "High"     "${swap_pct}% — elevated"
else
  pstatus "OS Swap usage" "Pass"    "Low"      "${swap_pct}%"
fi

# SA MP
_samp=$(ps -ef 2>/dev/null \
  | grep -cE 'IBM\.ResourceManager|IBM\.Automation|rsct' || echo 0)
is_int "${_samp:-0}" || _samp=0
if [ "$_samp" -gt 0 ]; then
  pstatus "SA MP daemon" "Pass" "Low"      "$_samp process(es) detected"
else
  pstatus "SA MP daemon" "Fail" "Critical" "No SA MP processes — HADR automation inactive"
fi

# Per-DB
for DB in $DBS; do
  cs="${DB_CONNECT_STATUS[$DB]:-FAILED}"
  if [ "$cs" = "FAILED" ]; then
    pstatus "[$DB] Connection" "Fail" "Critical" "CONNECT FAILED — no data"
    continue
  fi

  am1="${DB_LOGARCHMETH1[$DB]:-UNKNOWN}"
  if echo "$am1" | grep -qiE 'DISK:|VENDOR:|TSM:'; then
    pstatus "[$DB] LOGARCHMETH1" "Pass" "Low" "$am1"
  else
    pstatus "[$DB] LOGARCHMETH1" "Fail" "Critical" "Not configured ($am1)"
  fi

  am2="${DB_LOGARCHMETH2[$DB]:-UNKNOWN}"
  if echo "$am2" | grep -qiE 'DISK:|VENDOR:|TSM:'; then
    pstatus "[$DB] LOGARCHMETH2 dual path" "Pass"    "Low"  "$am2"
  elif echo "$am1" | grep -qiE 'DISK:|VENDOR:|TSM:'; then
    pstatus "[$DB] LOGARCHMETH2 dual path" "Warning" "High" "Single path only"
  fi

  echo "${DB_LOGARCHCOMPR[$DB]:-}" | grep -qi 'ON' \
    && pstatus "[$DB] LOGARCHCOMPR1" "Pass"    "Low"    "ON" \
    || pstatus "[$DB] LOGARCHCOMPR1" "Warning" "Medium" "OFF — larger archive volume"

  echo "${DB_TRACKMOD[$DB]:-}" | grep -qi 'ON' \
    && pstatus "[$DB] TRACKMOD" "Pass"    "Low"    "ON" \
    || pstatus "[$DB] TRACKMOD" "Warning" "Medium" "OFF — incremental backups unavailable"

  echo "${DB_AUTOCOLLECT_STATS[$DB]:-}" | grep -qi 'ON' \
    && pstatus "[$DB] AUTO_RUNSTATS" "Pass" "Low"  "ON" \
    || pstatus "[$DB] AUTO_RUNSTATS" "Fail" "High" "OFF — optimizer degrades on stale stats"

  echo "${DB_STMM[$DB]:-}" | grep -qi 'ON' \
    && pstatus "[$DB] STMM" "Pass"    "Low"    "ON — verify SHEAPTHRES_SHR cap" \
    || pstatus "[$DB] STMM" "Warning" "Medium" "OFF — manual memory sizing"

  hadr_sync="${DB_HADR_SYNC[$DB]:-NOT_CONFIGURED}"
  case "$hadr_sync" in
    NEARSYNC) pstatus "[$DB] HADR sync mode" "Pass"    "Low"  "NEARSYNC" ;;
    SYNC)     pstatus "[$DB] HADR sync mode" "Warning" "Medium" \
                "SYNC — per-commit latency; acceptable for near-idle DBs" ;;
    ASYNC|SUPERASYNC) pstatus "[$DB] HADR sync mode" "Fail" "High" \
                "$hadr_sync — data loss risk on failover" ;;
    NOT_CONFIGURED) pstatus "[$DB] HADR sync mode" "Warning" "High" \
                "HADR not configured — LLM will assess if HA expected" ;;
    *) pstatus "[$DB] HADR sync mode" "Unknown" "High" "$hadr_sync" ;;
  esac

  lto="${DB_LOCKTIMEOUT[$DB]:-UNKNOWN}"
  if [ "$lto" = "-1" ] 2>/dev/null; then
    pstatus "[$DB] LOCKTIMEOUT" "Fail"    "High"   "-1 (never) — lock cascades hang"
  elif is_int "$lto" && [ "$lto" -gt 0 ] && [ "$lto" -le 120 ]; then
    pstatus "[$DB] LOCKTIMEOUT" "Pass"    "Low"    "${lto}s"
  elif is_int "$lto" && [ "$lto" -gt 120 ]; then
    pstatus "[$DB] LOCKTIMEOUT" "Warning" "Medium" "${lto}s — reduce to 60-90s"
  else
    pstatus "[$DB] LOCKTIMEOUT" "Unknown" "High"   "Value: $lto"
  fi

  lu="${DB_LOG_USED_KB[$DB]:-0}"; la="${DB_LOG_AVAIL_KB[$DB]:-0}"
  is_int "$lu" || lu=0; is_int "$la" || la=0
  if [ $((lu + la)) -gt 0 ]; then
    lu_pct=$(awk -v u="$lu" -v a="$la" 'BEGIN{printf "%.0f",u*100/(u+a)}')
    is_int "${lu_pct:-0}" || lu_pct=0
    if   [ "$lu_pct" -lt 70 ]; then pstatus "[$DB] Log utilisation" "Pass"    "Low"      "${lu_pct}%"
    elif [ "$lu_pct" -lt 85 ]; then pstatus "[$DB] Log utilisation" "Warning" "High"     "${lu_pct}% — review sizing"
    else                             pstatus "[$DB] Log utilisation" "Fail"    "Critical" "${lu_pct}% — near log-full"
    fi
  else
    pstatus "[$DB] Log utilisation" "Unknown" "High" "Could not determine"
  fi

  rp="${DB_REORG_PENDING_COUNT[$DB]:-0}"; is_int "$rp" || rp=0
  if   [ "$rp" -eq 0 ]; then pstatus "[$DB] Reorg pending" "Pass"    "Low"    "None"
  elif [ "$rp" -le 5 ]; then pstatus "[$DB] Reorg pending" "Warning" "Medium" "$rp table(s)"
  else                        pstatus "[$DB] Reorg pending" "Fail"    "High"   "$rp table(s)"
  fi

  lw="${DB_LOCK_WAITS[$DB]:-0}"; is_int "$lw" || lw=0
  if   [ "$lw" -eq 0 ]; then pstatus "[$DB] Active lock waits" "Pass"    "Low"    "None"
  elif [ "$lw" -le 3 ]; then pstatus "[$DB] Active lock waits" "Warning" "Medium" "$lw wait(s)"
  else                        pstatus "[$DB] Active lock waits" "Fail"    "High"   "$lw — contention event"
  fi

  lt="${DB_LONG_TXN_COUNT[$DB]:-0}"; is_int "$lt" || lt=0
  if [ "$lt" -eq 0 ]; then pstatus "[$DB] Long transactions >60s" "Pass" "Low"  "None"
  else                      pstatus "[$DB] Long transactions >60s" "Fail" "High" "$lt — blocking log + HADR"
  fi

  pstatus "[$DB] Last backup" "Info" "Review" "${DB_BACKUP_TS[$DB]:-UNKNOWN}"

done
blankln

